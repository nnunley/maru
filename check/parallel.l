;;; ./eval check/parallel.l [--quick | NAME...]: every case of check/check.l, or those named, or all but the slowest, a few
;;; at a time, each in a process and a directory of its own.  MARU_CHECK_JOBS says how many at once (default 4: other work shares this machine).  What a case
;;; printed follows when it ends, whole, in the order they finish; the run fails if any case does, and each failure is named.
(define fork	(subr "fork" ">i"))
(define execl	(subr "execl" "ss.>i"))
(define waitpid	(subr "waitpid" "ipi>i"))
(define _exit	(subr "_exit" "i"))
(define system	(subr "system" "s>i"))
(define status-word ((subr "malloc" "l>p") 8))
;; an environment variable as a string, or ()
(define-function environment (name)
  (let ((p ((subr "getenv" "s>p") name)))
    (and p (!= 0 p)
	 (let ((chars ()) (i 0))
	   (while (< 0 (byte-at p i)) (push chars (byte-at p i)) (set i (+ i 1)))
	   (list->string (list-reverse! chars))))))
(define root (or (environment "MARU_CHECK_TMP") "/tmp/maru-check"))
(define jobs (let ((j (environment "MARU_CHECK_JOBS"))) (if j (string->long j) 4)))

;; the names of the cases, read from where they're written, in order
(define-function case-names ()
  (let* ((text (contents-of-file-named "check/check.l"))
	 (marker "(check \"")
	 (m (string-length marker))
	 (n (string-length text))
	 (names ())
	 (i 0))
    (while (< i (- n m))
      (if (and (or (= i 0) (= ?\n (string-at text (- i 1))))
	       (= marker (string-copy text i m)))
	  (let ((end (+ i m)))
	    (while (not (= ?\" (string-at text end))) (set end (+ end 1)))
	    (push names (string-copy text (+ i m) (- end (+ i m))))
	    (set i end))
	(set i (+ i 1))))
    (list-reverse! names)))

;; what --quick leaves out: the longest by far, as its slowest line reports them.  Everything runs before a merge.
(define slow-cases '("gc_laws" "gc_model" "asm_rows_x64" "asm_rows_x86" "asm_rows_arm64" "exe" "sat_john" "sat_proof" "recover" "lines"))
(define *requested* *arguments*)
(set *arguments* ())
(define known (case-names))
(define-function all-but-slow ()
  (let ((out ())) (list-do name known (or (member? name slow-cases) (push out name))) (list-reverse! out)))
(define waiting
  (if (and *requested* (= "--quick" (car *requested*)))
      (all-but-slow)
    (let ()
      (list-do name *requested*
	(or (member? name known) (let () (println "no check named: " name) (_exit 1))))
      (or *requested* known))))

(system (concat-strings "rm -rf " root " && mkdir -p " root))
(define-function case-dir (name) (concat-strings root "/" name))
(define time-now (let ((buffer ((subr "malloc" "l>p") 16)) (clock (subr "gettimeofday" "pp>i")))
		  (lambda () (clock buffer 0) (+ (<< (byte-at buffer 0) 0) (+ (<< (byte-at buffer 1) 8) (+ (<< (byte-at buffer 2) 16) (<< (byte-at buffer 3) 24)))))))
(define-function start (name)
  (let ((pid (fork)))
    (when (= 0 pid)
      (let ((dir (case-dir name)))
	(execl "/bin/sh" "sh" "-c"
	       (concat-strings "exec </dev/null >" root "/" name ".log 2>&1; MARU_CHECK_TMP=" dir " exec ./eval check/check.l " name)
	       0))
      (_exit 127))
    pid))

(define running ())		; (pid name . started)
(define times ())		; (seconds . name)
(define failed ())
(define-function finish-one ()
  (let* ((pid (waitpid -1 status-word 0))
	 (entry (assq pid running))
	 (status (+ (byte-at status-word 0) (<< (byte-at status-word 1) 8)))
	 (name (cadr entry)))
    (push times (cons (- (time-now) (cddr entry)) name))
    (let ((rest ()))
      (list-do e running (or (= (car e) pid) (push rest e)))
      (set running rest))
    (print (contents-of-file-named (concat-strings root "/" name ".log")))
    (or (= 0 status) (let () (push failed name) (println "FAILED " name " (" root "/" name ".log)")))))

(while (or waiting running)
  (if (and waiting (< (list-length running) jobs))
      (let ((name (car waiting)))
	(set waiting (cdr waiting))
	(push running (cons (start name) (cons name (time-now)))))
    (finish-one)))
;; the slowest, so a case that's grown shows up
(define-function slowest-of (entries)
  (let ((best (car entries)))
    (list-do e entries (and (> (car e) (car best)) (set best e)))
    best))
(print "slowest:")
(for (i 0 6)
  (when times
    (let ((best (slowest-of times)) (rest ()))
      (print " " (cdr best) " " (car best) "s")
      (list-do e times (or (= e best) (push rest e)))
      (set times rest))))
(println)
(if failed
    (let ()
      (println "failed: " failed)
      (_exit 1))
  (println "all checks passed"))
