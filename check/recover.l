;;; Errors are survivable, on every evaluator, and try leaves state as it found it.
(require "recover.l")
(define ok 1)
(define-function expect (what got want)
  (or (equal got want) (let () (set ok ()) (println "FAIL " what ": got " got ", want " want))))
(define-function has? (str sub)
  (let ((i 0) (n (- (string-length str) (string-length sub))) (found ()))
    (while (and (not found) (<= i n))
      (and (= sub (string-copy str i (string-length sub))) (set found 1))
      (set i (+ i 1)))
    found))
(define-function failure (thunk)	; what try caught
  (try (let () (thunk) 'no-failure) (lambda (c) c)))

;; each kind of failure, and the program goes on
(expect "error" (car (failure (lambda () (error "boom " 1)))) 'error)
(expect "error's arguments" (cdr (failure (lambda () (error "boom " 1)))) '("boom " 1))
(expect "a fatal error: wrong arguments" (car (failure (lambda () (set-car)))) 'fatal)
(expect "with its message" (has? (cadr (failure (lambda () (set-car)))) "wrong number") 1)
(expect "a fatal error: nothing to call" (car (failure (lambda () ((quote not-a-function) 1)))) 'fatal)
(expect "after all that" (+ 40 2) 42)

;; handlers run where the condition happened, and returning declines
(let ((seen ()))
  (expect "a declined signal goes on"
	  (with-handler (lambda (c) (push seen c)) (lambda () (signal 'note) 'went-on)) 'went-on)
  (expect "it was seen" seen '(note)))
(expect "the nearest catches"
	(try (try (error "inner") (lambda (c) (error "outer"))) (lambda (c) (cdr c))) '("outer"))
(expect "no handlers left over" *handlers* ())
(expect "no tags left over" *catch-tags* ())

;; Warth's example: an update that fails partway leaves every element as it was
(define-structure <point> (x y))
(let ((xs (array)))
  (for (i 0 5) (set-array-at xs i (new <point> i i)))
  (let ((found (try (for (i 0 5)
		      (and (= i 3) (error "update failed"))
		      (set (<point>-x (array-at xs i)) 100))
		    (lambda (c) 'undone))))
    (expect "it failed" found 'undone)
    (for (i 0 5) (expect "each element as it was" (<point>-x (array-at xs i)) i))))

;; every kind of write, undone on failure and kept when the body ends
(define global 1)
(define pair (cons 1 2))
(define arr (array))
(set-array-at arr 0 'a)
(define str (string 3))
(set-string-at str 0 ?a)
(define-function writes (v)
  (set global v)
  (set-car pair v)
  (set-cdr pair v)
  (set-array-at arr 0 v)
  (set-array-at arr 40 v)
  (set-string-at str 0 ?z)
  (set-string-at str 50 ?z))
(let ((local 1))
  (try (let ()
	 (set local 2)
	 (writes 2)
	 (error "stop"))
       (lambda (c) c))
  (expect "a local" local 1)
  (expect "a global" global 1)
  (expect "a pair" pair '(1 . 2))
  (expect "an array element" (array-at arr 0) 'a)
  (expect "an array's size" (array-length arr) 1)
  (expect "a string's character" (string-at str 0) ?a)
  (expect "a string's size" (string-length str) 3)
  (try (let () (set local 3) (writes 3)) (lambda (c) c))
  (expect "kept: a local" local 3)
  (expect "kept: a global" global 3)
  (expect "kept: a pair" pair '(3 . 3))
  (expect "kept: an array" (array-at arr 40) 3))

;; what a failed world wrote past the end stays gone when the array or string grows again (found by check/laws/gc-model.law)
(let ((a (array)) (t (string 2)))
  (set-array-at a 0 'first)
  (set-string-at t 0 ?a)
  (try (let () (set-array-at a 5 'stale) (set-string-at t 40 ?z) (error "stop")) (lambda (c) c))
  (expect "the array's end" (array-length a) 1)
  (set-array-at a 9 'later)
  (expect "no stale element" (array-at a 5) ())
  (set-string-at t 40 ?y)
  (set-string-at t 39 ?x)
  (expect "the string's later write" (string-at t 40) ?y)
  (expect "no stale character" (string-at t 20) 0))

;; a definition is a write
(define defined-before 1)
(try (let ()
       (eval '(define defined-before 2))
       (eval '(define defined-in-world 3))
       (error "stop"))
     (lambda (c) c))
(expect "a redefinition undone" defined-before 1)
(expect "a new name gone, or valueless where the encoder made it first"
	(if (defined? 'defined-in-world) (eval 'defined-in-world) ()) ())
;; unwind-protect's marker can't be thrown to
(expect "no one can name unwind-protect"
	(car (failure (lambda () (unwind-protect (throw 'unwind-protect 1) 0)))) 'error)
;; a fatal error with its text gone straight to stderr has no message, not an old one
(failure (lambda () (set-car)))
(expect "no stale message" (cadr (failure (lambda () (array-length 5)))) "")
;; a throw puts the evaluator's call depth back: read at one depth, so only the failures can make it differ
(define depth-cell (stub-symbol "traceDepth"))
(define-function deep-failure (n) (if (= n 0) (error "deep") (+ 1 (deep-failure (- n 1)))))
(define-function depth-moved-by (times)
  (let* ((before (stub-word-at depth-cell 0))
	 (_ (for (i 0 times) (failure (lambda () (deep-failure 5)))))
	 (after (stub-word-at depth-cell 0)))
    (- after before)))
(expect "the call depth" (depth-moved-by 200) (depth-moved-by 0))

;; nesting: an inner commit is still undone by the outer failure, an inner failure leaves the outer's writes
(set global 0)
(try (let ()
       (try (set global 1) (lambda (c) c))
       (expect "the inner commit shows" global 1)
       (try (let () (set global 2) (error "inner")) (lambda (c) c))
       (expect "the inner failure undone" global 1)
       (error "outer"))
     (lambda (c) c))
(expect "the outer failure undoes the inner commit" global 0)

;; a throw leaving a world drops it too
(set global 0)
(catch 'out (lambda () (try (let () (set global 1) (throw 'out 1)) (lambda (c) 'not-a-failure))))
(expect "a throw through it" global 0)

;; the log is a root: what it holds survives a collection, and a long world works
(define-function churn (n) (let ((l ())) (for (i 0 n) (set l (cons i l))) (list-length l)))
(define held (list 'held))
(try (let () (set held (list 'new)) (churn 300000) (set global 5) (error "stop")) (lambda (c) c))
(expect "an old value through a collection" held '(held))
(set global 0)
(try (let () (for (i 0 200000) (set global i)) (error "stop")) (lambda (c) c))
(expect "many writes" global 0)
;; a live list longer than the C stack could mark recursively
(expect "a very long list" (churn 2000000) 2000000)
(expect "worlds all closed" (try 1 (lambda (c) c)) 1)
(and ok (println "recover ok"))
