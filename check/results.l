;;; What a run of check/parallel.l leaves for the evidence: DIR/results, the tree it ran against, whether every case ran,
;;; and each case's outcome, in the order they finished (doc/rfc/draft-ndn-maru-john-development-00.md, R-results-file).
;;;
;;;   (tree-hash-now)                                          what notes/plan/tree-hash prints, 12 hex digits
;;;   (results-write dir tree-before tree-after complete outcomes)  outcomes: ((name . passed?) ...); nothing if the trees differ
;;;   (results-read path)                                      (tree complete outcomes), or () if there is no file
(require "check/temp.l")
(define results-system (subr "system" "s>i"))
(define results-getpid (subr "getpid" ">i"))
(define-function tree-hash-now ()
  (let* ((file (concat-strings check-tmp "/tree-" (long->string (results-getpid))))
	 (status (results-system (concat-strings "notes/plan/tree-hash > " file)))
	 (text (contents-of-file-named file)))
    (results-system (concat-strings "rm -f " file))
    (or (and (= 0 status) text (= 13 (string-length text))) (error "notes/plan/tree-hash gave no hash"))
    (string-copy text 0 12)))
(define-function results-put (f text) (for (i 0 (string-length text)) (putc (string-at text i) f)))
;; a result is evidence about the code it ran against, so a run whose code changed under it is evidence about none
(define-function results-write (dir tree-before tree-after complete outcomes)
  (let ((path (concat-string dir "/results")))
    (results-system (concat-strings "rm -f " path))
    (if (not (= tree-before tree-after))
	(let ((message "the code changed during the run: no results\n"))
	  ((subr "write" "isl>l") 2 message (string-length message)))
      (let* ((partial (concat-string path ".tmp")) (f (open partial "w")))
	(results-put f (concat-strings "tree " tree-before "\ncomplete " (if complete "yes" "no") "\n"))
	(list-do o outcomes (results-put f (concat-strings (car o) (if (cdr o) " passed\n" " failed\n"))))
	(close f)
	(results-system (concat-strings "mv " partial " " path))))))
(define-function results-words (line)	; the line's two words
  (let ((i 0) (n (string-length line)))
    (while (and (< i n) (not (= ?  (string-at line i)))) (set i (+ i 1)))
    (cons (string-copy line 0 i) (string-copy line (+ i 1) (- n (+ i 1))))))
(define-function results-lines (text)
  (let ((out ()) (start 0))
    (for (i 0 (string-length text))
      (when (= ?\n (string-at text i))
	(push out (string-copy text start (- i start)))
	(set start (+ i 1))))
    (and (< start (string-length text)) (push out (string-copy text start (- (string-length text) start))))
    (list-reverse! out)))
(define-function results-read (path)
  (let ((text (and (= 0 ((subr "access" "si>i") path 4)) (contents-of-file-named path))))
    (and text
	 (let* ((lines (results-lines text))
		(tree (results-words (car lines)))
		(complete (and (cdr lines) (results-words (cadr lines))))
		(outcomes ()))
	   (or (= "tree" (car tree)) (error "results: no tree line"))
	   (or (and complete (= "complete" (car complete))) (error "results: no complete line"))
	   (list-do line (cddr lines)
	     (and (< 0 (string-length line))
		  (let ((w (results-words line))) (push outcomes (cons (car w) (and (= "passed" (cdr w)) 't))))))
	   (list (cdr tree) (and (= "yes" (cdr complete)) 't) (list-reverse! outcomes))))))
