;;; What check/native.l and check/native-image.l share: expect, and a thunk run in a forked child (on any evaluator).
(require "osdefs.k")
(require "check/temp.l")
(define ok 1)
(define-function expect (what got want)
  (or (equal got want) (let () (set ok ()) (println "FAIL " what ": got " got ", want " want))))
;; C's stdout, a FILE * held in __stdoutp (Darwin) or stdout (Linux)
(define-function native-stdout ()
  (let ((cell (or (let ((a ((subr "dlsym" "ps>p") RTLD_DEFAULT "__stdoutp"))) (and (not (= 0 a)) a))
		  ((subr "dlsym" "ps>p") RTLD_DEFAULT "stdout")))
	(p 0))
    (for (k 0 8) (set p (+ p (<< (byte-at cell k) (* 8 k)))))
    p))
;; the pieces of a string between separators, empty ones dropped
(define-function pieces (text sep)
  (let ((out ()) (from 0))
    (for (i 0 (+ 1 (string-length text)))
      (when (or (= i (string-length text)) (= sep (string-at text i)))
	(or (= i from) (push out (string-copy text from (- i from))))
	(set from (+ i 1))))
    (list-reverse! out)))
;; thunk run in a forked child, its standard output and error in a file of this check's own, and 120 s to finish, as
;; check.l's run gives a command (an alarm ends it): (status line …), the status as waitpid gives it, 0 for an exit of 0.
;; The child leaves by _exit, an error too: exit would flush the input this file is loaded from, which the child shares,
;; and move it.  An evaluator's own fatal error still exits so, and would.
(define-function native-child (thunk)
  (let ((path (concat-string check-tmp (concat-string "/native-child." (long->string ((subr "getpid" ">i"))))))
	(status ((subr "calloc" "ll>p") 1 8))
	(pid ((subr "fork" ">i"))))
    (when (= 0 pid)
      (let ((fd ((subr "open" "si.i>i") path (| O_WRONLY (| O_CREAT O_TRUNC)) 420)))
	((subr "dup2" "ii>i") fd 1)
	((subr "dup2" "ii>i") fd 2))
      ((subr "alarm" "i>i") 120)
      (set error (lambda args
		   (print "error: ") (apply print args) (print "\n")
		   ((subr "fflush" "p>i") (native-stdout))
		   ((subr "_exit" "i") 1)))
      ((subr "_exit" "i") (thunk)))
    (expect "the child waited for" ((subr "waitpid" "ipi>i") pid status 0) pid)
    (let ((text (contents-of-file-named path)))
      ((subr "unlink" "s>i") path)
      (cons (+ (byte-at status 0) (<< (byte-at status 1) 8)) (pieces text 10)))))
;; whether a line holds text
(define-function holds? (line text)
  (let ((i 0) (n (- (string-length line) (string-length text))) (found ()))
    (while (and (not found) (<= i n)) (and (= text (string-copy line i (string-length text))) (set found 1)) (set i (+ i 1)))
    found))
;; thunk, run in a child, fails saying text
(define-function refuses (what thunk text)
  (let ((out (native-child (lambda () (thunk) 0))))
    (expect (concat-string what ", refused") (and (!= 0 (car out)) 1) 1)
    (expect (concat-string what ", saying why") (let ((found ())) (list-do l (cdr out) (and (holds? l text) (set found 1))) found) 1)))
