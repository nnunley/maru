;;; The kernel's eval and apply (doc/kernel.md), as eval3's: every expression in check/kernel/eval.txt read, expanded and
;;; evaluated in the global namespace, its value dumped one a line, on the poisoning collector; check/kernel.l and
;;; check.l compare the lines with check/kernel/eval.expected, what ./eval3 -b boot2.l prints for the same expressions.
;;; Then "kernel eval ok".  A closure outlives its caller, recursion goes 1000 deep, a <form> expands, and an
;;; *applicators* entry applies a <long>.  The subrs and fsubrs here are minimal stand-ins for Task 5's primitives, each
;;; called through its <subr>'s imp.

(define (fopen (void * char * char *) *) (extern fopen))

(define-function subr_add oop ((args oop) (env oop))
  (return (k_newLong (+ (k_getLong (k_car args)) (k_getLong (k_cadr args))))))
(define-function subr_sub oop ((args oop) (env oop))
  (return (k_newLong (- (k_getLong (k_car args)) (k_getLong (k_cadr args))))))
(define-function subr_less oop ((args oop) (env oop))
  (if (< (k_getLong (k_car args)) (k_getLong (k_cadr args))) (return s_t))
  (return nil))
(define-function subr_cons oop ((args oop) (env oop))	(return (k_cons (k_car args) (k_cadr args))))
(define-function subr_car oop ((args oop) (env oop))	(return (k_car (k_car args))))
(define-function subr_form oop ((args oop) (env oop))	(return (k_newForm (k_car args) (k_cadr args))))
(define-function subr_set_array_at oop ((args oop) (env oop))
  (return (k_arrayAtPut (k_car args) (k_getLong (k_cadr args)) (k_caddr args))))

;; eval3's fsubrs (eval3.c:1836-1960), less the undo log
(define-function subr_quote oop ((args oop) (env oop))	(return (k_car args)))
(define-function subr_lambda oop ((args oop) (env oop))	(return (k_newExpr args env)))
(define-function subr_if oop ((args oop) (env oop))
  (if (!= (k_eval (k_car args) env) nil) (return (k_eval (k_cadr args) env)))
  (let (((ans oop) nil))
    (set args (k_cddr args))
    (while (object-is <pair> args)
      (set ans (k_eval (<pair>-head args) env))
      (set args (k_cdr args)))
    (return ans)))
(define-function subr_set oop ((args oop) (env oop))
  (let (((sym oop) (k_car args))
	((var oop) (k_findVariable env (k_car args)))
	((val oop) nil))
    (if (= var nil) (let () (k_fatalBegin "set: undefined variable: ") (k_dump sym) (k_fatalEnd)))
    (set val (k_eval (k_cadr args) env))
    (if (and (object-is <expr> val) (= (<expr>-name val) nil)) (set (<expr>-name val) sym))
    (set (<pair>-tail var) val)
    (return val)))
(define-function subr_let oop ((args oop) (env oop))
  (let (((bound oop) (k_cons nil nil))
	((ptr oop) nil)
	((bindings oop) (k_car args))
	((tmp oop) nil)
	((name oop) nil)
	((body oop) nil))
    (gc-protect (bound tmp ptr)
      (set ptr bound)
      (while (object-is <pair> bindings)
	(let (((binding oop) (<pair>-head bindings)))
	  (if (object-is <pair> binding)
	      (let () (set name (k_car binding)) (set tmp (k_eval (k_cadr binding) env)))
	    (let () (set name binding) (set tmp nil)))
	  (set (<pair>-tail ptr) (k_cons nil nil))
	  (set ptr (<pair>-tail ptr))
	  (set (<pair>-head ptr) (k_cons name tmp))
	  (set bindings (<pair>-tail bindings))))
      (set (<pair>-tail ptr) env)
      (set bound (<pair>-tail bound))
      (set body (k_cdr args))
      (set tmp nil)
      (while (object-is <pair> body)
	(set tmp (k_eval (<pair>-head body) bound))
	(set body (<pair>-tail body))))
    (return tmp)))
(define-function subr_define oop ((args oop) (env oop))
  (let (((sym oop) (k_car args))
	((val oop) (k_eval (k_cadr args) env))
	((var oop) nil))
    (gc-protect (val)
      (set var (k_findNamespaceVariable env sym))
      (if (= var nil)
	  (k_define env sym val)
	(set (<pair>-tail var) val))
      (if (object-is <form> val) (set val (<form>-function val)))
      (if (and (object-is <expr> val) (= (<expr>-name val) nil)) (set (<expr>-name val) sym)))
    (return val)))

;; name bound in the global namespace to a subr of imp, or to a fixed of one when fixed is 1
(define-function install void ((name char *) (imp (oop oop oop) *) (fixed long))
  (let (((fn oop) (k_newSubrC name imp))
	((sym oop) nil))
    (gc-protect (fn sym)
      (if fixed (set fn (k_newFixed fn)))
      (set sym (k_internC name))
      (k_define k_globalNamespace sym fn))))

(define-function main int ((argc int) (argv char * *))
  (gc_initialise)
  (set gc_poison 165)
  (set gc_frequency 1)
  (k_initReader)
  (k_initEval)
  (install "+" subr_add 0)
  (install "-" subr_sub 0)
  (install "<" subr_less 0)
  (install "cons" subr_cons 0)
  (install "car" subr_car 0)
  (install "form" subr_form 0)
  (install "set-array-at" subr_set_array_at 0)
  (install "quote" subr_quote 1)
  (install "lambda" subr_lambda 1)
  (install "if" subr_if 1)
  (install "set" subr_set 1)
  (install "let" subr_let 1)
  (install "define" subr_define 1)
  (set (<pair>-tail k_applicators) (k_newArray 0))	; boot2.l makes *applicators* an array, by type
  (let (((fp void *) (fopen "check/kernel/eval.txt" "r"))
	((obj oop) nil)
	((env oop) (<pair>-tail k_globals)))
    (if (= fp (cast 0 void *)) (let () (printf "FAIL can't open check/kernel/eval.txt\n") (exit 1)))
    (gc-protect (obj)
      (k_beginSource "check/kernel/eval.txt")
      (set obj (k_readExpr fp))
      (while (!= obj k_done)
	(set obj (k_expand obj env))
	(set obj (k_eval obj env))
	(k_dumpln obj)
	(set obj (k_readExpr fp)))
      (k_endSource)))
  ;; the printer's globals, as ./eval3 prints them with an empty boot file (boot2.l rebinds *globals*): the global
  ;; namespace, and its head binding, whose tail is the namespace
  (k_dumpln (<pair>-tail k_globals))
  (k_dumpln (k_car (<pair>-tail k_globals)))
  (printf "kernel eval ok\n")
  (return 0))
