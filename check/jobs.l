;;; (run-jobs JOBS DIR ENTRIES): runs each entry, (name . shell command), a few at a time, its output in DIR/name.log, and
;;; prints that output whole as each ends.  Answers the names of those that failed, and prints the slowest.
(define jobs-fork	(subr "fork" ">i"))
(define jobs-execl	(subr "execl" "ss.>i"))
(define jobs-waitpid	(subr "waitpid" "ipi>i"))
(define jobs-exit	(subr "_exit" "i"))
(define jobs-status ((subr "malloc" "l>p") 8))
(define jobs-time
  (let ((buffer ((subr "malloc" "l>p") 16)) (clock (subr "gettimeofday" "pp>i")))
    (lambda ()
      (clock buffer 0)
      (+ (byte-at buffer 0) (+ (<< (byte-at buffer 1) 8) (+ (<< (byte-at buffer 2) 16) (<< (byte-at buffer 3) 24)))))))
(define-function jobs-start (dir entry)
  (let ((pid (jobs-fork)))
    (when (= 0 pid)
      (jobs-execl "/bin/sh" "sh" "-c" (concat-strings "exec </dev/null >" dir "/" (car entry) ".log 2>&1; " (cdr entry)) 0)
      (jobs-exit 127))
    pid))
(define-function jobs-slowest (times)
  (let ((best (car times)))
    (list-do e times (and (> (car e) (car best)) (set best e)))
    best))
(define-function run-jobs (limit dir entries)
  (let ((waiting entries) (running ()) (failed ()) (times ()))
    (or (< 0 limit) (set limit 1))
    (while (or waiting running)
      (if (and waiting (< (list-length running) limit))
	  (let ((entry (car waiting)))
	    (set waiting (cdr waiting))
	    (push running (cons (jobs-start dir entry) (cons (car entry) (jobs-time)))))
	(let* ((pid (jobs-waitpid -1 jobs-status 0))
	       (found (assq pid running))
	       (status (+ (byte-at jobs-status 0) (<< (byte-at jobs-status 1) 8)))
	       (name (cadr found))
	       (rest ()))
	  (list-do e running (or (= (car e) pid) (push rest e)))
	  (set running rest)
	  (push times (cons (- (jobs-time) (cddr found)) name))
	  (print (contents-of-file-named (concat-strings dir "/" name ".log")))
	  (or (= 0 status) (let () (push failed name) (println "FAILED " name " (" dir "/" name ".log)"))))))
    ;; the slowest, so one that's grown shows up
    (print "slowest:")
    (for (i 0 6)
      (when times
	(let ((best (jobs-slowest times)) (rest ()))
	  (print " " (cdr best) " " (car best) "s")
	  (list-do e times (or (= e best) (push rest e)))
	  (set times rest))))
    (println)
    failed))
