-- functions in a law file: a function, one taking a function, a function by cases calling itself and another, and one
-- written an equation per line
under test: double, twice, value, size
let numerals = [0, 1, 2]
let double = (x) -> x + x
let twice = (f, x) -> f(f(x))
let value = num(n) -> n
          | doubled(n) -> double(n)
          | pair(a, b) -> value(a) + value(b)
          | Zero -> 0
let size(Zero) = 0
let size(num(n)) = 1
let size(pair(a, b)) = 1 + size(a) + size(b)
rule w_num:     number(n) => wrapped(n, num(n))
rule w_pair:    number(n) => wrapped(n, pair(num(n), Zero))
rule w_doubled: number(n) => doubled_of(n, doubled(n))
law doubles: all n: number(n). double(n) = n * 2 by exhaustion
law applied: all n: number(n). twice((y) -> y + 1, n) = n + 2 by exhaustion
law valued:  all n: number(n), k: wrapped(n, k). value(k) = n by exhaustion
law twofold: all n: number(n), k: doubled_of(n, k). value(k) = n * 2 by exhaustion
law sized:   all n: number(n), k: wrapped(n, k). size(k) >= 1 by exhaustion
