-- hash.l's tables against an association list searched with the same equality (check/laws/hash.l): every get, the count,
-- and the keys and values in the order they were first put
reference programs_agree(p, k)
reference grows(n, k)
reference finds_iff_same(a, b, k)
reference key_kinds(n)
under test: program, op, key, kind, many, once, numkey
defaults trials = 300, size = 6
let numerals = [0, 1, 2, 3, 7]

-- few keys, so puts overwrite, removes hit and gets find what was put
-- a key from a numeral, by each kind of key (kept twice: identity tables need keys that hit)
for f in num | dbl | str | sym | deep | neg | big | bigdbl | half | kept | kept: rule k_f: number(n) => key(f(n))
rule k_pair:    key(a), key(b) => key(pair(a, b))
fact key(Nil)
fact key(Min)
rule o_put:     key(k), number(v) => op(put(k, v))
rule o_put2:    key(k), number(v) => op(put(k, v))
rule o_remove:  key(k) => op(remove(k))
rule o_get:     key(k) => op(get(k))
rule o_grow:    number(n) => op(grow(n))
fact program(End)
rule p_one:     op(o), program(p) => program(seq(o, p))
rule p_three:   op(a), op(b), op(c), program(p) => program(seq(a, seq(b, seq(c, p))))

for k in Identity | Equal: fact kind(k)
-- sizes around each growth: a table starts with 8 buckets and doubles past three quarters full
for n in 0 | 1 | 5 | 6 | 7 | 13 | 100 | 700: fact many(n)
fact once(1)
-- numbers where hashing goes wrong: negatives, 2^53 and past (a long and the double it rounds to are equal), halves, the
-- least long (whose negation is itself), and 2 against 2.0
for k in num(0) | num(2) | dbl(2) | neg(7) | half(1) | big(0) | big(1) | bigdbl(0) | bigdbl(1) | Min: fact numkey(k)

law programs:  all p: program(p), k: kind(k). programs_agree(p, k) = accept
law grows:     all n: many(n), k: kind(k). grows(n, k) = accept by exhaustion
law numbers:   all a: numkey(a), b: numkey(b), k: kind(k). finds_iff_same(a, b, k) = accept by exhaustion
-- an identity table tells apart what an equality table takes as one key: two strings of the same text, 2 and 2.0
law key_kinds: all n: once(n). key_kinds(n) = accept by exhaustion
