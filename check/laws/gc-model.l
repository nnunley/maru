;;; gc-model.law's references: generated programs, on real objects and on a model that must agree, and generated
;;; allocation sequences on the real heap.  Each in a forked child, since what these find usually crashes.
(require "recover.l")
(define gc-collect (subr "GC_gcollect"))
(define gc-check-heap (subr "GC_check_heap" ">l"))
(define gc-collect-every (subr "GC_collect_every" "i"))
(define-function churn (n) (for (i 0 n) (cons i i)))
;; no question can hang a run: past its limit the child dies by the alarm, which is reported as a crash
(define alarm (subr "alarm" "i>i"))
(define-function verdict (ask)
  (let ((status (law-child (lambda () (alarm 60) (_exit (if (ask) 0 3))))))
    (cond ((= 0 status) accept) ((= (<< 3 8) status) reject) (else (list 'crash status)))))

;;; the real system
(define g0 0) (define g1 0) (define g2 0)
(define-function real-global (s v)
  (let ((slot (% s 3)))
    (if (= slot 0) (set g0 v) (if (= slot 1) (set g1 v) (set g2 v)))))
(define real-cells (list (cons 0 0) (cons 0 0) (cons 0 0) (cons 0 0)))
(define-function real-cell (s) (let ((c real-cells)) (for (i 0 (% s 4)) (set c (cdr c))) (car c)))
(define real-array (array))
(set-array-at real-array 0 0)
(define real-text (string 2))
(for (i 0 2) (set-string-at real-text i ?-))
;; a local, held by a closure, as a program's own variables are
(define real-captured ())
(define real-read-captured ())
(let ((local 0))
  (set real-captured (lambda (v) (set local v)))
  (set real-read-captured (lambda () local)))
(define-function real-run (steps) (list-do step steps (step)))
(define-function real-ended (steps) (lambda () (try (real-run steps) (lambda (c) c))))
(define-function real-failed (steps) (lambda () (try (let () (real-run steps) (error "failed")) (lambda (c) c))))
(define-function real-thrown (steps)
  (lambda () (catch 'out (lambda () (try (let () (real-run steps) (throw 'out 0)) (lambda (c) c))))))
(define real-compile)
(require "build/gc-real.g.l")
(set real-compile (lambda (p) (parse-source <gc-real> $run (list p))))

;;; the model: an association list, never changed in place
(define *model* ())
(define-function model-get (key default)
  (let ((m *model*) (found ()) (value default))
    (while (and m (not found))
      (when (equal (caar m) key) (set found 1) (set value (cdar m)))
      (set m (cdr m)))
    value))
(define-function model-put (key value) (set *model* (cons (cons key value) *model*)))
(define-function model-array (i v)
  (model-put (list 'slot i) v)
  (and (>= i (model-get 'array-size 1)) (model-put 'array-size (+ i 1))))
;; a string grows as set-string-at grows it: doubling
(define-function model-char (i c)
  (let ((len (model-get 'text-size 2)))
    (while (<= len i) (set len (* len 2)))
    (model-put 'text-size len)
    (model-put (list 'char i) c)))
(define model-run)
(define-function model-discard (p)
  (let ((saved *model*)) (model-run p) (set *model* saved)))
(require "build/gc-model.g.l")
(set model-run (lambda (p) (parse-source <gc-model> $run (list p))))

;; every observable the program could have changed, the real one against the model's
(define-function agree? ()
  (let ((good 1))
    (define-function same (got want) (or (equal got want) (set good ())))
    (same g0 (model-get '(g 0) 0)) (same g1 (model-get '(g 1) 0)) (same g2 (model-get '(g 2) 0))
    (same (real-read-captured) (model-get 'captured 0))
    (for (s 0 4)
      (same (car (real-cell s)) (model-get (list 'car s) 0))
      (same (cdr (real-cell s)) (model-get (list 'cdr s) 0)))
    (same (array-length real-array) (model-get 'array-size 1))
    (for (i 0 (array-length real-array))
      (same (array-at real-array i) (model-get (list 'slot i) (if (= i 0) 0 ()))))
    (same (string-length real-text) (model-get 'text-size 2))
    (for (i 0 (string-length real-text))
      (same (string-at real-text i) (model-get (list 'char i) (if (< i 2) ?- 0))))
    good))
(define undo-log-size (subr "maru_undo_log_size" ">l"))
;; the program in a world of its own, which must leave nothing in the log, at a given collection pace
(define-function run-and-compare (p every)
  (model-run p)
  (let ((steps (real-compile p)))
    (gc-collect-every every)
    (real-run steps))
  (gc-collect-every 32768)
  (gc-collect)
  (and (agree?) (= 0 (undo-log-size)) (= 0 (gc-check-heap))))
(define-function programs_agree (p) (verdict (lambda () (run-and-compare p 32768))))
(define-function programs_agree_every (p every) (verdict (lambda () (run-and-compare p every))))

;; a world's log holds one record per slot, however many writes: the same at any length of loop
(define-function loop-log-size (n)
  (let ((size 0))
    (try (let ()
	   (for (i 0 n) (set g0 i) (set-car (real-cell 0) i) (set-array-at real-array 3 i))
	   (set size (undo-log-size)))
	 (lambda (c) c))
    size))
(define-function log_is_bounded (n)
  (verdict (lambda ()
	     (loop-log-size 1)		; the array's first growth is a record of its own
	     (= (loop-log-size 10) (loop-log-size n)))))
;; and an inner world's commit leaves its parent no more than it had
(define-function nested-log-size (n)
  (let ((size 0))
    (try (let ()
	   (for (i 0 n) (try (let () (set g0 i) (set-car (real-cell 0) i)) (lambda (c) c)))
	   (set size (undo-log-size)))
	 (lambda (c) c))
    size))
(define-function merge_is_bounded (n)
  (verdict (lambda () (= (nested-log-size 10) (nested-log-size n)))))

;; past the point the record of slots has to grow, each is still recorded once, and rollback still finds them all
(define-function many_slots (n)
  (verdict (lambda ()
	     (let ((cells ()) (size 0))
	       (for (i 0 n) (set cells (cons (cons i i) cells)))
	       (try (let ()
		      (let ((first 0))
			(list-do c cells (set-car c 'written))
			(set first (undo-log-size))
			(list-do c cells (set-car c 'again))
			(set size (- (undo-log-size) first)))
		      (error "stop"))
		    (lambda (c) c))
	       (let ((good (= size 0)) (i (- n 1)))
		 (list-do c cells (or (= (car c) i) (set good ())) (set i (- i 1)))
		 good)))))

;; a tally of what the generators drew: draw_for_tally only collects it, and every_kind is the law that can fail on it
(define *drawn* ())
(define-function tally (term)
  (when (pair? term)
    (let ((hit (assq (car term) *drawn*)))
      (if hit (set-cdr hit (+ 1 (cdr hit))) (and (symbol? (car term)) (push *drawn* (cons (car term) 1)))))
    (list-do x (cdr term) (tally x))))
(define-function tally-atoms (term)
  (if (pair? term)
      (let () (tally-atoms (car term)) (tally-atoms (cdr term)))
    (and (symbol? term) (let ((hit (assq term *drawn*)))
			  (if hit (set-cdr hit (+ 1 (cdr hit))) (push *drawn* (cons term 1)))))))
(define-function draw_for_tally (p a)
  (tally-atoms p) (tally-atoms a)
  0)
;; every operation has been drawn by the coverage law before this one runs; how many haven't
(define-function kinds_missing (n)
  (let ((missing 0))
    (list-do kind '(global car cdr slot char captured Collect Churn ended failed thrown Keep Drop Waste)
      (or (assq kind *drawn*) (let () (println "never generated: " kind) (set missing (+ missing 1)))))
    missing))

;;; the allocator: objects of every size kept and dropped in any order, and each stays what it was made as
(define-function fill (n)
  (let ((s (string n))) (for (i 0 n) (set-string-at s i (+ ?a (% (+ i n) 26)))) s))
(define-function intact? (s)
  (let ((good 1) (n (string-length s)))
    (for (i 0 n) (or (= (string-at s i) (+ ?a (% (+ i n) 26))) (set good ())))
    good))
(define-function allocations (ops every)
  (verdict (lambda ()
	     (gc-collect-every every)
	     (let ((held ()) (ok 1))
	       (define-function drop-nth (k)
		 (when held
		   (let ((n (% k (list-length held))))
		     (if (= n 0) (set held (cdr held))
		       (let ((c held)) (for (i 1 n) (set c (cdr c))) (set-cdr c (cddr c)))))))
	       (while (pair? ops)
		 (let ((op (cadr ops)) (arg (caddr ops)))
		   (cond ((= op 'Keep) (set held (cons (fill arg) held)))
			 ((= op 'Drop) (drop-nth arg))
			 ((= op 'Waste) (fill arg))
			 ((= op 'Collect) (gc-collect)))
		   (set ops (cadddr ops))))
	       (gc-collect-every 32768)
	       (gc-collect)
	       (list-do s held (or (intact? s) (set ok ())))
	       (and ok (= 0 (gc-check-heap)))))))
