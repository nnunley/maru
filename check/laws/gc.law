-- The collector, over object graphs generated by rules (check/laws/gc-reference.l, in a forked child per question)
reference gc_survives(s)
reference gc_stable(s)
reference gc_frees(s)
reference gc_holds(s)
reference gc_shares(s)
reference gc_cycles(s)
reference gc_world_undoes(s, t)
reference gc_world_keeps(s, t)
reference gc_after_throw(s)
reference gc_throw_restores_roots(s)
reference gc_heap_consistent(s)
reference gc_out_of_memory(m)
reference gc_oom_is_bounded(m)
reference gc_oom_final_exit(m)
reference gc_long_list(n)
reference gc_deep_heads(n)
under test: shape, length, ceiling
let numerals = [0, 1, 2, 7, 31]
defaults trials = 15

rule s_number: number(n)            => shape(n)
rule s_text:   number(n)            => shape(text(n))
rule s_pair:   shape(a), shape(b)   => shape(pair(a, b))
rule s_array:  shape(a), shape(b)   => shape(arr(a, b))
rule s_box:    shape(a)             => shape(box(a))

-- past where recursive marking overflowed the stack (between 100,000 and 200,000)
fact length(1000)
fact length(300000)
-- heap ceilings, in megabytes, for running out
fact ceiling(8)

law survives:     all s: shape(s). gc_survives(s) = accept
law stable:       all s: shape(s). gc_stable(s) = accept
law frees:        all s: shape(s). gc_frees(s) = accept
law holds:        all s: shape(s). gc_holds(s) = accept
law shares:       all s: shape(s). gc_shares(s) = accept
law cycles:       all s: shape(s). gc_cycles(s) = accept
law world_undoes: all s: shape(s), t: shape(t). gc_world_undoes(s, t) = accept
law world_keeps:  all s: shape(s), t: shape(t). gc_world_keeps(s, t) = accept
law after_throw:  all s: shape(s). gc_after_throw(s) = accept
law restores_roots: all s: shape(s). gc_throw_restores_roots(s) = accept
law heap_consistent: all s: shape(s). gc_heap_consistent(s) = accept
law out_of_memory: all m: ceiling(m). gc_out_of_memory(m) = accept by exhaustion
law oom_bounded: all m: ceiling(m). gc_oom_is_bounded(m) = accept by exhaustion
law oom_final_exit: all m: ceiling(m). gc_oom_final_exit(m) = accept by exhaustion
law long_list:    all n: length(n). gc_long_list(n) = accept by exhaustion
law deep_heads:   all n: length(n). gc_deep_heads(n) = accept by exhaustion
