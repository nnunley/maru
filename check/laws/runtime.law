-- the Nile runtime's built-ins and text-layout.nl, run through the batch driver (check/laws/runtime.l)
-- Lengths and seeds come from the block boundary: a block takes about 122 floats, so 121 to 123 and 244 to 245
-- cross one and two of them, and 0 is the empty stream.
under test: run_on, layout
defaults trials = 30
let numerals = [0, 1, 2, 3, 5, 121, 122, 123, 244, 245]

fact workers(1)
fact workers(4)
fact workers(8)
fact builtin("pass")
fact builtin("reverse")
fact builtin("sort")
fact builtin("dupcat")
fact builtin("dupzip")
fact layoutkind("words")
fact layoutkind("breaks")
fact layoutkind("points")
fact lwidth(5)
fact lwidth(10)
fact lwidth(12)

-- built-ins, each against its definition (nile/runtimes/maru/nile-builtins.k, and the names as the test drivers use them)
law pass_identity:     all w: workers(w), n: number(n), s: number(s). run_on("pass", w, rt_input(n, s)) = rt_input(n, s)
law reverse_backwards: all w: workers(w), n: number(n), s: number(s). run_on("reverse", w, rt_input(n, s)) = rt_reverse(rt_input(n, s))
law reverse_involution: all w: workers(w), n: number(n), s: number(s). run_on("reverse", w, run_on("reverse", w, rt_input(n, s))) = rt_input(n, s)
law dupcat_is_twice:   all w: workers(w), n: number(n), s: number(s). run_on("dupcat", w, rt_input(n, s)) = rt_append(rt_input(n, s), rt_input(n, s))
law dupzip_pairs:      all w: workers(w), n: number(n), s: number(s). run_on("dupzip", w, rt_input(n, s)) = rt_interleave(rt_input(n, s), rt_input(n, s))
law sort_keys_ordered: all w: workers(w), n: number(n), s: number(s). rt_keys_ordered(run_on("sort", w, rt_pairs(n, s)), rt_pairs(n, s)) = 1
law sort_permutation:  all w: workers(w), n: number(n), s: number(s). rt_sorted(rt_codes(run_on("sort", w, rt_pairs(n, s)))) = rt_sorted(rt_codes(rt_pairs(n, s)))

-- the same output for every worker count (the runtime's determinism, over pairs, which every built-in takes)
law deterministic:     all k: builtin(k), w: workers(w), n: number(n), s: number(s). run_on(k, w, rt_pairs(n, s)) = run_on(k, 1, rt_pairs(n, s)) && rt_count_is(run_on(k, 1, rt_pairs(n, s)), k, rt_pairs(n, s)) = 1

-- text-layout.nl: MakeWords (Glyph >> Word) keeps the total width and the glyph count of its input
law words_width:       all w: workers(w), lw: lwidth(lw), n: number(n), s: number(s). rt_word_width(layout("words", w, lw, rt_glyphs(n, s))) = rt_glyph_width(rt_glyphs(n, s))
law words_glyphs:      all w: workers(w), lw: lwidth(lw), n: number(n), s: number(s). rt_word_glyphs(layout("words", w, lw, rt_glyphs(n, s))) = rt_glyph_count(rt_glyphs(n, s))

-- text-layout.nl: InsertLineBreaks. A line of two or more words is at most the width, unless a word in it is style 1 (that
-- style never breaks: "else if (W.s = 1) ∨ (o + W.w ≤ w)"); a single word may be longer than the line
law breaks_fit:        all w: workers(w), lw: lwidth(lw), n: number(n), s: number(s). rt_lines_fit(layout("breaks", w, lw, rt_glyphs(n, s)), lw) = 1 && rt_word_glyphs(layout("breaks", w, lw, rt_glyphs(n, s))) = rt_glyph_count(rt_glyphs(n, s))

-- text-layout.nl: PlaceWords sets x' = x + W.w within a line, and PlaceGlyphs is the one that offsets each glyph along it;
-- a glyph after another on the same line starts where that one ends
law points_contiguous: all w: workers(w), lw: lwidth(lw), n: number(n), s: number(s). rt_points_contiguous(layout("points", w, lw, rt_glyphs(n, s)), rt_glyphs(n, s)) = 1

-- one worker and more agree for every layout stage
law layout_deterministic: all k: layoutkind(k), w: workers(w), lw: lwidth(lw), n: number(n), s: number(s). layout(k, w, lw, rt_glyphs(n, s)) = layout(k, 1, lw, rt_glyphs(n, s)) && rt_layout_count(k, layout(k, 1, lw, rt_glyphs(n, s)), rt_glyphs(n, s)) = 1
