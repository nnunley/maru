;;; Support for engine.law: the engine's functions under the names laws use, and
;;; terms generated by rules turned into engine terms (V n) -> one logic variable per n,
;;; (P a b) -> a pair.  holds, generate and enumerate use the file's own rule set, *law-rules*.
(define walk_all walk*)
(define empty *rules-empty*)
(define *lvars-by-n* ())
(define-function lvar-of (n)
  (let ((b (assq n *lvars-by-n*)))
    (if b (cdr b) (let ((v (new <lv> (+ 1000 n)))) (set *lvars-by-n* (cons (cons n v) *lvars-by-n*)) v))))
(define-function realise (t)
  (cond ((and (pair? t) (= 'V (car t)))	(lvar-of (cadr t)))
	((and (pair? t) (= 'P (car t)))	(cons (realise (cadr t)) (realise (caddr t))))
	(else				t)))
(define-function succeeds (s) (if s 1 ()))
(define-function elem (x l) (if (member? x l) 1 0))
(define-function holds (x) (if (rules-holds? *law-rules* (list 'nat x) 2) 1 0))
(define-function generate (seed) (rules-seed seed) (rules-generate *law-rules* '(nat $n) 2))
(define-function enumerate () (rules-enumerate *law-rules* '(nat $n) 2))
