;;; gc.law's references: what the collector must do, asked of real objects with the real collector.  Each question runs in
;;; a forked child (law-child, check/law.l), since a collector that fails usually fails by crashing.  It exits 0 to
;;; accept and 3 to reject; anything else is (crash status), which makes the law INCONCLUSIVE, not refuted.
(require "recover.l")
(define-structure <gc-box> (value))
(define-function gc-array (a b)
  (let ((array (array))) (set-array-at array 0 a) (set-array-at array 1 b) array))
(define-function gc-text (n)
  (let ((text (string n))) (for (i 0 n) (set-string-at text i (+ ?a (% i 26)))) text))
(require "build/gc-shapes.g.l")
(define-function build (shape) (parse-source <gc-shapes> $build (list shape)))

;; the term an object is, read back from the object, by its type
(define-selector shape-of (x) x)
(define-method shape-of <pair> () (list 'pair (shape-of (car self)) (shape-of (cdr self))))
(define-method shape-of <array> () (list 'arr (shape-of (array-at self 0)) (shape-of (array-at self 1))))
(define-method shape-of <gc-box> () (list 'box (shape-of (<gc-box>-value self))))
(define-method shape-of <string> ()
  (let ((n (string-length self)) (same 1))
    (for (i 0 n) (or (= (string-at self i) (+ ?a (% i 26))) (set same ())))
    (if same (list 'text n) 'damaged-text)))

(define gc-collect (subr "GC_gcollect"))
(define gc-count (subr "GC_count_objects" ">l"))
(define-function collect (n) (for (i 0 n) (gc-collect)))
;; asks a question in a child: its body answers true to accept
(define-function gc-verdict (ask)
  (let ((status (law-child (lambda () ((subr "alarm" "i>i") 60) (_exit (if (ask) 0 3))))))
    (cond ((= 0 status) accept) ((= (<< 3 8) status) reject) (else (list 'crash status)))))
(define-function churn (n) (for (i 0 n) (cons i i)))

;; what's reachable is there afterwards, exactly as it was
(define-function gc_survives (s)
  (gc-verdict (lambda () (let ((x (build s))) (collect 1) (equal (shape-of x) s)))))
;; collecting again changes nothing, and nor does allocating among what's live
(define-function gc_stable (s)
  (gc-verdict (lambda ()
		(let ((x (build s)))
		  (collect 2) (churn 40000) (collect 1)
		  (equal (shape-of x) s)))))

(define gc-copies 200)
;; many copies: what's dropped is freed, down to where it began, and what's held isn't
(define-function copies (s)
  (let ((all ())) (for (i 0 gc-copies) (set all (cons (build s) all))) all))
(define-function gc_frees (s)
  (gc-verdict (lambda ()
		(collect 2) (copies s) (collect 2)
		(let ((before (gc-count)))
		  (copies s) (collect 2)
		  (<= (gc-count) (+ before 64))))))
(define-function gc_holds (s)
  (gc-verdict (lambda ()
		(collect 2)
		(let* ((before (gc-count)) (all (copies s)))
		  (collect 2)
		  (and (>= (gc-count) (+ before gc-copies))
		       (let ((good 1)) (list-do x all (or (equal (shape-of x) s) (set good ()))) good))))))

;; one object reached twice stays one object
(define-function gc_shares (s)
  (gc-verdict (lambda ()
		(let* ((shared (cons (build s) 0)) (holder (cons shared shared)))
		  (collect 1) (churn 1000) (collect 1)
		  (set-cdr (car holder) 1)
		  (and (= (car holder) (cdr holder))
		       (= 1 (cdr (cdr holder)))
		       (equal (shape-of (car (car holder))) s))))))
;; a cycle is marked once and survives while reachable, and is freed once it isn't
(define-function gc_cycles (s)
  (gc-verdict (lambda ()
		(let ((x (cons (build s) ())))
		  (set-cdr x x)
		  (collect 2)
		  (and (= x (cdr x)) (equal (shape-of (car x)) s)
		       (let ((before (let () (collect 2) (gc-count))))
			 (for (i 0 gc-copies) (let ((c (cons (build s) ()))) (set-cdr c c)))
			 (collect 2)
			 (<= (gc-count) (+ before 64))))))))

;; worlds: a failed one leaves the object as it was, through a collection; a finished one keeps its writes
(define-function gc_world_undoes (s t)
  (gc-verdict (lambda ()
		(let ((x (cons (build s) (build s))))
		  (try (let ()
			 (set-car x (build t))
			 (set-cdr x (build t))
			 (collect 1)
			 (error "stop"))
		       (lambda (c) c))
		  (collect 1)
		  (and (equal (shape-of (car x)) s) (equal (shape-of (cdr x)) s))))))
(define-function gc_world_keeps (s t)
  (gc-verdict (lambda ()
		(let ((x (cons (build s) (build s))))
		  (try (let () (set-car x (build t)) (collect 1)) (lambda (c) c))
		  (collect 1)
		  (and (equal (shape-of (car x)) t) (equal (shape-of (cdr x)) s))))))
;; a throw puts back the collector's roots: what's live is live, and nothing freed gets marked
(define-function gc_after_throw (s)
  (gc-verdict (lambda ()
		(let ((x (build s)))
		  (catch 'out (lambda ()
				(let ((y (build s)))
				  (map (lambda (e) (collect 1) (throw 'out e)) (list y)))))
		  (collect 2) (churn 40000) (collect 1)
		  (equal (shape-of x) s)))))
;; the same, directly: stale roots only crash once something overwrites the dead frames they point into
(define-function roots-moved-by (thunk)	; read at one depth, so only thunk can make them differ
  (let* ((before (stub-word-at catch-roots 0))
	 (_ (thunk))
	 (after (stub-word-at catch-roots 0)))
    (- after before)))
(define-function gc_throw_restores_roots (s)
  (gc-verdict (lambda ()
		(= (roots-moved-by (lambda () 0))
		   (roots-moved-by (lambda ()
				     (catch 'out (lambda () (map (lambda (e) (build s) (throw 'out e)) '(1))))))))))
;; the heap's own books balance, whatever was made and dropped: every block counted, every free one findable
(define gc-check-heap (subr "GC_check_heap" ">l"))
(define-function gc_heap_consistent (s)
  (gc-verdict (lambda ()
		(and (= 0 (gc-check-heap))
		     (let ((kept (copies s)))
		       (copies s)
		       (and (= 0 (gc-check-heap))
			    (let () (collect 1) (= 0 (gc-check-heap)))
			    (let () (set kept ()) (collect 2) (= 0 (gc-check-heap)))))))))
;; a limit this much above what's in use now, whatever this evaluator and the law runner already hold
(define gc-bytes-used (subr "GC_bytes_used" ">l"))
(define-function limit-above-use (megabytes)
  (collect 1)
  (let ((limit (+ (gc-bytes-used) (* megabytes (* 1024 1024)))))
    (set-heap-limit limit)
    limit))
;; running out of memory is an error like any other, more than once, and what's left works
(define-function unbounded () (let ((l ())) (while 1 (set l (cons 0 l)))))
(define-function gc_out_of_memory (megabytes)
  (gc-verdict (lambda ()
		(let ((x (list 1 2 3)))
		  (limit-above-use megabytes)
		  (let ((first (try (unbounded) (lambda (c) c)))
			(second (try (unbounded) (lambda (c) c))))
		    (collect 1)
		    (and (= 'fatal (car first)) (= 'fatal (car second))
			 (= 0 (gc-check-heap))
			 (equal x '(1 2 3))
			 (= 1000 (list-length (let ((l ())) (for (i 0 1000) (set l (cons i l))) l)))))))))
;; the reserve can't creep: however many times it runs out, the heap stays near the limit
(define gc-heap-bytes (subr "GC_heap_bytes" ">l"))
(define-function gc_oom_is_bounded (megabytes)
  (gc-verdict (lambda ()
		(limit-above-use megabytes)
		(for (i 0 2) (try (unbounded) (lambda (c) c)))
		;; the first times grow the heap as far as the limit and the reserve take it; after that it must not grow at all
		(let ((after-one (gc-heap-bytes)))
		  (for (i 0 3) (try (unbounded) (lambda (c) c)))
		  (collect 1)
		  (and (= 0 (gc-check-heap))
		       (= (gc-heap-bytes) after-one))))))
;; what truly can't be recovered ends the program, with a status of its own, since an ordinary unhandled error exits 1:
;; running out again while all of it is still held makes no room
(define *held* ())
(define-function gc_oom_final_exit (megabytes)
  (let ((status (law-child (lambda ()
			     ((subr "alarm" "i>i") 60)
			     (limit-above-use megabytes)
			     (define-function hold-forever () (while 1 (set *held* (cons 0 *held*))))
			     (catch 'room (lambda () (with-handler (lambda (c) (throw 'room 0)) hold-forever)))
			     (catch 'room (lambda () (with-handler (lambda (c) (throw 'room 0)) hold-forever)))
			     (_exit 3)))))
    (if (= status (<< 70 8)) accept (if (= status (<< 3 8)) reject (list 'crash status)))))
;; a collection can fall on any allocation, so make it fall on every one: what's held only by C at that moment is lost,
;; and nothing else shows it, since it depends on where the collections happen to land
(define gc-collect-every (subr "GC_collect_every" "i"))
(define-function gc_every_allocation (s t)
  (gc-verdict (lambda ()
		(let ((x (cons (build s) (build s))) (shape-t (build t)))
		  (gc-collect-every 1)
		  (let ((failed (try (let ()
				       (set-car x shape-t)
				       (set-cdr x (cons 0 0))
				       (error "stop"))
				     (lambda (c) c)))
			(thrown (catch 'out (lambda ()
					      (try (let () (set-car x 1) (throw 'out 'thrown)) (lambda (c) c)))))
			(kept (try (let () (set-cdr x shape-t) 'kept) (lambda (c) c))))
		    (gc-collect-every 32768)
		    (and (= 'error (car failed)) (= thrown 'thrown) (= kept 'kept)
			 (equal (shape-of (car x)) s)
			 (equal (shape-of (cdr x)) t)))))))
;; the longest chain marking meets, through either field, can't overflow the C stack
(define-function gc_long_list (n)
  (gc-verdict (lambda ()
		(let ((l ()))
		  (for (i 0 n) (set l (cons i l)))
		  (collect 1)
		  (= n (list-length l))))))
(define-function gc_deep_heads (n)
  (gc-verdict (lambda ()
		(let ((l ()))
		  (for (i 0 n) (set l (cons l i)))
		  (collect 1)
		  (let ((depth 0))
		    (while l (set l (car l)) (set depth (+ depth 1)))
		    (= n depth))))))
