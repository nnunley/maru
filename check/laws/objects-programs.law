-- The programs objects.law generates over the kernel's objects, and how the driver reads them (check/objects-run.k):
-- one operation a line, its code first.  Four slots hold objects; a slot's type decides what set and look reach, and
-- get and put name a type of their own, right or wrong (an empty slot is nil, of type 0).
for s in [0 .. 3]: fact slot(s)
-- every type: the kernel's thirteen (kernel-objects.k), and the driver's <knot> (13) and atom <pixel> (14)
for t in [0 .. 14]: fact kind(t)
-- the types a kernel constructor makes
for t in [1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12]: fact maker(t)
-- the types with fields, which get and put name
for t in [2, 3, 4, 5, 6, 8, 9, 10, 11, 12, 13, 14]: fact typed(t)

fact program(End)
rule p_one:   op(o), program(p)               => program(seq(o, p))
rule p_three: op(a), op(b), op(c), program(p) => program(seq(a, seq(b, seq(c, p))))
rule o_new:   slot(s), kind(t)                                  => op(new(s, t))
rule o_build: slot(s), maker(t), number(a), number(b)           => op(build(s, t, a, b))
rule o_set:   slot(s), number(f), number(v)                     => op(set(s, f, v))
rule o_look:  slot(s), number(f)                                => op(look(s, f))
rule o_get:   slot(s), typed(t), number(f)                      => op(get(s, t, f))
rule o_put:   slot(s), typed(t), number(f), number(v)           => op(put(s, t, f, v))
rule o_type:  slot(s)                                           => op(type(s))
-- a constructor's object read at once, so made objects' fields are reached often
rule o_inspect: slot(s), maker(t), number(a), number(b), number(f) => op(inspect(s, t, a, b, f))
fact op(Collect)

-- inspect is two lines: a build, then a look at what it made
let encode = seq(inspect(s, t, a, b, f), p) -> [[2, s, t, a, b] | [[4, s, f] | encode(p)]]
           | seq(o, p)                       -> [code(o) | encode(p)]
           | End                             -> []
let code = new(s, t)        -> [1, s, t]
         | build(s, t, a, b) -> [2, s, t, a, b]
         | set(s, f, v)     -> [3, s, f, v]
         | look(s, f)       -> [4, s, f]
         | get(s, t, f)     -> [5, s, t, f]
         | put(s, t, f, v)  -> [6, s, t, f, v]
         | type(s)          -> [7, s]
         | Collect          -> [8]
