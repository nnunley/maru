;;; hash.l's identity caches: a key answers the value last put for it, or () once another key took its slot; it never
;;; answers another key's value.  The last line is "identity cache ok".
;;;   ./eval check/identity-cache.l     (and ./eval2 -b boot2.l, ./eval3 -b boot2.l)
(require "hash.l")
(define failures 0)
(define-function expect (what got want)
  (or (equal got want) (let () (set failures (+ failures 1)) (println "FAIL " what ": got " got ", want " want))))
(define c (identity-cache 64))
(expect "a miss" (cache-at c 'x9) ())
(expect "put answers the value" (cache-at-put c 'x9 9) 9)
(expect "a hit" (cache-at c 'x9) 9)
(cache-at-put c 'x9 10)
(expect "put again replaces" (cache-at c 'x9) 10)
(define one (identity-cache 1))	; every key shares its one slot
(cache-at-put one 'a 1)
(cache-at-put one 'b 2)
(expect "a key whose slot another took misses" (cache-at one 'a) ())
(expect "and the other answers" (cache-at one 'b) 2)
(define k (string->symbol "fresh-key"))
(cache-at-put c k 'v)
(expect "a key by identity" (cache-at c (string->symbol "fresh-key")) 'v)	; interned: the same symbol
(expect "a string is not identical to its symbol" (cache-at c "fresh-key") ())
(define s1 "text")
(define one-string (identity-cache 1))
(cache-at-put one-string s1 'first)
(expect "an equal string elsewhere is another key" (cache-at one-string (concat-string "te" "xt")) ())
(expect "the string itself" (cache-at one-string s1) 'first)
(or (= 0 failures) (error "identity-cache: " failures " failures"))
(println "identity cache ok")
