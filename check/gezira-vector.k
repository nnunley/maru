;; Gezira's Vector arithmetic (gezira/nile/gezira.nl), run: check/gezira/vector-kernels.nl appended to gezira.nl adds
;; vector pairs and a number to a vector through Nile's Maru back end and runtime. (1, 2) + (10, 20) is (11, 22) and
;; (3, 4) + (5, 6) is (8, 10); (1, 2) + 5 is (6, 7). Prints "gezira vector ok" when every sum is right.
(define (printf (int char * ...) *) (extern printf))
(define (malloc (void * long) *) (extern malloc))
(define (free (void void *) *) (extern free))

(define (NBYTES int) 1000000)

;; a stream through kernel into a capture of out: n floats in, the captured count answered
(define-function run_kernel int ((init nile_Process_t *) (kernel nile_Process_t *) (in float *) (n int) (out float *))
  (let (((count int) 0)
	((p nile_Process_t *) 0))
    (set p (nile_Process_pipe kernel (nile_Capture init out (addressof count) 16)))
    (set p (nile_Process_pipe (nile_Funnel init) p))
    (nile_Funnel_pour p in n 1)
    (nile_sync init)
    (return count)))

(define-function main int ((argc int) (argv char * *))
  (let* (((mem char *) (malloc (cast NBYTES long)))
	 ((init nile_Process_t *) (nile_startup mem NBYTES 1))
	 ((in float *) (malloc (cast 64 long)))
	 ((out float *) (malloc (cast 64 long)))
	 ((failed int) 0)
	 ((n int) 0))
    (if (= 0 (cast init long)) (return 1))
    (set (indir in 0) 1.0) (set (indir in 1) 2.0) (set (indir in 2) 10.0) (set (indir in 3) 20.0)
    (set (indir in 4) 3.0) (set (indir in 5) 4.0) (set (indir in 6) 5.0) (set (indir in 7) 6.0)
    (set n (run_kernel init (gezira_vector_AddVectors init) in 8 out))
    (if (or (!= n 4) (!= (indir out 0) 11.0) (!= (indir out 1) 22.0) (!= (indir out 2) 8.0) (!= (indir out 3) 10.0))
	(let ()
	  (printf "Vector + Vector: %d floats, (%g, %g) (%g, %g)\n" n (cast (indir out 0) double) (cast (indir out 1) double)
		  (cast (indir out 2) double) (cast (indir out 3) double))
	  (set failed 1)))
    (set (indir in 0) 1.0) (set (indir in 1) 2.0) (set (indir in 2) 5.0)
    (set n (run_kernel init (gezira_vector_AddToVector init) in 3 out))
    (if (or (!= n 2) (!= (indir out 0) 6.0) (!= (indir out 1) 7.0))
	(let ()
	  (printf "Vector + Number: %d floats, (%g, %g)\n" n (cast (indir out 0) double) (cast (indir out 1) double))
	  (set failed 1)))
    (if (nile_error init) (set failed 1))
    (if (= failed 0) (printf "gezira vector ok\n") (printf "gezira vector FAILED\n"))
    (free (nile_shutdown init))
    (free in)
    (free out)
    (return failed)))
