;;; Structs by value compiled natively (check/native.l): 12 and 16 bytes passed and returned both ways, a 16-byte one
;;; returned by C (ldiv), one that spills to the stack after seven longs, and 8-byte pieces at slots 4 past a multiple of 8
;;; (the 12-byte <three> has them too).
(define-struct <three> ((a int) (b int) (c int)))
(define-struct <two> ((p long) (q long)))
(define-struct <foo> ((x int) (y int)))
(define-struct <ldiv> ((quot long) (rem long)))
(define (ldiv ((struct <ldiv>) long long) *) (extern ldiv))

(define-function three-sum long ((s struct <three>)) (return (cast (+ (* 100 (. s a)) (+ (* 10 (. s b)) (. s c))) long)))
(define-function three-make (struct <three>) ((a int) (b int) (c int))
  (let (((s struct <three>)))
    (set (. s a) a)
    (set (. s b) b)
    (set (. s c) c)
    (return s)))
(define-function three-round long () (return (three-sum (three-make 4 5 6))))
(define-function two-swap (struct <two>) ((s struct <two>))
  (let (((t struct <two>)))
    (set (. t p) (. s q))
    (set (. t q) (. s p))
    (return t)))
(define-function two-round long ((p long) (q long))
  (let (((s struct <two>)))
    (set (. s p) p)
    (set (. s q) q)
    (let (((t struct <two>) (two-swap s)))
      (return (- (* 1000 (. t p)) (. t q))))))
(define-function ldiv-of long ((n long) (d long))
  (let (((r struct <ldiv>) (ldiv n d)))
    (return (+ (* 100 (. r quot)) (. r rem)))))

;; the struct doesn't fit the one general register left: AAPCS64 puts it on the stack and no register after it is used
(define-function spill long ((a long) (b long) (c long) (d long) (e long) (f long) (g long) (s struct <two>) (h long))
  (return (+ (+ a (+ b (+ c (+ d (+ e (+ f g)))))) (+ (* 100 (. s p)) (+ (* 1000 (. s q)) (* 10000 h))))))
(define-function call-spill long ()
  (let (((s struct <two>)))
    (set (. s p) 2)
    (set (. s q) 3)
    (return (spill 1 1 1 1 1 1 1 s 4))))

;; an int parameter before a struct <foo> puts its 8-byte piece at a slot 4 past a multiple of 8; three int locals don't
;; (ir2 lays slots out in zones by type), and are kept as a case that passes either way
(define-function foo-after-int long ((i int) (s struct <foo>)) (return (cast (+ i (+ (* 10 (. s x)) (* 100 (. s y)))) long)))
(define-function foo-locals long ((s struct <foo>))
  (let (((i int) 1) ((j int) 2) ((k int) 3) ((t struct <foo>) s))
    (return (cast (+ (+ i (+ j k)) (+ (* 10 (. t x)) (* 100 (. t y)))) long))))
(define-function call-foos long ()
  (let (((s struct <foo>)))
    (set (. s x) 7)
    (set (. s y) 8)
    (return (+ (* 10000 (foo-after-int 1 s)) (foo-locals s)))))
