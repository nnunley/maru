;;; User labels are each function's own and each let's (check/native.l): two functions with a label of one name, and
;;; two sibling lets in one function with a label of one name, each goto reaching its own.
(define-function first-done long ()
  (goto done)
  (return 1)
  (label done)
  (return 10))
(define-function second-done long ()
  (goto done)
  (return 2)
  (label done)
  (return 20))
(define-function sibling-done long ()
  (let (((r long) 0))
    (let ()
      (goto done)
      (set r 1)
      (label done)
      (set r (+ r 100)))
    (let ()
      (goto done)
      (set r (+ r 2))
      (label done)
      (set r (+ r 1000)))
    (return r)))
