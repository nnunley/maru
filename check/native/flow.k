;;; Control flow compiled natively (check/native.l): while, if with and without a value, and, or, not, every comparison.
(define-function gcd long ((a long) (b long))
  (while (!= a b) (if (> a b) (set a (- a b)) (set b (- b a))))
  (return a))
(define-function max3 long ((a long) (b long) (c long))
  (if (and (>= a b) (>= a c)) (return a))
  (if (or (> b c) (= b c)) (return b))
  (return c))
(define-function sum-below long ((n long))
  (let (((i long) 0) ((acc long) 0))
    (while (< i n) (set acc (+ acc i)) (set i (+ i 1)))
    (return acc)))
(define-function pick long ((t long) (a long) (b long)) (return (if (not (= t 0)) a b)))
(define-function relations long ((a long) (b long))
  (let (((bits long) 0))
    (if (< a b) (set bits (+ bits 1)))
    (if (<= a b) (set bits (+ bits 2)))
    (if (> a b) (set bits (+ bits 4)))
    (if (>= a b) (set bits (+ bits 8)))
    (if (= a b) (set bits (+ bits 16)))
    (if (!= a b) (set bits (+ bits 32)))
    (return bits)))
