;;; Memory and types compiled natively (check/native.l): sub-word stores and loads, struct fields, indexing, addressof,
;;; casts, and the arithmetic and bitwise operations, with C's signed results.
(define-struct <rec> ((a long) (b int) (c char)))
(define-function through8 long ((p void *) (v long))
  (set (indir (cast p char *) 0) (cast v char))
  (return (cast (indir (cast p char *) 0) long)))
(define-function through16 long ((p void *) (v long))
  (set (indir (cast p short *) 0) (cast v short))
  (return (cast (indir (cast p short *) 0) long)))
(define-function through32 long ((p void *) (v long))
  (set (indir (cast p int *) 0) (cast v int))
  (return (cast (indir (cast p int *) 0) long)))
(define-function fields long ((r struct <rec> *))
  (set (. r a) 7)
  (set (. r b) 8)
  (set (. r c) (cast 9 char))
  (return (+ (. r a) (+ (cast (. r b) long) (cast (. r c) long)))))
(define-function sum-array long ((p long *) (n long))
  (let (((i long) 0) ((acc long) 0))
    (while (< i n) (set acc (+ acc (indir p i))) (set i (+ i 1)))
    (return acc)))
(define-function element-field long ((r struct <rec> *) (i long))
  (set (. (indir r i) b) 41)
  (return (cast (. (indir r i) b) long)))
(define-function via-address long ((v long))
  (let (((x long) v) ((q long *) 0))
    (set q (addressof x))
    (set (indir q 0) (+ (indir q 0) 1))
    (return x)))
(define-function arith long ((a long) (b long) (op long))
  (if (= op 0) (return (* a b)))
  (if (= op 1) (return (/ a b)))
  (if (= op 2) (return (% a b)))
  (if (= op 3) (return (& a b)))
  (if (= op 4) (return (| a b)))
  (if (= op 5) (return (^ a b)))
  (if (= op 6) (return (<< a (cast b int))))
  (if (= op 7) (return (>> a (cast b int))))
  (return (~ a)))

;; zero, an int, written to pointers: each write stores the whole pointer, the place's size, not the int's
(define-struct <link> ((next struct <link> *)))
(define (spare void *) 0)
(define-function null-local long ((p void *))
  (let (((q void *) p))
    (set q 0)
    (return (cast q long))))
(define-function null-field long ((r struct <link> *))
  (set (. r next) r)
  (set (. r next) 0)
  (return (cast (. r next) long)))
(define-function null-element long ((pp void * *))
  (set (indir pp 1) pp)
  (set (indir pp 1) 0)
  (return (cast (indir pp 1) long)))
(define-function null-global long ((p void *))
  (set spare p)
  (set spare 0)
  (return (cast spare long)))
;; an integer literal wider than an int is a long, so a cast keeps all its bits (2^62 + 5, and INT64_MAX)
(define-function wide-literal long ((which long))
  (if which (return (cast 9223372036854775807 long)))
  (return (cast 4611686018427387909 long)))
