;;; Override gen-env for C backend
(define-function gen-env (env)
  ;; Generate the complete C file with proper structure
  (c-generate-preamble)
  
  ;; First pass: generate all global variable declarations
  (println "/* Global variables */")
  (let* ((vars (<env>-bindings env))
         (comp (compiler 0))
         (index (array-length vars)))
    (while (<= 0 (set index (- index 1)))
      (let ((name (<variable>-name (array-at vars index)))
            (value (<variable>-value (array-at vars index))))
        (cond
          ((= <long> (type-of value))
           (print "static oop ") (c-print-mangled-name name) (println "= nil;"))
          ((= <string> (type-of value))
           (print "static oop ") (c-print-mangled-name name) (println "= nil;"))
          ((= <expr> (type-of value))
           (print "static oop ") (c-print-mangled-name name) (println "();"))
          (else
           (print "static oop ") (c-print-mangled-name name) (println "= nil;"))))))
  
  (println)
  
  ;; Second pass: generate string data
  (println "/* String data */")
  (let* ((vars (<env>-bindings env))
         (index (array-length vars)))
    (while (<= 0 (set index (- index 1)))
      (let ((name (<variable>-name (array-at vars index)))
            (value (<variable>-value (array-at vars index))))
        (and (= <string> (type-of value))
             (let ()
               (print "static wchar_t ") (c-print-mangled-name name) (print "_data[] = L")
               (dumpln value)
               (println ";"))))))
  
  (println)
  
  ;; Third pass: generate function definitions
  (println "/* Function definitions */")
  (let* ((vars (<env>-bindings env))
         (index (array-length vars)))
    (while (<= 0 (set index (- index 1)))
      (let ((name (<variable>-name (array-at vars index)))
            (value (<variable>-value (array-at vars index))))
        (and (= <expr> (type-of value))
             (let ((comp (compiler 0)))
               (warn name "\n")
               (gen-definition value name comp))))))
  
  ;; Generate initialization function
  (println)
  (println "/* Global initialization */")
  (println "static void initialize_globals(void)")
  (c-begin-block)
  (let* ((vars (<env>-bindings env))
         (index (array-length vars)))
    (while (<= 0 (set index (- index 1)))
      (let ((name (<variable>-name (array-at vars index)))
            (value (<variable>-value (array-at vars index))))
        (cond
          ((= <long> (type-of value))
           (c-indent) (c-print-mangled-name name) (println "= newLong(" value ");"))
          ((= <string> (type-of value))
           (c-indent) (c-print-mangled-name name) (print "= newString(") (c-print-mangled-name name) (println "_data);"))
          ((= <expr> (type-of value))
           (c-indent) (c-print-mangled-name name) (print "= (oop)") (c-print-mangled-name name) (println ";"))))))
  (c-end-block)
  
  ;; Generate main function
  (println)
  (println "/* Program entry point */")
  (println "int main(int argc, char **argv)")
  (c-begin-block)
  (c-indent) (println "initialize_globals();")
  (c-indent) (println "return (int)((long)main());")
  (c-end-block))

