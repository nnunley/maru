;;; THROWAWAY SPIKE.  Operations on the wire: a value as tagged text, frames with a length, and a sync over one connection.
;;; The client sends what it has per actor, the server answers with what the client lacks and what it has, the client sends
;;; what the server lacks.  What's still waiting in a queue isn't counted as held.
(require "spike/net.l")
(require "spike/ops.l")
(define-selector wire-encode (x) (error "wire: can't send " x))
(define-method wire-encode <long> () (concat-strings "i" (long->string self) ";"))
(define-method wire-encode <string> () (concat-strings "s" (long->string (string-length self)) ":" self))
(define-method wire-encode <symbol> () (let ((t (symbol->string self))) (concat-strings "y" (long->string (string-length t)) ":" t)))
(define-method wire-encode <undefined> () "n")
(define-method wire-encode <pair> ()
  (let ((parts (list "(")) (l self))
    (while l (push parts (wire-encode (car l))) (set l (cdr l)))
    (push parts ")")
    (apply concat-strings (list-reverse! parts))))
(define *wire-text* "")  (define *wire-at* 0)
(define-function wire-number ()			; digits up to a one-byte terminator
  (let ((n 0) (c (string-at *wire-text* *wire-at*)))
    (while (and (>= c 48) (<= c 57))
      (set n (+ (* n 10) (- c 48)))
      (set *wire-at* (+ *wire-at* 1))
      (set c (string-at *wire-text* *wire-at*)))
    (set *wire-at* (+ *wire-at* 1))
    n))
(define-function wire-bytes (n)
  (let ((s (string n)))
    (for (i 0 n) (set-string-at s i (string-at *wire-text* (+ *wire-at* i))))
    (set *wire-at* (+ *wire-at* n))
    s))
(define wire-decode-next)
(define-function wire-decode-list ()
  (let ((items ()))
    (while (!= 41 (string-at *wire-text* *wire-at*))
      (push items (wire-decode-next)))
    (set *wire-at* (+ *wire-at* 1))
    (list-reverse! items)))
(define-function wire-decode-next ()
  (let ((tag (string-at *wire-text* *wire-at*)))
    (set *wire-at* (+ *wire-at* 1))
    (cond
      ((= tag 105) (wire-number))
      ((= tag 115) (wire-bytes (wire-number)))
      ((= tag 121) (string->symbol (wire-bytes (wire-number))))
      ((= tag 110) ())
      ((= tag 40) (wire-decode-list))
      (else (error "wire: a bad tag: " tag)))))
(define-function wire-decode (text)
  (set *wire-text* text)
  (set *wire-at* 0)
  (wire-decode-next))
;; frames: decimal length, newline, bytes.  A connection is (fd . unread text)
(define-function conn-new (fd) (cons fd ""))
(define-function conn-fill (c)
  (let ((more (net-recv-some (car c))))
    (or more (error "wire: the peer hung up"))
    (set (cdr c) (concat-string (cdr c) more))))
(define-function frame-send (c value)
  (let ((body (wire-encode value)))
    (net-send (car c) (concat-strings (long->string (string-length body)) "\n" body))))
(define-function frame-recv (c)
  (while (not (text-find (cdr c) "\n" 0)) (conn-fill c))
  (let* ((nl (text-find (cdr c) "\n" 0)) (n 0))
    (for (i 0 nl) (set n (+ (* n 10) (- (string-at (cdr c) i) 48))))
    (while (< (string-length (cdr c)) (+ nl (+ 1 n))) (conn-fill c))
    (let ((body (string (+ n 0))) (text (cdr c)) (rest (string (- (string-length (cdr c)) (+ nl (+ 1 n))))))
      (for (i 0 n) (set-string-at body i (string-at text (+ nl (+ 1 i)))))
      (for (i 0 (string-length rest)) (set-string-at rest i (string-at text (+ nl (+ 1 (+ n i))))))
      (set (cdr c) rest)
      (wire-decode body))))
;; (actor ctr) is held, so with the queue in front everything earlier by that actor is too
(define-function replica-vector (r)
  (let ((v ()))
    (list-do op (<replica>-ops r)
      (let ((b (assq (op-actor op) v)))
	(if b
	    (and (> (op-ctr op) (cdr b)) (set (cdr b) (op-ctr op)))
	  (push v (cons (op-actor op) (op-ctr op))))))
    (map (lambda (b) (list (car b) (cdr b))) v)))
(define-function vector-lacks? (vector op)
  (let ((high 0))
    (list-do b vector (and (= (car b) (op-actor op)) (set high (cadr b))))
    (> (op-ctr op) high)))
(define-function replica-ops-for (r vector)
  (let ((out ()))
    (list-do op (<replica>-ops r) (and (vector-lacks? vector op) (push out op)))
    out))
(define-function sync-client (r port)
  (let* ((fd (net-connect port)) (c (conn-new fd)))
    (frame-send c (list (replica-vector r)))
    (let* ((reply (frame-recv c)) (ops (car reply)) (theirs (cadr reply)))
      (list-do op ops (replica-receive r op))
      (frame-send c (list (replica-ops-for r theirs))))
    c))
(define-function sync-serve (r c)
  (let ((theirs (car (frame-recv c))))
    (frame-send c (list (replica-ops-for r theirs) (replica-vector r)))
    (list-do op (car (frame-recv c)) (replica-receive r op))))
