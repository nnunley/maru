;;; THROWAWAY SPIKE.  Two processes, each its own heap and its own replica, sync over TCP and must then agree: on the store, on John's
;;; answers over shared events, and on what a model said, without asking it again.  The model is a fake on a local port
;;; that speaks Ollama's /api/generate and counts what reaches it, so the count can be checked.
(require "spike/john-llm.l")
(require "spike/wire.l")
(define failures 0)
(define-function check-that (name ok) (println (if ok "ok   " "FAIL ") name) (or ok (set failures (+ failures 1))))
;; ---- the fake model
(define-function read-request (fd)		; headers and a Content-Length body
  (let ((text "") (done ()))
    (while (not done)
      (let ((part (net-recv-some fd)))
	(if (not part)
	    (set done 1)
	  (set text (concat-string text part))
	  (let ((end (text-find text "\r\n\r\n" 0)) (cl (text-find text "Content-Length: " 0)))
	    (and end cl
		 (let ((n 0) (i (+ cl 16)))
		   (while (!= 13 (string-at text i))
		     (set n (+ (* n 10) (- (string-at text i) 48)))
		     (set i (+ i 1)))
		   (and (>= (string-length text) (+ end (+ 4 n))) (set done 1))))))))
    text))
(define-function http-reply (fd body)
  (net-send fd (concat-strings "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: "
			       (long->string (string-length body)) "\r\n\r\n" body))
  (net-close fd))
(define-function fake-model (listener)
  (let ((hits 0) (running 1))
    (while running
      (let* ((fd (net-accept listener)) (req (read-request fd)))
	(if (text-find req "POST /count" 0)
	    (let () (http-reply fd (concat-strings "{\"response\":\"" (long->string hits) "\"}")) (set running ()))
	  (set hits (+ hits 1))
	  (http-reply fd (if (text-find req "open?" 0)
			     ;; like a real model, the same question needn't get the same answer
			     (concat-strings "{\"model\":\"fake\",\"response\":\"" (if (= 0 (% hits 2)) "yes" "no") "\",\"done\":true}")
			   (concat-strings "{\"model\":\"fake\",\"response\":\"answer \\\"" (long->string hits)
					   "\\\"\\n\\u00e9\",\"done\":true}"))))))))
;; a real server answers in chunks, so the decoder is tested here as well as against it
(check-that "a chunked body is put back together"
	    (equal "hello world" (http-body "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n")))
(check-that "a hex chunk length" (= 26 (string-length (http-body (concat-string "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1a\r\nabcdefghijklmnopqrstuvwxyz\r\n0\r\n\r\n" "")))))
(define model (net-listen 0))
(define model-pid (net-spawn (lambda () (fake-model (car model)))))
(net-close (car model))
(set *llm-port* (cdr model))
(define-function model-hits ()
  (let ((fd (net-connect (cdr model))))
    (net-send fd "POST /count HTTP/1.1\r\nContent-Length: 0\r\n\r\n")
    (let ((reply (http-body (net-recv-all fd))))
      (net-close fd)
      (json-string-field reply "response"))))
;; ---- both peers run this
(define program (concat-list (john-read "check/john/airline.john")
			     (john-read-text "qualify Flight open if \"open?\" ask = \"yes\".")))
(define questions "P1 has-reservation. P2 has-reservation. P3 has-reservation. F booked. F open.")
(define-function peer-results (r)		; everything the peers must agree on, as one value
  (let ((c (chain-new r program)))
    (chain-refresh c)
    (list (replica-state r)
	  (replica-winners r)
	  (chain-ask c questions)
	  (replica-ask r "the shared question"))))
(define-function peer-start (id)
  (let ((r (replica-new id)))
    (set *john-replica* r)
    r))
;; a answers from its child, z from here: each writes while apart, and each asks one question the other doesn't
(define listener (net-listen 0))
(define peer-a
  (net-spawn
   (lambda ()
     (let ((r (peer-start 'a)))
       (replica-write r "k" "from a")
       (replica-write r "only-a" 1)
       (replica-event r "P1 do reserve.")
       (replica-event r "P2 do reserve.")
       (replica-ask r "the shared question")
       (replica-ask r "the rival question")
       (let ((c (conn-new (net-accept (car listener)))))
	 (sync-serve r c)
	 (frame-send c (peer-results r))
	 (frame-recv c)			; z's closing word for this round
	 (net-close (car c)))
       ;; a second round: what each asked after the first now crosses
       (let ((c (conn-new (net-accept (car listener)))))
	 (sync-serve r c)
	 (frame-send c (peer-results r))
	 (frame-recv c)
	 (net-close (car c)))))))
(define z (peer-start 'z))
(replica-write z "k" "from z")
(replica-event z "P3 do reserve.")
(define z-rival (replica-ask z "the rival question"))
(check-that "z's question reached the model" (= 1 *llm-calls*))
(check-that "JSON escapes come back decoded" (text-find z-rival "\"" 0))
(define c (sync-client z (cdr listener)))
(define a-results (frame-recv c))
(define z-results (peer-results z))
(frame-send c (list 'done))
(net-close (car c))
(check-that "after one sync, the stores agree, concurrent writes kept" (and (equal (car a-results) (car z-results)) (text-find (car z-results) "from a" 0) (text-find (car z-results) "from z" 0)))
(check-that "after one sync, the same winners" (equal (cadr a-results) (cadr z-results)))
(check-that "both have the same answer to the shared question" (equal (cadddr a-results) (cadddr z-results)))
;; each then asked "open?" on its own, not having the other's answer: two calls, two answers, and John can disagree for now
(println "     John, a: " (caddr a-results))
(println "     John, z: " (caddr z-results))
(check-that "until the next sync, John's answers can differ: they're tentative" (not (equal (caddr a-results) (caddr z-results))))
(define c2 (sync-client z (cdr listener)))
(define a2 (frame-recv c2))
(define z2 (peer-results z))
(frame-send c2 (list 'done))
(net-close (car c2))
(println "     John after the second sync, a: " (caddr a2))
(println "     John after the second sync, z: " (caddr z2))
(check-that "after the second sync the stores agree" (equal (car a2) (car z2)))
(check-that "and so do the winners" (equal (cadr a2) (cadr z2)))
(check-that "and so does John, on an answer both now hold" (equal (caddr a2) (caddr z2)))
(check-that "the peer ended well" (= 0 (net-wait peer-a)))
(define hits (string->long (model-hits)))
(println "     calls that reached the model: " hits)
(check-that "concurrent asks each cost a call, and nothing was re-asked once held" (= 5 hits))
(check-that "z asked only its rival question and open?" (= 2 *llm-calls*))
(check-that "the rival question has one winner and keeps both answers" (= 2 (list-length (replica-values z (llm-key "the rival question")))))
(check-that "the model ended well" (= 0 (net-wait model-pid)))
(println "failures " failures)
(exit (if (= 0 failures) 0 1))
