;;; THROWAWAY SPIKE.  Laws for John over shared events.  Three replicas make reserve and cancel events on the airline, with random
;;; syncs.  Delivered in any order, one replica's answers must equal a fresh run of the events in canonical order, and a replay
;;; from the fork must agree with a replay from the start.  Mutations: running in application order, no clock advance on receive.
(require "spike/john-chain.l")
(define-function list-at (l n) (while (< 0 n) (set l (cdr l)) (set n (- n 1))) (car l))
(define *seed* 1)
(define-function rand (n)
  (set *seed* (& 2147483647 (+ 12345 (* *seed* 1103515245))))
  (% (>> *seed* 8) n))
(define-function shuffled (items)
  (let* ((n (list-length items)) (a (array n)) (i 0) (out ()))
    (list-do x items (set-array-at a i x) (set i (+ i 1)))
    (let ((j (- n 1)))
      (while (< 0 j)
	(let* ((k (rand (+ j 1))) (t (array-at a j)))
	  (set-array-at a j (array-at a k))
	  (set-array-at a k t))
	(set j (- j 1))))
    (for (j 0 n) (push out (array-at a j)))
    out))
(define program (john-read "check/john/airline.john"))
(define questions "P1 has-reservation. P2 has-reservation. P3 has-reservation. F booked.")
(define events '("P1 do reserve." "P2 do reserve." "P3 do reserve." "P1 do cancel." "P2 do cancel." "P3 do cancel."))
(define-function generate (steps)
  (let ((rs (list (replica-new 'a) (replica-new 'b) (replica-new 'c))) (ops ()))
    (for (i 0 steps)
      (let ((r (list-at rs (rand 3))))
	(if (< (rand 10) 6)
	    (push ops (replica-event r (list-at events (rand 6))))
	  (replica-sync-into (list-at rs (rand 3)) r))))
    ops))
(define-function fresh-answers (ops)		; the reference: the whole program, the events in canonical order, from the start
  (let ((sorted ()) (forms ()))
    (list-do op ops (set sorted (event-insert op sorted)))
    (list-do op sorted (set forms (concat-list forms (forms-of (op-value op)))))
    (john-run (concat-list program (concat-list forms (forms-of questions))))))
;; canonical order must respect what each event saw
(define-function causal-order? (ops)
  (let ((sorted ()) (seen ()) (ok 1))
    (list-do op ops (set sorted (event-insert op sorted)))
    (list-do op sorted
      (list-do d (op-deps op) (or (has-equal? d seen) (set ok ())))
      (push seen (op-id op)))
    ok))
(define *replayed-total* 0)  (define *arrivals-total* 0)
(define-function check-history (ops orders)	; the failing law's name, or ()
  (let ((failed ()) (expected (fresh-answers ops)) (replayed 0) (arrivals 0))
    (or (causal-order? ops) (set failed "the order breaks causality"))
    (for (o 0 orders)
      (or failed
	  (let* ((r (replica-new 'observer)) (c (chain-new r program)))
	    (list-do op (shuffled ops)
	      (replica-receive r op)
	      (chain-refresh c))
	    (set replayed (+ replayed (<chain>-replayed c)))
	    (set arrivals (+ arrivals (list-length ops)))
	    (or (equal (chain-ask c questions) expected) (set failed "answers differ from a fresh canonical run")))))
    (set *replayed-total* (+ *replayed-total* replayed))
    (set *arrivals-total* (+ *arrivals-total* arrivals))
    failed))
(define-function run-laws (label histories steps orders)
  (let ((bad 0) (first ()) (events-total 0))
    (set *replayed-total* 0) (set *arrivals-total* 0)
    (for (h 0 histories)
      (set *seed* (+ 2000 (* h 104729)))
      (let* ((ops (generate steps)) (f (and ops (check-history ops orders))))
	(set events-total (+ events-total (list-length ops)))
	(and f (let () (set bad (+ bad 1)) (or first (set first (concat-strings f " (history " (long->string h) ")")))))))
    (println label ": " (- histories bad) " of " histories " histories hold, " events-total " events; replayed "
	     *replayed-total* " steps over " *arrivals-total* " arrivals"
	     (if first (concat-string "; first failure: " first) ""))
    bad))
(define failures 0)
(define-function check-that (name ok) (println (if ok "ok   " "FAIL ") name) (or ok (set failures (+ failures 1))))
;; the table from the discussion, as events on replicas: two seats, three requests, P3's sorting first
(let* ((a (replica-new 'a)) (z (replica-new 'z))
       (e1 (replica-event a "P1 do reserve."))
       (e2 (replica-event a "P2 do reserve."))
       (e3 (replica-event z "P3 do reserve."))
       (r (replica-new 'observer)) (c (chain-new r program)))
  (replica-receive r e1) (replica-receive r e2)
  (chain-refresh c)
  (check-that "before the merge, P1 and P2 hold the seats" (equal '("yes" "yes" "no" "2") (chain-ask c questions)))
  (replica-receive r e3)
  (chain-refresh c)
  (check-that "merging P3 at clock 1 replays, and P2 loses its seat" (equal '("yes" "no" "yes" "2") (chain-ask c questions)))
  (check-that "the replay went back only as far as it had to" (= 4 (<chain>-replayed c))))
(define histories 12)  (define steps 16)  (define orders 3)
(check-that "the chain holds every law" (= 0 (run-laws "real" histories steps orders)))
(set *unsorted-chain* 1)
(check-that "caught: running in application order" (< 0 (run-laws "application order" histories steps orders)))
(set *unsorted-chain* ())
(set *no-clock-advance* 1)
(check-that "caught: no clock advance on receive" (< 0 (run-laws "no clock advance" histories steps orders)))
(set *no-clock-advance* ())
(println "failures " failures)
(exit (if (= 0 failures) 0 1))
