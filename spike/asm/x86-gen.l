;;; Compile each x86.spec row, while loading, into an encoder specialized to it:
;;; the row's tests and bytes become a lambda, so encoding no longer walks the row.
;;; Load after x86.l (or x86-pre.l); replaces its x86.

(define-function row-encoder (row)
  (let* ((size (row-size row)) (vars ()) (tests ()) (emit ()) (reg ()) (rm ()) (imm ()) (rel ()) (relsize 0) (len 0) (i 0))
    (list-do k (cadr row)
      (let* ((v (string->symbol (concat-string "a" (long->string i)))) (c (kind k)))
	(set vars (concat-list vars (list v)))
	(set tests (concat-list tests (list
	  (cond ((= 'r (car c))		`(and (symbol? ,v) (= ,(cadr c) (reg-size ,v))))
		((= 'rm (car c))	`(if (mem? ,v) (= ',(mem-tag (cadr c)) (car ,v)) (and (symbol? ,v) (= ,(cadr c) (reg-size ,v)))))
		((= 'm (car c))		`(mem? ,v))
		((= 'imm (car c))	`(and (long? ,v) (fits? ,v ,(cadr c) ,size)))
		((= 'rel (car c))	`(long? ,v))
		(else			`(= ',k ,v))))))
	(cond ((= 'r (car c))		(set reg v))
	      ((memq (car c) '(rm m))	(set rm v))
	      ((= 'imm (car c))		(set imm v))
	      ((= 'rel (car c))		(set rel v)))
	(set i (+ i 1))))
    (and (= size 2) (set emit (list '(_B X 0x66))) (set len 1))
    (list-do t (caddr row)
      (set emit (concat-list emit
	(cond ((long? t)		(set len (+ len 1)) `((_B X ,t)))
	      ((= t 'o32)		())
	      ((= t 'r)			`((list-do b (modrm (reg-num ,reg) ,rm) (_B X b))))
	      ((= (car t) '+r)		(set len (+ len 1)) `((_B X (| ,(cadr t) (reg-num ,reg)))))
	      ((= (car t) '/)		`((list-do b (modrm ,(cadr t) ,rm) (_B X b))))
	      ((memq t '(ib iw id))	(let ((n (cdr (assq t '((ib . 1) (iw . 2) (id . 4)))))) `((list-do b (le ,imm ,n) (_B X b)))))
	      (else			(set relsize (if (= t 'cb) 1 4)) `((list-do b (le d ,relsize) (_B X b))))))))
    (let ((body `(let () ,@emit 1)))
      (and rel (set body `(let ((d (- ,rel (+ (_PC X) ,(+ len relsize))))) (and (fits? d ,relsize 4) ,body))))
      (set body `(and ,@tests ,body))
      (eval `(lambda (X o)
	       (and (= ,(list-length vars) (list-length o))
		    (let ,(let ((bs ()) (j 0)) (list-do v vars (set bs (concat-list bs (list `(,v (car (list-tail o ,j)))))) (set j (+ j 1))) bs)
		      ,body)))))))

;; Rows by mnemonic, compiled: (mnemonic encoder...)
(define x86-encoders ())
(list-do row (list-reverse! (map (lambda (r) r) x86-rows))
  (let ((e (assq (car row) x86-encoders)) (f (row-encoder row)))
    (if e (set-cdr e (cons f (cdr e))) (set x86-encoders (cons (list (car row) f) x86-encoders)))))

(define-function x86 (X mnemonic . ops)
  (let ((fs (cdr (assq mnemonic x86-encoders))) (done ()))
    (while (and fs (not done))
      (set done ((car fs) X ops))
      (set fs (cdr fs)))
    (or done (error "no encoding for "mnemonic" "ops))))
