;;; For every row: encode sample operands, write them as A64 assembly for clang,
;;; and check that decoding our word re-encodes to the same word.

(define *spike* (next-argument))
(define word 0)
(define total 0)
(define n 0)
(define nb 0)
(define-function _B (X b)	(set word (| word (<< b (* 8 nb)))) (set nb (+ nb 1)))
(define-function _PC (X)	total)
(load (concat-string *spike* "/arm64.l"))

(define-function samples (row k pos)
  (let ((c (car k)))
    (cond
      ((= c 'reg)	(list (reg-sym (if (= 64 (reg-width (cadr k))) "X" "W") pos)
			      (reg-named (reg-width (cadr k)) 31 (caddr k))))
      ((= c 'imm)	(if (= 'imm0 (cadr k)) '(0)
			  (map (lambda (q) (* q (caddr k))) (list 7 (- (<< 1 (width-of row (cadr k))) 1)))))
      ((= c 'simm)	(map (lambda (q) (* q (caddr k))) (list -2 (- (<< 1 (- (width-of row (cadr k)) 1)) 1) (- (<< 1 (- (width-of row (cadr k)) 1))))))
      ((= c 'pcrel)	(map (lambda (d) (list 'rel d)) (list 8 -8 (* 4 (- (<< 1 (- (width-of row (cadr k)) 1)) 1)))))
      ((= c 'lsl)	'((LSL 0) (LSL 16) (LSL 48)))
      (else		(let ((out ()))
			  (list-do b (samples row (cadr k) 9) (list-do i (samples row (caddr k) 0) (set out (cons (list c b i) out))))
			  out)))))

(define-function product (ls)
  (if ls
      (let ((out ()))
	(list-do x (car ls) (list-do rest (product (cdr ls)) (set out (cons (cons x rest) out))))
	out)
    (list ())))

(define-function text (op)
  (cond
    ((symbol? op)		(symbol->string op))
    ((long? op)			(concat-string "#" (long->string op)))
    ((= 'LSL (car op))		(concat-string "LSL #" (long->string (cadr op))))
    ((= 'rel (car op))		(concat-strings "L" (long->string n) (if (< (cadr op) 0) " - " " + ") (long->string (if (< (cadr op) 0) (- 0 (cadr op)) (cadr op)))))
    ((= 'off (car op))		(concat-strings "[" (text (cadr op)) ", " (text (caddr op)) "]"))
    ((= 'pre (car op))		(concat-strings "[" (text (cadr op)) ", " (text (caddr op)) "]!"))
    ((= 'post (car op))		(concat-strings "[" (text (cadr op)) "], " (text (caddr op))))))

(define s (open (concat-string *spike* "/aclang.s") "w"))
(define o (open (concat-string *spike* "/aours.txt") "w"))
(define-function out (f . strs)	(list-do x strs (string-do c x (putc c f))))
(define fails 0)
(define aliased 0)
(list-do row a64-rows
  (let ((pos 0))
    (list-do sops (product (map (lambda (k) (set pos (+ pos 1)) (samples row k pos)) (cadr row)))
     (unless (and (= 'LDP (car row)) (= (car sops) (cadr sops)))	;; unpredictable: Rt == Rt2
      (let ((ops (map (lambda (x) (if (and (pair? x) (= 'rel (car x))) (+ total (cadr x)) x)) sops))
	    (line (symbol->string (car row))))
	(set word 0) (set nb 0)
	(apply a64 (cons 0 (cons (car row) ops)))
	(let ((first 1))
	  (list-do x sops (set line (concat-strings line (if first " " ", ") (text x))) (set first ())))
	(out s "L" (long->string n) ": " line "\n")
	(out o line "\t" (format "%08x" word) "\n")
	(let* ((w word) (back (a64-decode w total)))
	  (set word 0) (set nb 0)
	  (apply a64 (cons 0 back))
	  (cond ((!= w word)			(set fails (+ fails 1)) (println "ROUNDTRIP " line " -> " back))
		((not (equal back (cons (car row) ops)))	(set aliased (+ aliased 1)) (println "ALIAS " line " -> " back))))
	(set n (+ n 1))
	(set total (+ total 4)))))))
(close s) (close o)
(println n " instructions, " fails " round-trip failures, " aliased " decoded as an alias")
