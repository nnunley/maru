;;; THROWAWAY SPIKE.  HTTP to a model through a local Ollama server, which reaches its cloud models itself, so Maru needs no TLS.
;;; An answer isn't deterministic, so it enters the store as an operation, and is read from there ever after: replay and merge
;;; never ask again.  Concurrent asks keep both answers and read one winner, like any other key.
(require "spike/net.l")
(require "spike/ops.l")
(define net-setsockopt-timeout
  (lambda (fd seconds)
    (let ((tv (net-malloc 16)))
      (for (i 0 16) (set-byte-at tv i 0))
      (set-byte-at tv 0 (& 255 seconds))
      (set-byte-at tv 1 (& 255 (>> seconds 8)))
      (net-check "setsockopt" (net-setsockopt fd 65535 4102 tv 16)))))	; SOL_SOCKET, SO_RCVTIMEO on Darwin
;; JSON strings: enough to write a prompt and read a response
(define-function json-quote (text)
  (let ((parts (list "\"")) (run 0))
    (for (i 0 (string-length text))
      (let ((c (string-at text i)))
	(cond
	  ((= c 34) (push parts "\\\""))
	  ((= c 92) (push parts "\\\\"))
	  ((= c 10) (push parts "\\n"))
	  ((= c 13) (push parts "\\r"))
	  ((= c 9) (push parts "\\t"))
	  (else (let ((s (string 1))) (set-string-at s 0 c) (push parts s))))))
    (push parts "\"")
    (apply concat-strings (list-reverse! parts))))
(define-function hex-digit (c)
  (cond ((and (>= c 48) (<= c 57)) (- c 48)) ((and (>= c 97) (<= c 102)) (- c 87)) (else (- c 55))))
(define-function byte-text (c) (let ((s (string 1))) (set-string-at s 0 c) s))
(define-function utf8-text (u)
  (cond
    ((< u 128) (byte-text u))
    ((< u 2048) (concat-strings (byte-text (+ 192 (>> u 6))) (byte-text (+ 128 (& u 63)))))
    (else (concat-strings (byte-text (+ 224 (>> u 12))) (byte-text (+ 128 (& (>> u 6) 63))) (byte-text (+ 128 (& u 63)))))))
(define-function json-string-field (json name)	; the value of "name":"..." at the top of a flat object, or ()
  (let* ((key (concat-strings "\"" name "\":\"")) (at (text-find json key 0)))
    (and at
	 (let ((i (+ at (string-length key))) (parts ()) (done ()))
	   (while (not done)
	     (let ((c (string-at json i)))
	       (cond
		 ((= c 34) (set done 1))
		 ((= c 92)
		  (let ((e (string-at json (+ i 1))))
		    (cond
		      ((= e 110) (push parts "\n") (set i (+ i 2)))
		      ((= e 116) (push parts "\t") (set i (+ i 2)))
		      ((= e 114) (push parts "\r") (set i (+ i 2)))
		      ((= e 117)
		       (let ((u 0))
			 (for (k 2 6) (set u (+ (* u 16) (hex-digit (string-at json (+ i k))))))
			 (push parts (utf8-text u))
			 (set i (+ i 6))))
		      (else (push parts (byte-text e)) (set i (+ i 2))))))
		 (else (push parts (byte-text c)) (set i (+ i 1))))))
	   (apply concat-strings (list-reverse! parts))))))
(define-function string-from (s from to)
  (let ((out (string (- to from))))
    (for (i from to) (set-string-at out (- i from) (string-at s i)))
    out))
;; chunked transfer: a hex length, CRLF, that many bytes, CRLF, until a length of 0
(define-function http-unchunk (body)
  (let ((parts ()) (at 0) (done ()))
    (while (not done)
      (let ((n 0) (c (string-at body at)))
	(while (!= c 13)
	  (set n (+ (* n 16) (hex-digit c)))
	  (set at (+ at 1))
	  (set c (string-at body at)))
	(set at (+ at 2))
	(if (= n 0)
	    (set done 1)
	  (push parts (string-from body at (+ at n)))
	  (set at (+ at (+ n 2))))))
    (apply concat-strings (list-reverse! parts))))
(define *http-failure* ())
(define-function http-body (response)		; what follows the headers
  (let* ((at (text-find response "\r\n\r\n" 0))
	 (chunked (text-find response "Transfer-Encoding: chunked" 0)))
    (or at (error "http: no end of headers"))
    (if (not (text-find response " 200 " 0))
	(let () (set *http-failure* (string-from response 0 (or (text-find response "\r\n" 0) (min 80 (string-length response))))) ())
    (let ((body (string-from response (+ at 4) (string-length response))))
      (if (and chunked (< chunked at)) (http-unchunk body) body)))))
(define-function http-post (port path body)
  (let ((fd (net-connect port)))
    (net-setsockopt-timeout fd 180)
    (net-send fd (concat-strings "POST " path " HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\nContent-Type: application/json\r\nContent-Length: "
				 (long->string (string-length body)) "\r\n\r\n" body))
    (let ((response (net-recv-all fd)))
      (net-close fd)
      (http-body response))))
(define *llm-port* 11434)
(define *llm-model* "deepseek-v4.1-flash:cloud")
(define *llm-calls* 0)
(define-function llm-generate (prompt)
  (set *llm-calls* (+ *llm-calls* 1))
  (let* ((body (concat-strings "{\"model\":" (json-quote *llm-model*) ",\"prompt\":" (json-quote prompt) ",\"stream\":false}"))
	 (reply (http-post *llm-port* "/api/generate" body)))
    (and reply (json-string-field reply "response"))))
;; the store's copy first; only a question nobody has answered reaches the model
(define-function llm-key (prompt) (concat-string "ask:" prompt))
(define-function replica-ask (r prompt)
  (or (replica-read r (llm-key prompt))
      (let ((answer (llm-generate prompt)))	; a failed call isn't recorded, so the question can be asked again
	(and answer (replica-write r (llm-key prompt) answer))
	answer)))
