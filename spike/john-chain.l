;;; THROWAWAY SPIKE.  John over shared events.  Events are operations; a replica's chain is them sorted by (clock, actor), which
;;; every replica computes alike and no one votes on.  T - 1 is the parent world in that chain.  When an event sorts before
;;; what's already run, the chain goes back to the last world they share and replays from there: John's worlds keep their parent
;;; and action, so nothing else is undone.  One chain per process, since John's program is global.
(require "john-eval.l")
(require "spike/ops.l")
(define *unsorted-chain* ())		; a mutation: the order each replica happened to apply things
(define-structure <chain> (replica base applied replayed))	; applied: oldest first, (id . world after it)
(define-function chain-new (replica program)
  (let ((c (new <chain>)))
    (john-run program)
    (set (<chain>-replica c) replica)
    (set (<chain>-base c) *john-world*)
    (set (<chain>-replayed c) 0)
    c))
(define-function text-begins? (s prefix)
  (let ((ok (>= (string-length s) (string-length prefix))) (i 0))
    (while (and ok (< i (string-length prefix)))
      (or (= (string-at s i) (string-at prefix i)) (set ok ()))
      (set i (+ i 1)))
    ok))
(define-function event-key (id) (concat-strings "event/" (symbol->string (car id)) "/" (long->string (cadr id))))
(define-function event-op? (op) (let ((k (op-key op))) (and (string? k) (text-begins? k "event/"))))
(define-function replica-event (r text)		; an event never overwrites anything, so it has no preds
  (let* ((ctr (+ 1 (<replica>-clock r)))
	 (id (list (<replica>-id r) ctr))
	 (op (list (<replica>-id r) ctr (<replica>-heads r) (event-key id) text ())))
    (set (<replica>-clock r) ctr)
    (replica-apply r op)
    op))
(define-function event-before? (a b)
  (or (< (op-ctr a) (op-ctr b))
      (and (= (op-ctr a) (op-ctr b))
	   (< (string-compare (symbol->string (op-actor a)) (symbol->string (op-actor b))) 0))))
(define-function event-insert (x sorted)
  (if (or (not sorted) (event-before? x (car sorted)))
      (cons x sorted)
    (cons (car sorted) (event-insert x (cdr sorted)))))
(define-function chain-order (c)		; events in the order this chain runs them
  (let ((ops ()))
    (list-do op (<replica>-ops (<chain>-replica c)) (and (event-op? op) (push ops op)))
    (if *unsorted-chain*
	ops				; oldest applied first: <replica>-ops is newest first, and push reversed it
      (let ((sorted ()))
	(list-do op ops (set sorted (event-insert op sorted)))
	sorted))))
(define-function assoc-text (text alist)
  (let ((found ()))
    (list-do b alist (or found (and (equal (car b) text) (set found b))))
    found))
(define *forms-seen* ())
(define-function forms-of (text)
  (or (cdr (assoc-text text *forms-seen*))
      (let ((forms (john-read-text text)))
	(push *forms-seen* (cons text forms))
	forms)))
;; a qualification may read the store, so what's cached in a kept world can go stale when a merge changes the store
(define-function chain-forget-caches (c)
  (let ((w *john-world*))
    (while w
      (set (<john-world>-cache w) ())
      (set w (<john-world>-parent w)))))
(define-function chain-refresh (c)		; run what's new, going back as far as the order forces
  (let ((order (chain-order c)) (applied (<chain>-applied c)) (kept ()) (world (<chain>-base c)))
    (while (and order applied (equal (op-id (car order)) (caar applied)))
      (push kept (car applied))
      (set world (cdar applied))
      (set order (cdr order))
      (set applied (cdr applied)))
    (set *john-world* world)
    (chain-forget-caches c)
    (set kept (list-reverse! kept))
    (let ((fresh ()))
      (list-do op order
	(list-do s (forms-of (op-value op)) (john-statement s))
	(push fresh (cons (op-id op) *john-world*))
	(set (<chain>-replayed c) (+ 1 (<chain>-replayed c))))
      (set (<chain>-applied c) (concat-list kept (list-reverse! fresh))))))
(define-function chain-ask (c text)		; what John says to a statement, at the chain's current end
  (set *john-out* ())
  (list-do s (forms-of text) (john-statement s))
  (list-reverse! *john-out*))
