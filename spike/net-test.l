;;; THROWAWAY SPIKE: a forked child serves, the parent connects, in both directions, with a body bigger than the buffer.
(require "spike/net.l")
(define failures 0)
(define-function check-that (name ok) (println (if ok "ok   " "FAIL ") name) (or ok (set failures (+ failures 1))))
(define-function repeat-text (text n) (let ((s "")) (for (i 0 n) (set s (concat-string s text))) s))
(let* ((l (net-listen 0)) (port (cdr l))
       (big (repeat-text "0123456789abcdef" 1000))
       (pid (net-spawn (lambda ()
			 (let* ((c (net-accept (car l))) (got (net-recv-some c)))
			   (net-send c (concat-string "echo:" got))
			   (net-send c big)
			   (net-close c))))))
  (check-that "chose a port" (< 0 port))
  (net-close (car l))
  (let ((fd (net-connect port)))
    (net-send fd "hello\r\n")
    (let ((all (net-recv-all fd)))
      (check-that "a short message crosses, CRLF intact" (text-find all "echo:hello\r\n" 0))
      (check-that "16000 bytes arrive whole" (= (string-length all) (+ 12 16000)))
      (check-that "end of stream is ()" (not (net-recv-some fd))))
    (net-close fd))
  (check-that "the child ended well" (= 0 (net-wait pid))))
(let ((refused 0) (l (net-listen 0)))
  (net-close (car l))
  (check-that "a refused connection is an error, not a hang"
	      (= -1 (net-connect-c (net-tcp) (net-sockaddr (cdr l)) 16))))
(println "failures " failures)
(exit (if (= 0 failures) 0 1))
