;;; THROWAWAY SPIKE.  Laws for the replicated store over generated histories.  Histories come from three real replicas writing
;;; and syncing at random, so their deps and preds are true.  Each is delivered to a fresh replica in shuffled order, with
;;; duplicates.  The laws:
;;;   converges   any arrival order ends in the same store and the same winners
;;;   no gaps     after every delivery, the store equals the query over the causally closed part of what arrived
;;;   causal      a write made after seeing another for its key is what's read, whatever the tie-break
;;; Then each mutation is switched on, and the laws must fail.
(require "spike/ops.l")
(define-function list-at (l n) (while (< 0 n) (set l (cdr l)) (set n (- n 1))) (car l))
(define *seed* 1)
(define-function rand (n)
  (set *seed* (& 2147483647 (+ 12345 (* *seed* 1103515245))))
  (% (>> *seed* 8) n))
(define-function shuffled (items)
  (let* ((n (list-length items)) (a (array n)) (i 0) (out ()))
    (list-do x items (set-array-at a i x) (set i (+ i 1)))
    (let ((j (- n 1)))
      (while (< 0 j)
	(let* ((k (rand (+ j 1))) (t (array-at a j)))
	  (set-array-at a j (array-at a k))
	  (set-array-at a k t))
	(set j (- j 1))))
    (for (j 0 n) (push out (array-at a j)))
    out))
(define-function generate (steps)		; every op of a random history
  (let ((rs (list (replica-new 'a) (replica-new 'b) (replica-new 'c))) (keys '("k1" "k2" "k3")) (n 0) (ops ()))
    (for (i 0 steps)
      (let ((r (list-at rs (rand 3))))
	(if (< (rand 10) 6)
	    (let () (set n (+ n 1)) (push ops (replica-write r (list-at keys (rand 3)) n)))
	  (replica-sync-into (list-at rs (rand 3)) r))))
    ops))
;; the reference: what's causally closed in what arrived, by repeated filtering, sharing nothing with the queue
(define-function closed-part (arrived)
  (let ((in ()) (changed 1))
    (while changed
      (set changed ())
      (list-do op arrived
	(and (not (has-equal? (op-id op) (map op-id in)))
	     (let ((ok 1))
	       (list-do d (op-deps op) (or (has-equal? d (map op-id in)) (set ok ())))
	       (and ok (let () (push in op) (set changed 1)))))))
    in))
(define-function reference-state (ops)
  (let ((facts (dl-db-new)))
    (list-do op ops
      (dl-fact facts 'set (list (op-actor op) (op-ctr op) (op-key op) (op-value op)))
      (list-do p (op-preds op) (dl-fact facts 'pred (list (car p) (cadr p) (op-actor op) (op-ctr op)))))
    (dl-state-text (dl-run store-rules facts) 'store)))
(define-function check-history (ops orders)	; answers the name of the law that fails, or ()
  (let ((failed ()) (final-state ()) (final-winners ()) (complete (reference-state ops)))
    (for (o 0 orders)
      (let ((r (replica-new 'observer)) (arrived ()) (deliveries (shuffled (concat-list ops (list (car ops))))))
	(list-do op deliveries
	  (or failed
	      (let ()
		(replica-receive r op)
		(or (has-equal? op arrived) (push arrived op))
		(or (equal (replica-state r) (reference-state (closed-part arrived)))
		    (set failed "no gaps")))))
	(or failed
	    (let ((s (replica-state r)) (w (replica-winners r)))
	      (or (equal s complete) (set failed "converges: not the whole history"))
	      (if final-state
		  (or (and (equal s final-state) (equal w final-winners)) (set failed "converges: two orders differ"))
		(let () (set final-state s) (set final-winners w)))))))
    failed))
(define-function run-laws (label histories steps orders)	; answers the number of histories failing
  (let ((bad 0) (first ()) (total-ops 0) (cases 0))
    (for (h 0 histories)
      (set *seed* (+ 1000 (* h 7919)))
      (let* ((ops (generate steps)) (f (and ops (check-history ops orders))))
	(set total-ops (+ total-ops (list-length ops)))
	(set cases (+ cases 1))
	(and f (let () (set bad (+ bad 1)) (or first (set first (concat-strings f " (history " (long->string h) ")")))))))
    (println label ": " (- cases bad) " of " cases " histories hold, " total-ops " ops, " orders " orders each"
	     (if first (concat-string "; first failure: " first) ""))
    bad))
;; intent, by hand: what the two rules must mean.  A law over the rules can't see a wrong rule, since its reference runs them too.
(define failures 0)
(define *quiet* ())
(define *wrong* 0)
(define-function check-that (name ok)
  (or *quiet* (println (if ok "ok   " "FAIL ") name))
  (or ok (let () (set *wrong* (+ *wrong* 1)) (or *quiet* (set failures (+ failures 1))))))
(define-function intent ()
(let* ((a (replica-new 'a)) (b (replica-new 'b))
       (w1 (replica-write a "k" 1)))
  (replica-receive b w1)
  (let* ((w2 (replica-write a "k" 2)) (w3 (replica-write b "k" 3)))
    (check-that "a write overwrites what it saw" (equal '(2) (replica-values a "k")))
    (replica-receive a w3)
    (replica-receive b w2)
    (check-that "concurrent writes are both kept" (and (= 2 (list-length (replica-values a "k"))) (equal (replica-state a) (replica-state b))))
    (check-that "both replicas read the same winner" (equal (replica-read a "k") (replica-read b "k")))
    (let ((w4 (replica-write b "k" 4)))
      (replica-receive a w4)
      (check-that "a write that saw both resolves them" (and (equal '(4) (replica-values a "k")) (equal '(4) (replica-values b "k")))))))
;; the thesis's own example: w2 arrives before its dependency w1
(let* ((a (replica-new 'a)) (w1 (replica-write a "k" 1)) (w2 (replica-write a "k" 2)) (r (replica-new 'r)))
  (replica-receive r w2)
  (check-that "an operation waits for what it depends on" (= 0 (list-length (replica-values r "k"))))
  (replica-receive r w1)
  (check-that "and applies when that arrives" (equal '(2) (replica-values r "k"))))
;; causality beats the clock: a write that saw a higher-actor write still wins, with the clock advance removed
(let* ((a (replica-new 'a)) (z (replica-new 'z)) (wz (replica-write z "k" 26)))
  (set *no-clock-advance* 1)
  (replica-receive a wz)
  (let ((wa (replica-write a "k" 1)))
    (set *no-clock-advance* ())
    (replica-receive z wa)
    (check-that "the store's winner comes from what's overwritten, not the clock" (equal 1 (replica-read z "k")))))
  ;; two replicas writing at the same clock: one winner, by actor
  (let* ((a (replica-new 'a)) (b (replica-new 'b)) (wa (replica-write a "t" 1)) (wb (replica-write b "t" 2)))
    (replica-receive a wb)
    (check-that "a tie has one winner" (equal "\"t\" 2 \n" (replica-winners a)))))
(intent)
(define histories 25)  (define steps 30)  (define orders 4)
(define real (run-laws "real" histories steps orders))
(check-that "the real store holds every law" (= 0 real))
(define-form mutation (name flag)
  `(let ()
     (set ,flag 1)
     (let ((bad (run-laws ,name histories steps orders)))
       (set ,flag ())
       (check-that (concat-string "caught: " ,name) (< 0 bad)))))
(mutation "bypass the queue" *bypass-queue*)
(mutation "never drain the queue" *forget-drain*)

;; mutants of the rules themselves, which intent must catch
(define real-rules store-rules)
(define-function rule-without (head-name pred-test replacement)
  (let ((out ()))
    (list-do r real-rules (push out (if (pred-test r) replacement r)))
    (list-reverse! out)))
(define-form rule-mutant (name rules)
  `(let ()
     (set store-rules ,rules)
     (set *quiet* 1)  (set *wrong* 0)
     (intent)
     (set *quiet* ())
     (set store-rules real-rules)
     (check-that (concat-strings "caught: " ,name " (" (long->string *wrong*) " intent checks fail)") (< 0 *wrong*))))
(rule-mutant "store ignores what's overwritten"
	     (rule-without 'store (lambda (r) (= 'store (caar r))) '((store $k $v) (set $r $c $k $v))))
(rule-mutant "ties aren't broken"
	     (rule-without 'beaten (lambda (r) (equal r '((beaten $r $c) (leaf $k $r $c) (leaf $k $r2 $c) (> $r2 $r)))) '((beaten $r $c) (leaf $k $r $c) (leaf $k $r2 $c2) (> $c2 $c))))
(println "failures " failures)
(exit (if (= 0 failures) 0 1))
