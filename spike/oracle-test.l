;;; THROWAWAY SPIKE.  Oracles and published plans against a scripted model.  In the maze, a valid plan of 8 moves is what the real model
;;; first offered; the goal accepts it, and the oracles shouldn't.
(require "spike/john-plans.l")
(require "check/john-allocation.l")
(define *script* ())  (define *prompts* ())  (define *calls* 0)
(set llm-generate
     (lambda (prompt)
       (set *calls* (+ *calls* 1))
       (push *prompts* prompt)
       (if *script* (let ((a (car *script*))) (set *script* (cdr *script*)) a) "nothing left")))
(define failures 0)  (define *quiet* ())  (define *wrong* 0)
(define-function check-that (name ok)
  (or *quiet* (println (if ok "ok   " "FAIL ") name))
  (or ok (let () (set *wrong* (+ *wrong* 1)) (or *quiet* (set failures (+ failures 1))))))
(define-function has-text? (lines text) (let ((r ())) (list-do l lines (and (text-find l text 0) (set r 1))) r))
(define-function no-satisfy (fs) (let ((out ())) (list-do f fs (or (= 'satisfy (car f)) (push out f))) (list-reverse! out)))
(define-function fresh (script)
  (set *script* script) (set *prompts* ()) (set *calls* 0)
  (set *john-replica* (replica-new 'a)))
(define maze-text (contents-of-file-named "check/john/maze.john"))
(define long-way "R move B1\nR move B2\nR move A2\nR move A3\nR move A4\nR move B4\nR move C4\nR move D4")
(define short-way "R move B1\nR move B2\nR move C2\nR move C3\nR move C4\nR move D4")
(define-function maze (strategy more)
  (set *model-program-text* maze-text)
  (john-run (concat-list (no-satisfy (john-read-text maze-text))
	      (concat-list (john-read-text more)
		(john-read-text (concat-strings "goal-strategy Robot reach " strategy ". R satisfy reach."))))))
(model-strategy 'model-shortest-search (list (oracle-shortest-by-search)))
(model-strategy 'model-shortest-sat (list (oracle-shortest-by-sat)))
(model-strategy 'model-via-c3 (list (oracle-qualification 'went-by-c3)))
(define via "qualify Robot went-by-c3 if for some time T up to time do (at time T its position = C3).")
(define-function oracle-scenarios ()
  (fresh (list long-way))
  (check-that "with no oracle, the goal accepts the long way" (has-text? (maze "model" "") "satisfied at time: 8"))
  (fresh (list long-way short-way))
  (let ((out (maze "model-shortest-search" "")))
    (check-that "the search refuses the long way and says how short" (has-text? out "one of 6 moves exists and yours has 8"))
    (check-that "and the shortest is accepted" (has-text? out "satisfied at time: 6"))
    (check-that "the model is told" (text-find (car *prompts*) "one of 6 moves exists" 0)))
  (fresh (list long-way short-way))
  (let ((out (maze "model-shortest-sat" "")))
    (check-that "the solver refuses it too" (has-text? out "one of 6 moves exists and yours has 8"))
    (check-that "and accepts the shortest" (has-text? out "satisfied at time: 6")))
  ;; a condition on the path, which the goal, about the end state, can't ask
  (fresh (list long-way short-way))
  (let ((out (maze "model-via-c3" via)))
    (check-that "a John qualification refuses a path missing C3" (has-text? out "went-by-c3 doesn't hold"))
    (check-that "and accepts one through it" (has-text? out "satisfied at time: 6")))
  ;; an oracle that can't decide doesn't let a plan through
  (set *oracle-world-budget* 1)
  (fresh (list long-way))
  (let ((out (maze "model-shortest-search" "")))
    (check-that "undecided is refused" (and (has-text? out "couldn't tell") (not (has-text? out "satisfied")))))
  (set *oracle-world-budget* 50000))
;; ---- plans as events
(define hanoi-text (contents-of-file-named "check/john/hanoi2.john"))
(define hanoi-program (no-satisfy (john-read-text hanoi-text)))
(define solve "A move Peg2\nB move Peg3\nA move B")
(define state-q "A supporter. B supporter.")
(define *no-replan* ())
(define-function plan-scenarios ()
  (set *model-program-text* hanoi-text)
  (set *model-oracles* ())
  (let* ((a (replica-new 'a)) (z (replica-new 'z)))
    (set *john-replica* a)
    (set *script* (list solve "A move B")) (set *prompts* ()) (set *calls* 0)
    (let ((c (chain-new a hanoi-program)))
      (check-that "the owner's plan reaches the goal" (= 'holds (chain-pursue c 'Hanoi 'win () ())))
      (check-that "as three shared events" (let ((n 0)) (list-do op (<replica>-ops a) (and (event-op? op) (set n (+ n 1)))) (= 3 n)))
      ;; z, not having seen them, tries a move that fails and then moves A.  The recorded answer took a's clock 1, so its moves are
      ;; 2, 3 and 4, and z's second event, at clock 2, sorts just after A's move and takes the peg B was going to
      (let* ((first (replica-event z "B do move Peg3."))
	     (clash (replica-event z "A do move Peg3.")))
	(replica-receive a first)
	(replica-receive a clash)
	(chain-refresh c)
	(check-that "the merge leaves the goal untrue" (not (goal-holds? *john-world* 'Hanoi 'win ())))
	(check-that "and the plan's move that no longer fits is skipped, saying so" (has-text? *john-out* "can't"))
	(let ((before *calls*))
	  (if *no-replan*
	      ()
	    (check-that "the owner replans and reaches it" (= 'holds (chain-pursue c 'Hanoi 'win () ()))))
	  	  ;; the merge happens to land back on the start state: same state, same prompt, so the recorded answer serves
	  (check-that "a state seen before reads the recorded plan, with no call" (= before *calls*))
	  ;; now a merge to a state nobody has planned from: after the replan B is on Peg3 and A on B, and z lifts A off
	  (or *no-replan*
	      (let ()
		(set (<replica>-clock z) 12)
		(replica-receive a (replica-event z "A do move Peg2."))
		(chain-refresh c)
		(check-that "a later move undoes the goal again" (not (goal-holds? *john-world* 'Hanoi 'win ())))
		(check-that "and replanning from a new state" (= 'holds (chain-pursue c 'Hanoi 'win () ())))
		(check-that "asks once more" (= (+ before 1) *calls*))
		(check-that "showing the model that state" (text-find (car *prompts*) "A supporter = Peg2" 0))))))
      (let ((calls *calls*) (a-says (chain-ask c state-q)))
	;; z syncs and only reads: same order, same worlds, no model
	(replica-sync-into a z)
	(set *john-replica* z)
	(let ((zc (chain-new z hanoi-program)))
	  (chain-refresh zc)
	  (check-that "z reaches the same state" (equal a-says (chain-ask zc state-q)))
	  (check-that "z sees the goal hold" (goal-holds? *john-world* 'Hanoi 'win ()))
	  (check-that "z never asked the model" (= calls *calls*)))))))
(define-function scenarios () (oracle-scenarios) (plan-scenarios))
(scenarios)
;; slot by slot, the allocator's stronger check: refuses an assignment that overwrites, which the goal doesn't look at
(define-form mutant (name . body)
  `(let ()
     (set *quiet* 1) (set *wrong* 0)
     ,@body
     (set *quiet* ())
     (check-that (concat-strings "caught: " ,name " (" (long->string *wrong*) " checks fail)") (< 0 *wrong*))))
(mutant "the oracles not being asked"
	(let ((real oracles-refuse))
	  (set oracles-refuse (lambda (w start o g args using) ()))
	  (scenarios)
	  (set oracles-refuse real)))
(mutant "not replanning after a merge"
	(set *no-replan* 1)
	(plan-scenarios)
	(set *no-replan* ()))
(println "failures " failures)
(exit (if (= 0 failures) 0 1))
