;;; THROWAWAY SPIKE.  The model strategy against a scripted model, in process, so each kind of bad answer is certain to occur.
(require "spike/john-model.l")
(define *script* ())  (define *prompts* ())  (define *calls* 0)
(set llm-generate
     (lambda (prompt)
       (set *calls* (+ *calls* 1))
       (push *prompts* prompt)
       (if *script*
	   (let ((a (car *script*))) (set *script* (cdr *script*)) a)
	 "nothing left to say")))
(define failures 0)  (define *quiet* ())  (define *wrong* 0)
(define-function check-that (name ok)
  (or *quiet* (println (if ok "ok   " "FAIL ") name))
  (or ok (let () (set *wrong* (+ *wrong* 1)) (or *quiet* (set failures (+ failures 1))))))
(define-function has-text? (lines text) (let ((r ())) (list-do l lines (and (text-find l text 0) (set r 1))) r))
(define-function no-satisfy (fs) (let ((out ())) (list-do f fs (or (= 'satisfy (car f)) (push out f))) (list-reverse! out)))
(define source (contents-of-file-named "check/john/hanoi2.john"))
(set *model-program-text* source)
(define-function hanoi (strategy . more)	; runs Hanoi2 with this strategy, answering what John said
  (john-run (concat-list (no-satisfy (john-read-text source))
	      (concat-list (john-read-text (concat-strings "goal-strategy Towers win " strategy "."))
		(concat-list (john-read-text (if more (car more) ""))
			     (john-read-text "Hanoi satisfy win."))))))
(define-function fresh (script)
  (set *script* script) (set *prompts* ()) (set *calls* 0)
  (set *john-replica* (replica-new 'a)))
(define good "A move Peg2\nB move Peg3\nA move B")
(define-function scenarios ()
  (fresh (list good))
  (let ((out (hanoi "model")))
    (check-that "a good plan is believed once replayed" (has-text? out "satisfied at time: 3"))
    (check-that "and costs one call" (= 1 *calls*))
    (check-that "the prompt holds the program and the state" (and (text-find (car *prompts*) "rule Disk move" 0) (text-find (car *prompts*) "A supporter = B" 0))))
  (fresh (list (concat-strings "```\n1. A move Peg2.\n2. B move Peg3.\n- A move B,\n```")))
  (check-that "fences, numbering and punctuation are forgiven" (has-text? (hanoi "model") "satisfied at time: 3"))
  (fresh (list "Sure! Here is a plan." good))
  (let ((out (hanoi "model")))
    (check-that "prose is refused, and it tries again" (and (has-text? out "doesn't begin with an object") (has-text? out "satisfied at time: 3")))
    (check-that "and the refusal reaches the model" (text-find (car *prompts*) "It was refused: \"Sure!" 0)))
  (fresh (list "B move Peg3" good))
  (let ((out (hanoi "model")))
    (check-that "an illegal move is refused, by number" (has-text? out "move 1 (B move Peg3) isn't allowed")))
  (fresh (list "A move Peg2"))
  (let ((out (hanoi "model")))
    (check-that "a plan that doesn't reach the goal isn't believed" (not (has-text? out "satisfied")))
    (check-that "and the reason is given" (has-text? out "the goal doesn't hold")))
  (fresh (list "A move Hanoi"))
  (let ((out (hanoi "model")))
    (check-that "an argument of the wrong class is refused" (has-text? out "wrong kind of thing")))
  (fresh (list "A move"))
  (check-that "too few arguments are refused" (has-text? (hanoi "model") "takes 1 arguments"))
  (fresh (list "A fly Peg2"))
  (check-that "an action it doesn't have is refused" (has-text? (hanoi "model") "has no action fly"))
  (fresh (list (let ((s "")) (for (i 0 70) (set s (concat-string s "A move Peg2\n"))) s)))
  (check-that "an absurdly long plan is refused" (has-text? (hanoi "model") "longer than 64"))
  (fresh (list "load \"spike/evil.l\"" "Hanoi do win." "(exit 1)"))
  (let ((out (hanoi "model")))
    (check-that "code in a reply is only words: nothing ran, nothing changed"
		(and (not (member? "spike/evil.l" *loaded*)) (= 0 (<john-world>-time *john-world*)) (= 3 *calls*)))
    (check-that "and giving up isn't called unsatisfiable" (has-text? out "doesn't mean there is none")))
  ;; a service failure is a failed attempt, not recorded, and doesn't end the program
  (fresh (list () good))
  (let ((out (hanoi "model")))
    (check-that "a failed call is an attempt that failed" (and (has-text? out "the model service failed") (has-text? out "satisfied at time: 3")))
    (check-that "and isn't recorded" (= 1 (let ((n 0)) (list-do op (<replica>-ops *john-replica*) (set n (+ n 1))) n))))
  (fresh (list "junk" "junk" "junk"))
  (let ((out (hanoi "model-or-search")))
    (check-that "model-or-search falls back to the search" (and (has-text? out "so searching") (has-text? out "satisfied at time: 3"))))
  ;; a moved world: the plan must start from now, and an event before satisfy moved A already
  (fresh (list "B move Peg3\nA move B"))
  (let ((out (hanoi "model" "A do move Peg2.")))
    (check-that "the prompt shows the world as it is now" (text-find (car *prompts*) "A supporter = Peg2" 0))
    (check-that "and a plan from there is accepted" (has-text? out "satisfied at time: 3")))
  ;; replay: what was asked is read back, here and on a replica that synced, even a run that needed a retry
  (fresh (list "junk" good))
  (let* ((a *john-replica*) (first (hanoi "model")) (calls *calls*))
    (let ((again (hanoi "model")))
      (check-that "a rerun on the same replica asks nothing" (= calls *calls*))
      (check-that "and says the same" (equal first again)))
    (let ((b (replica-new 'b)))
      (replica-sync-into a b)
      (set *john-replica* b)
      (let ((there (hanoi "model")))
	(check-that "a replica that synced asks nothing" (= calls *calls*))
	(check-that "and says the same" (equal first there))))))
(scenarios)
(define-form mutation (name flag)
  `(let ()
     (set ,flag 1)  (set *quiet* 1)  (set *wrong* 0)
     (scenarios)
     (set *quiet* ())  (set ,flag ())
     (check-that (concat-strings "caught: " ,name " (" (long->string *wrong*) " checks fail)") (< 0 *wrong*))))
(mutation "not checking the goal" *skip-goal-check*)
(mutation "not giving the model the refusal" *no-feedback*)
(println "failures " failures)
(exit (if (= 0 failures) 0 1))
