;;; THROWAWAY SPIKE.  Naive bottom-up stratified Datalog, after Stewen, "Expressing CRDTs with Datalog".  A rule is
;;; ((head args...) atom...), an atom (pred args...), (not pred args...) or a comparison (> a b); a symbol starting $ is a
;;; variable.  Everything is recomputed from the facts on each query: no incremental evaluation, no join ordering.
(define-structure <dl-rel> (tuples buckets))
(define dl-bucket-count 512)
(define-function dl-rel-new ()
  (let ((r (new <dl-rel>)))
    (set (<dl-rel>-tuples r) ())
    (set (<dl-rel>-buckets r) (array dl-bucket-count))
    r))
(define-selector dl-hash (x) 7)
(define-method dl-hash <long> () (& self 1073741823))
(define-function dl-text-hash (s)
  (let ((h 17))
    (for (i 0 (string-length s)) (set h (& 1073741823 (+ (* h 31) (string-at s i)))))
    h))
(define-method dl-hash <string> () (dl-text-hash self))
(define-method dl-hash <symbol> () (dl-text-hash (symbol->string self)))
(define-function dl-tuple-hash (tuple)
  (let ((h 3))
    (list-do x tuple (set h (& 1073741823 (+ (* h 131) (dl-hash x)))))
    (% h dl-bucket-count)))
(define-function dl-has? (rel tuple)
  (let ((found ()))
    (list-do t (array-at (<dl-rel>-buckets rel) (dl-tuple-hash tuple))
      (or found (and (equal t tuple) (set found 1))))
    found))
(define-function dl-add (rel tuple)		; answers true if it was new
  (and (not (dl-has? rel tuple))
       (let ((h (dl-tuple-hash tuple)) (b (<dl-rel>-buckets rel)))
	 (set-array-at b h (cons tuple (array-at b h)))
	 (set (<dl-rel>-tuples rel) (cons tuple (<dl-rel>-tuples rel)))
	 1)))
;; a database is an association from predicate to relation
(define-function dl-rel-of (db pred)
  (or (cdr (assq pred (cdr db)))
      (let ((r (dl-rel-new)))
	(set (cdr db) (cons (cons pred r) (cdr db)))
	r)))
(define-function dl-db-new () (cons 'db ()))
(define-function dl-fact (db pred tuple) (dl-add (dl-rel-of db pred) tuple))
(define-function dl-tuples (db pred) (<dl-rel>-tuples (dl-rel-of db pred)))

;; boot.l's member? compares by identity; ids and ops are fresh lists
(define-function has-equal? (x items)
  (let ((found ()))
    (list-do i items (or found (and (equal i x) (set found 1))))
    found))
(define-function dl-var? (x) (and (symbol? x) (= 36 (string-at (symbol->string x) 0))))
(define-function dl-negative? (atom) (= 'not (car atom)))
;; numbers by value, names by their text: replica ids are names, and ties compare them
(define-function dl-greater? (a b)
  (if (long? a) (> a b) (> (string-compare (symbol->string a) (symbol->string b)) 0)))
(define dl-comparisons (list (cons '> dl-greater?) (cons '!= (lambda (a b) (not (equal a b))))))
(define-function dl-comparison? (atom) (assq (car atom) dl-comparisons))
(define-function dl-value (x s)
  (if (dl-var? x)
      (let ((b (assq x s)))
	(if b (cdr b) (error "E_UNSAFE: " x " is not bound by a positive atom")))
    x))
(define-function dl-ground (args s) (map (lambda (a) (dl-value a s)) args))
;; extends s so that args match tuple, or answers -1 (s may be empty, which is ())
(define-function dl-match (args tuple s)
  (while (and args (!= s -1))
    (let ((a (car args)) (v (car tuple)))
      (if (dl-var? a)
	  (let ((b (assq a s)))
	    (if b
		(or (equal (cdr b) v) (set s -1))
	      (set s (cons (cons a v) s))))
	(or (equal a v) (set s -1))))
    (set args (cdr args))
    (set tuple (cdr tuple)))
  s)
;; positive atoms first, so that negation and comparison only ever see bound variables
(define-function dl-ordered (body)
  (let ((pos ()) (rest ()))
    (list-do a body (if (or (dl-negative? a) (dl-comparison? a)) (push rest a) (push pos a)))
    (concat-list (list-reverse! pos) (list-reverse! rest))))
(define-function dl-solve (db body s k)
  (if (not body)
      (k s)
    (let ((atom (car body)) (more (cdr body)))
      (cond
	((dl-negative? atom)
	 (or (dl-has? (dl-rel-of db (cadr atom)) (dl-ground (cddr atom) s)) (dl-solve db more s k)))
	((dl-comparison? atom)
	 (and ((cdr (assq (car atom) dl-comparisons)) (dl-value (cadr atom) s) (dl-value (caddr atom) s))
	      (dl-solve db more s k)))
	(else
	 (list-do t (dl-tuples db (car atom))
	   (let ((s2 (dl-match (cdr atom) t s)))
	     (or (= s2 -1) (dl-solve db more s2 k)))))))))
;; strata: a head is at least as high as what it reads, and above what it negates; a cycle through negation never settles
(define-function dl-stratify (rules)
  (let ((levels ()) (changed 1) (passes 0) (limit (+ 2 (list-length rules))))
    (let ((level-of (lambda (p) (or (cdr (assq p levels)) 0)))
	  (raise (lambda (p n)
		   (let ((b (assq p levels)))
		     (if b
			 (and (< (cdr b) n) (let () (set (cdr b) n) (set changed 1)))
		       (let () (push levels (cons p n)) (set changed 1)))))))
      (list-do r rules (raise (caar r) 0))
      (while changed
	(set changed ())
	(set passes (+ passes 1))
	(and (> passes limit) (error "E_UNSTRATIFIED: a rule depends on its own negation"))
	(list-do r rules
	  (list-do a (cdr r)
	    (cond
	      ((dl-negative? a) (raise (caar r) (+ 1 (level-of (cadr a)))))
	      ((dl-comparison? a) ())
	      (else (raise (caar r) (level-of (car a))))))))
      levels)))
(define-function dl-run (rules facts)		; a new database holding the facts and what the rules derive from them
  (let ((db (dl-db-new)) (levels (dl-stratify rules)) (top 0))
    (list-do f (cdr facts) (list-do t (<dl-rel>-tuples (cdr f)) (dl-fact db (car f) t)))
    (list-do l levels (and (> (cdr l) top) (set top (cdr l))))
    (for (level 0 (+ top 1))
      (let ((these ()) (changed 1))
	(list-do r rules (and (= level (cdr (assq (caar r) levels))) (push these (cons (car r) (dl-ordered (cdr r))))))
	(while changed
	  (set changed ())
	  (list-do r these
	    (let ((rel (dl-rel-of db (caar r))) (head (cdar r)))
	      (dl-solve db (cdr r) ()
			(lambda (s) (and (dl-add rel (dl-ground head s)) (set changed 1)))))))))
    db))
;; for comparing states: every tuple as text, sorted
(define-selector dl-text (x) (concat-string "?" (long->string 0)))
(define-method dl-text <long> () (long->string self))
(define-method dl-text <string> () (concat-strings "\"" self "\""))
(define-method dl-text <symbol> () (symbol->string self))
(define-function dl-tuple-text (t)
  (let ((s ""))
    (list-do x t (set s (concat-strings s (dl-text x) " ")))
    s))
(define-function text-insert (x sorted)
  (if (or (not sorted) (<= (string-compare x (car sorted)) 0))
      (cons x sorted)
    (let ((head ()) (rest sorted))
      (while (and rest (> (string-compare x (car rest)) 0))
	(push head (car rest))
	(set rest (cdr rest)))
      (let ((out (cons x rest)))
	(list-do h head (set out (cons h out)))
	out))))
(define-function dl-state-text (db pred)
  (let ((sorted ()) (out ""))
    (list-do t (dl-tuples db pred) (set sorted (text-insert (dl-tuple-text t) sorted)))
    (list-do l sorted (set out (concat-strings out l "\n")))
    out))
