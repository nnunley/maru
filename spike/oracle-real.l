;; publish a plan, merge a clash, replan
(define text (contents-of-file-named "check/john/hanoi2.john"))
(define program (no-satisfy (john-read-text text)))
(set *model-program-text* text)
(set *model-oracles* ())
(set *llm-calls* 0)
(define a (replica-new 'a))  (define z (replica-new 'z))
(set *john-replica* a)
(define c (chain-new a program))
(define t0 (now))
(println "--- a published plan")
(println "  owner: " (chain-pursue c 'Hanoi 'win () ()) " after " *llm-calls* " call; " (chain-ask c "A supporter. B supporter."))
(set (<replica>-clock z) 12)
(replica-receive a (replica-event z "A do move Peg2."))
(chain-refresh c)
(println "  after z's concurrent move: goal holds? " (goal-holds? *john-world* 'Hanoi 'win ()) " " (chain-ask c "A supporter. B supporter."))
(println "  owner: " (chain-pursue c 'Hanoi 'win () ()) " after " *llm-calls* " calls; " (chain-ask c "A supporter. B supporter."))
(define calls *llm-calls*)
(replica-sync-into a z)
(set *john-replica* z)
(define zc (chain-new z program))
(chain-refresh zc)
(println "  z, which only synced: " (chain-ask zc "A supporter. B supporter.") ", new calls " (- *llm-calls* calls))
(println "  every event: ")
(list-do x (chain-order zc) (println "    " (op-ctr x) " " (op-actor x) " " (op-value x)))
