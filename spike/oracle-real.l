;;; THROWAWAY SPIKE.  The real model against stronger oracles, and a published plan replanned after a merge.  Public puzzles only.
(require "spike/john-plans.l")
(require "check/john-allocation.l")
(define-function no-satisfy (fs) (let ((out ())) (list-do f fs (or (= 'satisfy (car f)) (push out f))) (list-reverse! out)))
(define now (let ((b ((subr "malloc" "l>p") 16)) (clock (subr "gettimeofday" "pp>i")))
  (lambda () (clock b 0) (+ (byte-at b 0) (+ (<< (byte-at b 1) 8) (+ (<< (byte-at b 2) 16) (<< (byte-at b 3) 24)))))))
(define-function show (label t0 out)
  (println "--- " label ": " *llm-calls* " calls, " (- (now) t0) " s")
  (list-do l out (println "  " (if (> (string-length l) 300) (concat-string (string-from l 0 300) "...") l))))
(define-function run-one (label text class goal object strategy extra)
  (set *model-program-text* (concat-strings text "\n" extra))
  (set *john-replica* (replica-new 'a))
  (set *llm-calls* 0)
  (let* ((t0 (now))
	 (out (john-run (concat-list (no-satisfy (john-read-text text))
			  (concat-list (john-read-text extra)
			    (john-read-text (concat-strings "goal-strategy " class " " goal " " strategy ". " object " satisfy " goal ".")))))))
    (show label t0 out)))
(model-strategy 'model-shortest (list (oracle-shortest-by-sat)))
(model-strategy 'model-via-b3 (list (oracle-qualification 'went-by-b3)))
(model-strategy 'model-fits (list (oracle-world-check "the slot-by-slot check" john-allocation-fits?)))
(define maze (contents-of-file-named "check/john/maze.john"))
