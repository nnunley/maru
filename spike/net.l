;;; THROWAWAY SPIKE.  TCP on 127.0.0.1 through subr, on macOS: socket, bind, connect and so on, a sockaddr_in laid out by
;;; hand as jobs.l lays out a rusage.  No getaddrinfo, no TLS, no Linux (whose sockaddr has no sin_len).
(define net-fork	(subr "fork" ">i"))
(define net-exit	(subr "_exit" "i"))
(define net-waitpid	(subr "waitpid" "ipi>i"))
(define net-socket-c	(subr "socket" "iii>i"))
(define net-bind-c	(subr "bind" "ipi>i"))
(define net-listen-c	(subr "listen" "ii>i"))
(define net-accept-c	(subr "accept" "ipp>i"))
(define net-connect-c	(subr "connect" "ipi>i"))
(define net-setsockopt	(subr "setsockopt" "iiipi>i"))
(define net-getsockname	(subr "getsockname" "ipp>i"))
(define net-write-c	(subr "write" "ipl>l"))
(define net-read-c	(subr "read" "ipl>l"))
(define net-close	(subr "close" "i>i"))
(define net-malloc	(subr "malloc" "l>p"))
(define net-buffer-size 4096)
(define net-buffer (net-malloc net-buffer-size))
(define net-word (net-malloc 8))
(define net-address (net-malloc 16))

(define-function net-check (what r) (if (< r 0) (error "net: " what " failed") r))
(define-function net-sockaddr (port)		; Darwin's sockaddr_in: length, family, port big-endian, address, 8 zeros
  (for (i 0 16) (set-byte-at net-address i 0))
  (set-byte-at net-address 0 16)
  (set-byte-at net-address 1 2)
  (set-byte-at net-address 2 (& 255 (>> port 8)))
  (set-byte-at net-address 3 (& 255 port))
  (set-byte-at net-address 4 127)
  (set-byte-at net-address 7 1)
  net-address)
(define-function net-tcp () (net-check "socket" (net-socket-c 2 1 0)))	; AF_INET, SOCK_STREAM
(define-function net-listen (port)		; answers (fd . port); port 0 lets the system choose
  (let ((fd (net-tcp)))
    (set-byte-at net-word 0 1) (set-byte-at net-word 1 0) (set-byte-at net-word 2 0) (set-byte-at net-word 3 0)
    (net-check "setsockopt" (net-setsockopt fd 65535 4 net-word 4))	; SOL_SOCKET, SO_REUSEADDR on Darwin
    (net-check "bind" (net-bind-c fd (net-sockaddr port) 16))
    (net-check "listen" (net-listen-c fd 8))
    (set-byte-at net-word 0 16) (set-byte-at net-word 1 0) (set-byte-at net-word 2 0) (set-byte-at net-word 3 0)
    (net-check "getsockname" (net-getsockname fd net-address net-word))
    (cons fd (+ (<< (byte-at net-address 2) 8) (byte-at net-address 3)))))
(define-function net-accept (fd) (net-check "accept" (net-accept-c fd 0 0)))
(define-function net-connect (port)
  (let ((fd (net-tcp)))
    (net-check "connect" (net-connect-c fd (net-sockaddr port) 16))
    fd))
;; strings go through a C buffer byte by byte: enough for a spike
(define-function net-send (fd text)
  (let ((n (string-length text)) (at 0))
    (while (< at n)
      (let ((count (min net-buffer-size (- n at))))
	(for (i 0 count) (set-byte-at net-buffer i (string-at text (+ at i))))
	(let ((sent 0))
	  (while (< sent count)
	    (let ((r (net-check "write" (net-write-c fd (+ net-buffer sent) (- count sent)))))
	      (set sent (+ sent r)))))
	(set at (+ at count))))))
(define-function net-chunk (count)
  (let ((s (string count)))
    (for (i 0 count) (set-string-at s i (byte-at net-buffer i)))
    s))
(define-function net-recv-some (fd)		; the next bytes, or () at end of stream
  (let ((r (net-check "read" (net-read-c fd net-buffer net-buffer-size))))
    (and (< 0 r) (net-chunk r))))
(define-function net-recv-all (fd)		; to end of stream
  (let ((parts ()) (part (net-recv-some fd)))
    (while part
      (push parts part)
      (set part (net-recv-some fd)))
    (apply concat-strings (list-reverse! parts))))
;; the index of text in s at or after from, or ()
(define-function text-find (s text from)
  (let ((n (string-length text)) (limit (string-length s)) (found ()) (i from))
    (while (and (not found) (<= (+ i n) limit))
      (let ((j 0))
	(while (and (< j n) (= (string-at s (+ i j)) (string-at text j))) (set j (+ j 1)))
	(if (= j n) (set found i) (set i (+ i 1)))))
    found))
(define-function net-spawn (thunk)		; a child running thunk; answers its pid
  (let ((pid (net-fork)))
    (if (= 0 pid) (let () (thunk) (net-exit 0)) pid)))
(define net-status (net-malloc 8))
(define-function net-wait (pid)			; answers the child's exit status
  (net-waitpid pid net-status 0)
  (+ (byte-at net-status 0) (<< (byte-at net-status 1) 8)))
