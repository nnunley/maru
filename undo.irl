// undo.irl -- the logic of the undo log behind worlds (recover.l's try; Warth's worlds, 3.1).  While a world is open,
// each write through a primitive records what it overwrites, and dropping the world replays the log backwards.  undo.c
// holds what depends on an evaluator's objects and collector: a record's parts, making one, and putting a value back.
// make undo-irl.c regenerates the C every evaluator includes; the undo_irl check says when it's stale.
//
// As in Warth's worlds, a world keeps one record per slot however often it's written: rollback needs only the value from
// before the first write.  A commit hands the parent the records it doesn't already have, and drops the rest.

import void*(long, long) undo_calloc;
import void*(void*, long) undo_realloc;
import void(void*) undo_free;
import void(char*) undo_fatal;
import void*(void*) undo_head;
import void*(void*) undo_tail;
import void(void*, void*) undo_set_tail;
import long(void*) undo_kind;			// of a record, (object kind index . old)
import long(void*) undo_index;
import void(void*) undo_replay;			// puts a record's old value back

void* undo_log := 0;		// the records, newest first: a Maru list the evaluator roots
long undo_depth := 0;		// how many worlds are open
long undo_paused := 0;		// while above 0, writes aren't recorded

// Which slots each open world has a record for: (object, kind, index, world) in an open-addressed table.  A world's
// number is never reused, so an entry for a world no longer open is simply dead: it's ignored, and growing drops it.
// An open world's entry is backed by a record, which keeps its object alive, so a dead object's address can't match.
struct UndoSlot { long object, index, world, kind, depth; };
struct UndoSlot* undo_slots := 0;
long undo_slots_size := 0;
long undo_slots_used := 0;
long* undo_worlds := 0;		// the number of the open world at each depth
long undo_worlds_max := 0;
long undo_last_world := 0;		// worlds are numbered from 1, never reused

long undo_slot_live(struct UndoSlot* s, long at) return cast(s[at].world != 0 && s[at].depth <= undo_depth && undo_worlds[s[at].depth] == s[at].world, long);

// the slot's place, or -1 with a free place in spot[0]
long undo_slot_find(long object, long kind, long index, long world, long* spot) {
  let long mask := undo_slots_size - 1;
  let long at := ((object >> 3) * 31 + kind * 7 + index * 131 + world * 2654435761) & mask;
  spot[0] := -1;
  while 1 do {
    if undo_slots[at].world == 0 then { if spot[0] < 0 then spot[0] := at; return -1; }
    if undo_slots[at].world == world && undo_slots[at].object == object && undo_slots[at].kind == kind && undo_slots[at].index == index
    then return at;
    if spot[0] < 0 && !undo_slot_live(undo_slots, at) then spot[0] := at;
    at := (at + 1) & mask;
  }
  return -1;
}

void undo_slots_grow() {
  let struct UndoSlot* old := undo_slots;
  let long n := undo_slots_size;
  let long count := 0;
  let long j := 0;
  while j < n do { if undo_slot_live(old, j) then count := count + 1; j := j + 1; }
  let long size := n == 0 ? 1024 : n;
  while count * 4 >= size do size := size * 2;
  undo_slots := cast(undo_calloc(size, cast(sizeof(struct UndoSlot), long)), struct UndoSlot*);
  if undo_slots == 0 then undo_fatal("out of memory for the undo log");
  undo_slots_size := size;
  undo_slots_used := 0;
  let long spot := 0;
  j := 0;
  while j < n do {
    if undo_slot_live(old, j) then {
      undo_slot_find(old[j].object, old[j].kind, old[j].index, old[j].world, &spot);
      undo_slots[spot] := old[j];
      undo_slots_used := undo_slots_used + 1;
    }
    j := j + 1;
  }
  if old != 0 then undo_free(old);
}

// notes that the world at depth d has a record of this slot; 1 if it's the first
long undo_slot_add(void* object, long kind, long index, long d) {
  let long o := cast(object, long);
  let long world := undo_worlds[d];
  let long spot := 0;
  if (undo_slots_used + 1) * 4 >= undo_slots_size * 3 then undo_slots_grow();
  if undo_slot_find(o, kind, index, world, &spot) >= 0 then return 0;
  if undo_slots[spot].world == 0 then undo_slots_used := undo_slots_used + 1;
  undo_slots[spot].object := o; undo_slots[spot].kind := kind; undo_slots[spot].index := index;
  undo_slots[spot].world := world; undo_slots[spot].depth := d;
  return 1;
}

// whether a write to this slot needs recording now: a world is open, recording isn't paused, and it's the first
long undo_first(void* object, long kind, long index)
  return cast(undo_depth != 0 && undo_paused == 0 && undo_slot_add(object, kind, index, undo_depth) != 0, long);

// a world is the log as it stood when it began
void* undo_begin() {
  undo_depth := undo_depth + 1;
  if undo_depth >= undo_worlds_max then {
    undo_worlds_max := undo_worlds_max == 0 ? 64 : undo_worlds_max * 2;
    undo_worlds := cast(undo_realloc(undo_worlds, undo_worlds_max * cast(sizeof(long), long)), long*);
    if undo_worlds == 0 then undo_fatal("out of memory for the undo log");
  }
  undo_last_world := undo_last_world + 1;
  undo_worlds[undo_depth] := undo_last_world;
  return undo_log;
}

// a world's writes stay.  An enclosing world can still drop them, so it takes the records it doesn't already have
void undo_commit(void* mark) {
  if undo_depth == 1 then undo_log := 0;
  else {
    let void* l := undo_log;
    let void* previous := 0;
    while l != mark && l != 0 do {
      let void* entry := undo_head(l);
      if undo_slot_add(undo_head(entry), undo_kind(entry), undo_index(entry), undo_depth - 1) != 0 then previous := l;
      else if previous == 0 then undo_log := undo_tail(l);
      else undo_set_tail(previous, undo_tail(l));
      l := undo_tail(l);
    }
  }
  undo_depth := undo_depth - 1;
}

void undo_rollback(void* mark) {
  while undo_log != mark && undo_log != 0 do {
    undo_replay(undo_head(undo_log));
    undo_log := undo_tail(undo_log);
  }
  undo_depth := undo_depth - 1;
  undo_paused := 0;
}

// a fresh object has nothing to undo, and whatever a failing world makes to report it must outlast the world
void undo_pause() undo_paused := undo_paused + 1;
void undo_resume() undo_paused := undo_paused - 1;

// for the laws: how many records the log holds
long undo_log_size() {
  let long n := 0;
  let void* l := undo_log;
  while l != 0 do { n := n + 1; l := undo_tail(l); }
  return n;
}

export undo_first, undo_begin, undo_commit, undo_rollback, undo_pause, undo_resume, undo_log_size;
