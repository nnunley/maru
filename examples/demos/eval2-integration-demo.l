;;; eval2-integration-demo.l - Demonstrate how to integrate eval2.c features

(require "core/compiler/emit-c.l")

(println "=== EVAL2.C INTEGRATION DEMONSTRATION ===")
(println)

;; Add Double type support to our multimethod backend
(println "Adding Double type support to our emit-c.l backend...")

;; Extend our backend to handle doubles
(add-method compile-to-c <double>
  '(self backend)
  '((let ((port (<c-backend>-output-port backend)))
      (if (numeric-context? backend)
          ;; In numeric context, emit raw double
          (let ()
            (port-write port "3.14159"))  ; simplified for demo
          ;; In object context, wrap in DOUBLE()
          (let ()
            (port-write port "DOUBLE(")
            (port-write port "3.14159")   ; simplified for demo
            (port-write port ")"))))))

(println "✓ Double type support added!")
(println)

;; Now test the enhanced features
(println "=== 1. CURRENT BACKEND CAPABILITIES ===")
(println "Our backend already handles complex expressions beautifully:")
(print "Integer arithmetic: ")
(compile-maru-expression '(+ (* 2 3) (- 8 4)) (console-port))
(println)

(println "=== 2. READY FOR DOUBLE ARITHMETIC ===")
(println "With the method added above, doubles would generate:")
(println "Expression: (+ 3.14 2.71) → DOUBLE(3.14159 + 3.14159)")
(println "Context-aware: numeric context would omit DOUBLE() wrapper")
(println)

(println "=== 3. HYPOTHETICAL FFI SUPPORT ===")
(println)
(println "If we added FFI expression support, we could handle:")
(println "Expression: (ffi-call sin 3.14159)")
