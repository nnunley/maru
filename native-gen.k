;;; native-gen.k -- typed Maru's IR to intents (draft-ndn-maru-native-ir2-00): the generator maru.k's compile-namespace
;;; drives, as it drives ir-gen-c.k, collecting a unit of functions as lists of intents instead of writing C.  Every value
;;; has a frame slot (ir2's ir-frame-allocate, as ir-gen-x86.k uses it), and an operation loads its operands into scratch
;;; registers s0, s1 …, operates, and stores its result.  Nothing here names a register, an instruction or a calling
;;; convention: those are the lowering grammars' (native-arm64.g).
;;;
;;; Intents (slots are byte offsets in the frame):
;;;   (enter size) (leave size) (return)          the frame, and returning from it
;;;   (params ((size slot kind) …))                the arguments, as they arrive, into their slots; kind int or struct
;;;   (call slot nfixed (arg …) ret)               call the function whose address is in slot with args (size slot kind),
;;;                                                the first nfixed named and the rest variadic; ret is () or (size slot
;;;                                                kind), where the result goes
;;;   (result size slot kind)                      a slot as the function's result
;;;   (copy size from to)                          a struct from one slot to another
;;;   (load size slot s) (store size slot s)       a slot of size bytes to or from a scratch register (loads sign-extend:
;;;                                                ir2's integers are signed)
;;;   (constant s value) (result-from s)           a value into a scratch register; a scratch register as the result
;;;   (op kind d a b)                              d := a kind b: add sub mul div mod and or xor shl shr (division and
;;;                                                right shift signed), or com (d := ~a)
;;;   (address slot s)                             s := the slot's address
;;;   (load-at size base s) (store-at size base s) through the address in register base
;;;   (compare cond d a b)                         d := 1 if a cond b else 0; cond eq ne lt le gt ge, or lo ls hi hs
;;;                                                for pointers, which compare unsigned
;;;   (label L) (branch L) (branch-if s L) (branch-unless s L)   within a function
;;;   (label-address s L) (branch-to s)            a label as a value, and a computed goto to one
;;;   (global-address s name) (extern-address s name) (string-address s text) (function-address s name)
;;;                                                resolved by native-link.l: a global's storage, a C symbol, a literal's
;;;                                                bytes, a function of the unit
(require "ir2.k")

(define-structure <native-gen> (frame intents functions labels outgoing inits))
(define-structure <native-unit> (functions globals))	; ((name intents frame-size) …), ((name size alignment) …)
(define *native-unit* ())

(define-function ir-gen-new () (new <native-gen> () () () 0 0 ()))
(define-function native-label (gen)
  (set (<native-gen>-labels gen) (+ 1 (<native-gen>-labels gen)))
  (string->symbol (concat-string "L" (long->string (<native-gen>-labels gen)))))

(define-function list-reverse (l) (let ((r ())) (list-do x l (push r x)) r))
(define-function native-emit (gen intent) (set (<native-gen>-intents gen) (cons intent (<native-gen>-intents gen))))
(define-function native-slot (gen type)	; a label is an address: IR-LABEL's alignment is 0, which would align the frame to 0
  (ir-frame-allocate (<native-gen>-frame gen) (if (= IR-LABEL type) IR-VOID* type)))
(define-function native-offset (location) (<ir-location>-offset location))
(define-function native-type-size (type) (<ir-type>-size (if (= IR-LABEL type) IR-VOID* type)))	; a label is an address
(define-function native-size (insn) (native-type-size (<ir-insn>-type insn)))
(define-function native-label-var? (insn) (and (inherits-from (type-of insn) <ir-get-var>) (ir-label-var? (<ir-insn>-parameters insn))))
(define-function native-user-label (name) (string->symbol (concat-string "ul." (symbol->string name))))
(define-function native-kind (type) (cond ((ir-struct-type? type) 'struct) ((ir-floating-type? type) 'float) (else 'int)))
(define-function native-float? (insn) (ir-floating-type? (<ir-insn>-type insn)))
(define-function native-width (insn) (* 8 (<ir-type>-size (<ir-insn>-type insn))))
;; a double's IEEE 754 bits as a long: sign, exponent biased by 1023, 52 bits of fraction; normal numbers and zero only
(define-function native-double-bits (x)
  (if (= x 0)
      0
    (let ((sign 0) (e 0) (m x))
      (and (< m 0) (let () (set sign 1) (set m (- 0 m))))
      (while (and (>= m 2) (< e 1024)) (set m (/ m 2)) (set e (+ e 1)))
      (while (and (< m 1) (> e -1023)) (set m (* m 2)) (set e (- e 1)))
      (or (and (< -1023 e) (< e 1024)) (error "native: no literal for " x ": not a normal double"))
      (| (<< sign 63) (| (<< (+ e 1023) 52) (double->long (* (- m 1) 4503599627370496.0)))))))
(define-function native-global? (insn) (ir-global? (<ir-insn>-parameters insn)))

;;; slots: each instruction's value gets one, a variable read uses the variable's, a let's value is its last operand's
(define-selector native-allocate (insn gen) (error "native: no slots for " insn))
(define-method native-allocate <ir-insn> (gen)
  (list-do opd self.operands (native-allocate opd gen))
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-get-var> (gen)	; a global's value, or a label's address, is read into a slot of its own
  (set self.location (cond ((native-label-var? self) (native-slot gen IR-VOID*))
			   ((native-global? self) (native-slot gen self.type))
			   (else (<ir-variable>-location self.parameters)))))
(define-method native-allocate <ir-set-var> (gen)
  (native-allocate (car self.operands) gen)
  (set self.location (if (native-global? self) (native-slot gen self.type) (<ir-variable>-location self.parameters))))
(define-method native-allocate <ir-call> (gen)	; and room at the frame's bottom for its arguments: 16 bytes each at most
  (list-do opd self.operands (native-allocate opd gen))
  (set (<native-gen>-outgoing gen) (max (<native-gen>-outgoing gen) (* 16 (list-length (cdr self.operands)))))
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-let> (gen)
  (list-do bind self.parameters (set (<ir-variable>-location (cdr bind)) (native-slot gen (<ir-variable>-type (cdr bind)))))
  (let ((last ()))
    (list-do expr self.operands (native-allocate (set last expr) gen))
    (set self.location (and last (<ir-insn>-location last)))))
(define-method native-allocate <ir-return> (gen) (list-do opd self.operands (native-allocate opd gen)))
(define-method native-allocate <ir-nop> (gen) ())

;;; intents
(define-selector native-lower (insn gen) (error "native: no lowering for " insn))
(define-function native-slot-of (insn)
  (let ((loc (<ir-insn>-location insn))) (if (ir-location? loc) (native-offset loc) (error "native: no slot for " insn))))
(define-function native-into (gen insn s) (native-emit gen (list 'load (native-size insn) (native-slot-of insn) s)))
(define-function native-out (gen insn s) (native-emit gen (list 'store (native-size insn) (native-slot-of insn) s)))
(define-function native-place (insn) (list (native-size insn) (native-offset (<ir-insn>-location insn)) (native-kind (<ir-insn>-type insn))))
;; one instruction's value into another's slot: a struct by copying, a scalar through s0
(define-function native-move (gen from to)
  (if (ir-struct-type? (<ir-insn>-type from))
      (or (= (<ir-insn>-location from) (<ir-insn>-location to))
	  (native-emit gen (list 'copy (native-size from) (native-offset (<ir-insn>-location from)) (native-offset (<ir-insn>-location to)))))
    (native-into gen from 's0)
    (native-out gen to 's0)))

(define-method native-lower <ir-lit> (gen)	; a float literal is its double's bits, narrowed if its type is float
  (let ((v (car self.parameters)))
    (cond ((string? v) (native-emit gen (list 'string-address 's0 v)))
	  ((native-float? self)
	   (native-emit gen (list 'constant 's0 (native-double-bits v)))
	   (or (= 64 (native-width self)) (native-emit gen '(convert f64 f32 s0 s0))))
	  (else (native-emit gen (list 'constant 's0 v))))
    (native-out gen self 's0)))
(define-method native-lower <ir-function> (gen)
  (native-emit gen (list 'function-address 's0 (car self.parameters)))
  (native-out gen self 's0))
(define-method native-lower <ir-extern> (gen)
  (native-emit gen (list 'extern-address 's0 (car self.parameters)))
  (native-out gen self 's0))
(define-method native-lower <ir-define-label> (gen) (native-emit gen (list 'label (native-user-label (car self.parameters)))))
(define-method native-lower <ir-goto> (gen)
  (let ((target (car self.operands)))
    (if (native-label-var? target)
	(native-emit gen (list 'branch (native-user-label (<ir-variable>-name (<ir-insn>-parameters target)))))
      (native-lower target gen)
      (native-into gen target 's0)
      (native-emit gen '(branch-to s0)))))
(define-method native-lower <ir-get-var> (gen)
  (when (native-label-var? self)
    (native-emit gen (list 'label-address 's0 (native-user-label (<ir-variable>-name self.parameters))))
    (native-out gen self 's0))
  (when (and (native-global? self) (not (native-label-var? self)))
    (native-emit gen (list 'global-address 's2 (<ir-variable>-name self.parameters)))
    (native-emit gen (list 'load-at (native-size self) 's2 's0))
    (native-out gen self 's0)))
;; a write stores at the size of the place it writes, not the value's: zero, an int, written to a pointer is the whole pointer
(define-method native-lower <ir-set-var> (gen)
  (let ((value (car self.operands)) (size (native-type-size (<ir-variable>-type self.parameters))))
    (native-lower value gen)
    (cond ((native-global? self)
	   (native-into gen value 's0)
	   (native-emit gen (list 'global-address 's2 (<ir-variable>-name self.parameters)))
	   (native-emit gen (list 'store-at size 's2 's0))
	   (native-out gen self 's0))
	  ((ir-struct-type? (<ir-insn>-type value)) (native-move gen value self))
	  (else
	   (native-into gen value 's0)
	   (native-emit gen (list 'store size (native-slot-of self) 's0))))))
(define-method native-lower <ir-call> (gen)
  (let* ((callee (car self.operands)) (args (cdr self.operands))
	 (proto (<ir-function-type>-arg-types (<ir-pointer-type>-referent (<ir-insn>-type callee))))
	 (nfixed (let ((n 0)) (while (and proto (not (= IR-VARARGS (car proto)))) (set n (+ n 1)) (set proto (cdr proto))) n)))
    (native-lower callee gen)
    (list-do a args (native-lower a gen))
    (native-emit gen (list 'call (native-offset (<ir-insn>-location callee)) nfixed (map native-place args)
			   (and (not (= IR-VOID self.type)) (native-place self))))))
(define-method native-lower <ir-let> (gen) (list-do expr self.operands (native-lower expr gen)))
(define-function native-binary (gen insn kind)
  (let ((a (car (<ir-insn>-operands insn))) (b (cadr (<ir-insn>-operands insn))))
    (native-lower a gen) (native-lower b gen)
    (native-into gen a 's0) (native-into gen b 's1)
    (native-emit gen (if (native-float? insn) (list 'fop kind (native-width insn) 's0 's0 's1) (list 'op kind 's0 's0 's1)))
    (native-out gen insn 's0)))
(define-method native-lower <ir-add> (gen) (native-binary gen self 'add))
(define-method native-lower <ir-sub> (gen) (native-binary gen self 'sub))
(define-method native-lower <ir-mul> (gen) (native-binary gen self 'mul))
(define-method native-lower <ir-div> (gen) (native-binary gen self 'div))
(define-method native-lower <ir-mod> (gen) (native-binary gen self 'mod))
(define-method native-lower <ir-bitand> (gen) (native-binary gen self 'and))
(define-method native-lower <ir-bitor> (gen) (native-binary gen self 'or))
(define-method native-lower <ir-bitxor> (gen) (native-binary gen self 'xor))
(define-method native-lower <ir-shl> (gen) (native-binary gen self 'shl))
(define-method native-lower <ir-shr> (gen) (native-binary gen self 'shr))
(define-method native-lower <ir-com> (gen)
  (let ((a (car self.operands)))
    (native-lower a gen)
    (native-into gen a 's0)
    (native-emit gen '(op com s0 s0 s0))
    (native-out gen self 's0)))
;; an integer or pointer cast: loaded at the source's size (sign-extended), stored at the target's (truncated); a cast to
;; or from a float converts, an integer through 64 bits
(define-function native-numeric-kind (insn) (if (native-float? insn) (if (= 32 (native-width insn)) 'f32 'f64) 's64))
(define-method native-lower <ir-cast> (gen)
  (let* ((a (car self.operands)) (from (native-numeric-kind a)) (to (native-numeric-kind self)))
    (native-lower a gen)
    (native-into gen a 's0)
    (or (= from to) (native-emit gen (list 'convert from to 's0 's0)))
    (native-out gen self 's0)))

;;; places: the address of what an instruction names into register s, for reading, writing or addressof
(define-function native-pointee-size (ptr) (<ir-type>-size (<ir-pointer-type>-referent (<ir-insn>-type ptr))))
(define-selector native-address (insn gen s) (error "native: no address for " insn))
(define-method native-address <ir-get-var> (gen s)
  (native-emit gen (if (native-global? self)
		       (list 'global-address s (<ir-variable>-name self.parameters))
		     (list 'address (native-offset (<ir-variable>-location self.parameters)) s))))
(define-method native-address <ir-insn> (gen s)	; a value in a slot of its own (a struct a call returned)
  (native-lower self gen)
  (native-emit gen (list 'address (native-offset self.location) s)))
(define-method native-address <ir-indir> (gen s)	; p + i * the element's size
  (let ((p (car self.operands)) (i (cadr self.operands)))
    (native-lower p gen) (native-lower i gen)
    (native-into gen p s) (native-into gen i 's3)
    (native-emit gen (list 'constant 's4 (native-pointee-size p)))
    (native-emit gen '(op mul s3 s3 s4))
    (native-emit gen (list 'op 'add s s 's3))))
(define-method native-address <ir-member> (gen s)	; a pointer's or a struct place's address, plus the field's offset
  (let ((base (car self.operands)))
    (if (ir-pointer-type? (<ir-insn>-type base))
	(let () (native-lower base gen) (native-into gen base s))
      (native-address base gen s))
    (native-emit gen (list 'constant 's4 (<ir-struct-member>-offset (car self.parameters))))
    (native-emit gen (list 'op 'add s s 's4))))
(define-function native-read (gen insn)
  (native-address insn gen 's2)
  (native-emit gen (list 'load-at (native-size insn) 's2 's0))
  (native-out gen insn 's0))
(define-method native-lower <ir-indir> (gen) (native-read gen self))
(define-method native-lower <ir-member> (gen) (native-read gen self))
(define-method native-lower <ir-addressof> (gen)
  (native-address (car self.operands) gen 's2)
  (native-out gen self 's2))
;; a write: the value first, then the place's address, then the store; the value is the write's value
(define-function native-write (gen insn place value)
  (native-lower value gen)
  (native-address place gen 's2)
  (native-into gen value 's0)
  (native-emit gen (list 'store-at (native-size place) 's2 's0))
  (native-out gen insn 's0))
(define-method native-lower <ir-set-indir> (gen)
  (let ((p (car self.operands)) (i (cadr self.operands)) (value (caddr self.operands)))
    (native-write gen self (new <ir-indir> () (list p i) (native-size-type p) () ()) value)))
(define-method native-lower <ir-set-member> (gen)
  (let ((base (car self.operands)) (value (cadr self.operands)))
    (native-write gen self (new <ir-member> self.parameters (list base) (<ir-struct-member>-type (car self.parameters)) () ()) value)))
(define-function native-size-type (ptr) (<ir-pointer-type>-referent (<ir-insn>-type ptr)))
(define-method native-lower <ir-neg> (gen)
  (let ((a (car self.operands)))
    (native-lower a gen)
    (if (native-float? self)
	(let () (native-into gen a 's0) (native-emit gen (list 'fop 'neg (native-width self) 's0 's0 's0)))
      (native-into gen a 's1)
      (native-emit gen '(constant s0 0))
      (native-emit gen '(op sub s0 s0 s1)))
    (native-out gen self 's0)))
(define-method native-lower <ir-nop> (gen) ())
;; comparisons: integers are signed, pointers unsigned
(define-function native-condition (kind insn)
  (if (ir-pointer-type? (<ir-insn>-type (car (<ir-insn>-operands insn))))
      (cdr (assq kind '((eq . eq) (ne . ne) (lt . lo) (le . ls) (gt . hi) (ge . hs))))
    kind))
(define-function native-relation (gen insn kind)
  (let ((a (car (<ir-insn>-operands insn))) (b (cadr (<ir-insn>-operands insn))))
    (native-lower a gen) (native-lower b gen)
    (native-into gen a 's0) (native-into gen b 's1)
    (native-emit gen (if (native-float? a)
			 (list 'fcompare kind (native-width a) 's0 's0 's1)
		       (list 'compare (native-condition kind insn) 's0 's0 's1)))
    (native-out gen insn 's0)))
(define-method native-lower <ir-eq> (gen) (native-relation gen self 'eq))
(define-method native-lower <ir-ne> (gen) (native-relation gen self 'ne))
(define-method native-lower <ir-lt> (gen) (native-relation gen self 'lt))
(define-method native-lower <ir-le> (gen) (native-relation gen self 'le))
(define-method native-lower <ir-gt> (gen) (native-relation gen self 'gt))
(define-method native-lower <ir-ge> (gen) (native-relation gen self 'ge))
(define-method native-lower <ir-not> (gen)
  (let ((a (car self.operands)))
    (native-lower a gen)
    (native-into gen a 's0)
    (native-emit gen '(constant s1 0))
    (native-emit gen '(compare eq s0 s0 s1))
    (native-out gen self 's0)))
;; a value of 1 or 0 into an instruction's slot, when it has one
(define-function native-set (gen insn v)
  (unless (= IR-VOID (<ir-insn>-type insn))
    (native-emit gen (list 'constant 's0 v))
    (native-out gen insn 's0)))
;; a branch's value into the if's slot, unless the branch has none (it leaves the function, as exit does)
(define-function native-branch-value (gen insn branch valued)
  (and valued (not (= IR-VOID (<ir-insn>-type branch))) (native-move gen branch insn)))
(define-method native-lower <ir-if> (gen)
  (let ((test (car self.operands)) (then (cadr self.operands)) (else (caddr self.operands))
	(other (native-label gen)) (end (native-label gen)) (valued (not (= IR-VOID self.type))))
    (native-lower test gen)
    (native-into gen test 's0)
    (native-emit gen (list 'branch-unless 's0 other))
    (native-lower then gen)
    (native-branch-value gen self then valued)
    (native-emit gen (list 'branch end))
    (native-emit gen (list 'label other))
    (when else
      (native-lower else gen)
      (native-branch-value gen self else valued))
    (native-emit gen (list 'label end))))
(define-method native-lower <ir-while> (gen)
  (let ((test (car self.operands)) (body (cadr self.operands)) (top (native-label gen)) (end (native-label gen)))
    (native-emit gen (list 'label top))
    (native-lower test gen)
    (native-into gen test 's0)
    (native-emit gen (list 'branch-unless 's0 end))
    (native-lower body gen)
    (native-emit gen (list 'branch top))
    (native-emit gen (list 'label end))))
;; and: the first false operand decides it, 0; or: the first true one, 1
(define-function native-logical (gen insn decide decided)
  (let ((out (native-label gen)) (end (native-label gen)))
    (list-do opd (<ir-insn>-operands insn)	; an operand with no value (it leaves, as exit does) decides nothing
      (native-lower opd gen)
      (unless (= IR-VOID (<ir-insn>-type opd))
	(native-into gen opd 's0)
	(native-emit gen (list decide 's0 out))))
    (native-set gen insn (- 1 decided))
    (native-emit gen (list 'branch end))
    (native-emit gen (list 'label out))
    (native-set gen insn decided)
    (native-emit gen (list 'label end))))
(define-method native-lower <ir-logand> (gen) (native-logical gen self 'branch-unless 0))
(define-method native-lower <ir-logor> (gen) (native-logical gen self 'branch-if 1))
(define-method native-lower <ir-return> (gen)
  (let ((value (car self.operands)))
    (when value
      (native-lower value gen)
      (native-emit gen (cons 'result (native-place value))))
    (native-emit gen (list 'leave '*frame*))
    (native-emit gen '(return))))

;; a function's intents: its parameters' and instructions' slots above the outgoing arguments' area, then its code
(define-function native-function (self name args params body)
  (set (<native-gen>-frame self) (ir-frame-new))
  (set (<native-gen>-intents self) ())
  (set (<native-gen>-outgoing self) 0)
  (list-do bind params (set (<ir-variable>-location (cdr bind)) (native-slot self (<ir-variable>-type (cdr bind)))))
  (list-do insn body (native-allocate insn self))
  (let ((size (align (ir-frame-finalise (<native-gen>-frame self) (align (<native-gen>-outgoing self) 16)) 16)) (last ()))
    (native-emit self (list 'enter size))
    (native-emit self (list 'params (map (lambda (arg)	; in order: a scope's bindings are most recent first
					   (let* ((var (cdr (assq arg params))) (type (<ir-variable>-type var)))
					     (list (<ir-type>-size type) (native-offset (<ir-variable>-location var)) (native-kind type))))
					 args)))
    (list-do insn body (native-lower (set last insn) self))
    (unless (and last (ir-returns? last)) (native-emit self (list 'leave '*frame*)) (native-emit self '(return)))
    (set (<native-unit>-functions *native-unit*)
	 (cons (list name (map (lambda (x) (if (and (pair? x) (= '*frame* (cadr x))) (list (car x) size) x))
			       (list-reverse! (<native-gen>-intents self)))
		     size)
	       (<native-unit>-functions *native-unit*)))))

;;; the generator protocol
(define-method ir-gen-header <native-gen> () (set *native-unit* (new <native-unit> () ())))
(define-method ir-gen-declare-struct <native-gen> args ())
(define-method ir-gen-global-declaration <native-gen> (var)
  (let ((type (<ir-variable>-type var)))
    (set (<native-unit>-globals *native-unit*)
	 (cons (list (<ir-variable>-name var) (<ir-type>-size type) (<ir-type>-alignment type)) (<native-unit>-globals *native-unit*)))))
(define-method ir-gen-local-declaration <native-gen> args ())
(define-method ir-gen-preamble <native-gen> () (set self.inits ()))
(define-method ir-gen-initialisation <native-gen> (definition) (set self.inits (cons definition self.inits)))
(define-method ir-gen-output <native-gen> () ())
;; the globals' initialisations, as a function __init that native-install runs: main is a function, not a global
(define-method ir-gen-postamble <native-gen> ()
  (let ((setters ()))
    (list-do def (list-reverse self.inits)
      (let ((setter (car (<ir-define>-operands def))))	; a global with no initialiser stays zero
	(or (ir-nop? setter) (= 'main (<ir-variable>-name (<ir-set-var>-parameters setter))) (push setters setter))))
    (native-function self '__init () () (list-reverse! setters))))
(define-method ir-gen-function-implementation <native-gen> (value)
  (native-function self (car (<ir-function>-parameters value)) (cadr (<ir-function>-parameters value))
		   (<ir-scope>-bindings (<ir-function>-scope value)) (<ir-function>-operands value)))
