;;; native-gen.k -- typed Maru's IR to intents (draft-ndn-maru-native-ir2-00): the generator maru.k's compile-namespace
;;; drives, as it drives ir-gen-c.k, collecting a unit of functions as lists of intents instead of writing C.  Every value
;;; has a frame slot (ir2's ir-frame-allocate, as ir-gen-x86.k uses it), and an operation loads its operands into scratch
;;; registers s0, s1 …, operates, and stores its result.  Nothing here names a register, an instruction or a calling
;;; convention: those are the lowering grammars' (native-arm64.g).
;;;
;;; Intents (slots are byte offsets in the frame):
;;;   (enter size outgoing) (leave size) (return) the frame, its bottom outgoing bytes the calls' stack arguments, and
;;;                                                returning from it
;;;   (params ((size slot kind) …))                the arguments, as they arrive, into their slots; kind int or struct
;;;   (call slot nfixed (arg …) ret)               call the function whose address is in slot with args (size slot kind),
;;;                                                the first nfixed named and the rest variadic; ret is () or (size slot
;;;                                                kind), where the result goes
;;;   (result size slot kind)                      a slot as the function's result
;;;   (copy size from to)                          a struct from one slot to another
;;;   (load size slot s) (store size slot s)       a slot of size bytes to or from a scratch register (loads sign-extend:
;;;                                                ir2's integers are signed)
;;;   (constant s value) (result-from s)           a value into a scratch register; a scratch register as the result
;;;   (op kind d a b)                              d := a kind b: add sub mul div mod and or xor shl shr (division and
;;;                                                right shift signed), or com (d := ~a)
;;;   (address slot s)                             s := the slot's address
;;;   (load-at size base s) (store-at size base s) through the address in register base
;;;   (compare cond d a b)                         d := 1 if a cond b else 0; cond eq ne lt le gt ge, or lo ls hi hs
;;;                                                for pointers, which compare unsigned
;;;   (label L) (branch L) (branch-if s L) (branch-unless s L)   within a function
;;;   (label-address s L) (branch-to s)            a label as a value, and a computed goto to one
;;;   (global-address s name) (extern-address s name) (string-address s text) (function-address s name)
;;;                                                resolved by native-link.l: a global's storage, a C symbol, a literal's
;;;                                                bytes, a function of the unit
(require "ir2.k")

(define-structure <native-gen> (frame intents functions labels outgoing inits name passing pending holdable))
(define-structure <native-unit> (functions globals))	; ((name intents frame-size) …), ((name size alignment) …)
(define *native-unit* ())

(define-function ir-gen-new () (new <native-gen> () () () 0 0 () () () 0 ()))
(define-function native-label (gen)
  (set (<native-gen>-labels gen) (+ 1 (<native-gen>-labels gen)))
  (string->symbol (concat-string "L" (long->string (<native-gen>-labels gen)))))

(define-function list-reverse (l) (let ((r ())) (list-do x l (push r x)) r))
(define-function native-emit (gen intent) (set (<native-gen>-intents gen) (cons intent (<native-gen>-intents gen))))
(define-function native-slot (gen type)	; a label is an address: IR-LABEL's alignment is 0, which would align the frame to 0
  (ir-frame-allocate (<native-gen>-frame gen) (if (= IR-LABEL type) IR-VOID* type)))
(define-function native-offset (location) (<ir-location>-offset location))
(define-function native-type-size (type) (<ir-type>-size (if (= IR-LABEL type) IR-VOID* type)))	; a label is an address
(define-function native-size (insn) (native-type-size (<ir-insn>-type insn)))
(define-function native-label-var? (insn) (and (inherits-from (type-of insn) <ir-get-var>) (ir-label-var? (<ir-insn>-parameters insn))))
(define-function native-define-label? (insn) (inherits-from (type-of insn) <ir-define-label>))
;; a user label belongs to its scope: each (label NAME) a scope's body holds takes a label of its own in the unit, kept as
;; its variable's location, so two functions, or two sibling lets, may each have a label done
(define-function native-name-labels (gen bindings body)
  (list-do insn body
    (when (native-define-label? insn)
      (let ((var (cdr (assq (car (<ir-insn>-parameters insn)) bindings))))
	(set (<ir-define-label>-var insn) var)
	(set (<ir-variable>-location var) (native-label gen))))))
(define-function native-user-label (var) (<ir-variable>-location var))
(define-function native-kind (type) (cond ((ir-struct-type? type) 'struct) ((ir-floating-type? type) 'float) (else 'int)))
(define-function native-float? (insn) (ir-floating-type? (<ir-insn>-type insn)))
(define-function native-width (insn) (* 8 (<ir-type>-size (<ir-insn>-type insn))))
;; a double's IEEE 754 bits as a long: sign, exponent biased by 1023, 52 bits of fraction; normal numbers and zero only,
;; and not -0.0, which would lose its sign
(define-function native-double-bits (x)
  (if (= x 0)
      (if (< (/ 1.0 x) 0) (error "native: no literal for -0.0: it would compile as 0.0") 0)
    (let ((sign 0) (e 0) (m x))
      (and (< m 0) (let () (set sign 1) (set m (- 0 m))))
      (while (and (>= m 2) (< e 1024)) (set m (/ m 2)) (set e (+ e 1)))
      (while (and (< m 1) (> e -1023)) (set m (* m 2)) (set e (- e 1)))
      (or (and (< -1023 e) (< e 1024)) (error "native: no literal for " x ": not a normal double"))
      (| (<< sign 63) (| (<< (+ e 1023) 52) (double->long (* (- m 1) 4503599627370496.0)))))))
(define-function native-global? (insn) (ir-global? (<ir-insn>-parameters insn)))

;;; where values live: each instruction's value gets a slot, a variable read uses the variable's, a let's value is its
;;; last operand's; or it is held, (held K), in register hK from its producer to its consumer.  A value is held when it
;;; produces itself (a literal, an operation, comparison or cast, a read through a pointer, an address, a global's read,
;;; an extern, a function's address), its parent reads it from a register, it isn't a struct or a float (abi.spec's held
;;; registers are general ones), no later sibling evaluates a call (which may change every held register), and a held
;;; register is free: the generator keeps the depth of values pending while it allocates, in the order they're lowered,
;;; so the depth at allocation is the depth at lowering.
(define-selector native-calls? (insn)	; does evaluating it call?
  (let ((found ())) (list-do opd (<ir-insn>-operands insn) (or found (set found (native-calls? opd)))) found))
(define-function native-any-calls? (insns) (and insns (or (native-calls? (car insns)) (native-any-calls? (cdr insns)))))
(define-method native-calls? <ir-function> () ())	; its body runs when it's called, not here
(define-selector native-allocate (insn gen) (error "native: no slots for " insn))
(define-function native-held? (insn) (pair? (<ir-insn>-location insn)))
(define-function native-held-reg (insn) (string->symbol (concat-string "h" (long->string (cadr (<ir-insn>-location insn))))))
;; operands allocated in the order they're lowered; reads: the parent reads them from registers.  They stay pending
;; until the parent consumes them, all at once after the last.
(define-function native-allocate-operands (gen opds reads)
  (let ((depth (<native-gen>-pending gen)))
    (while opds
      (set (<native-gen>-holdable gen) (and reads (not (native-any-calls? (cdr opds)))))
      (native-allocate (car opds) gen)
      (set opds (cdr opds)))
    (set (<native-gen>-holdable gen) ())
    (set (<native-gen>-pending gen) depth)))
(define-function native-allocate-each (gen opds reads)	; each consumed as soon as it's computed: a branch condition
  (list-do opd opds (native-allocate-operands gen (list opd) reads)))
(define-selector native-holds-result? (insn) 1)	; may its result go where an operand is held?
(define-function native-producer (gen insn reads)	; its operands, then its own place: held if its parent may hold it
  (let ((may (<native-gen>-holdable gen)) (type (<ir-insn>-type insn)))
    (native-allocate-operands gen (<ir-insn>-operands insn) reads)
    (set (<ir-insn>-location insn)
	 (if (and may (< (<native-gen>-pending gen) *native-held-count*) (not (= IR-VOID type)) (not (ir-struct-type? type))
		  (not (ir-floating-type? type)) (native-holds-result? insn))
	     (list 'held (<native-gen>-pending gen))
	   (and (not (= IR-VOID type)) (native-slot gen type))))
    (and (native-held? insn) (set (<native-gen>-pending gen) (+ 1 (<native-gen>-pending gen))))))
(define-method native-allocate <ir-insn> (gen)	; operands not read from registers, its value in a slot
  (native-allocate-operands gen self.operands ())
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-get-var> (gen)	; a global's value, or a label's address, is read into a slot of its own
  (cond ((native-label-var? self) (set self.location (native-slot gen IR-VOID*)))
	((native-global? self) (native-producer gen self ()))
	(else (set self.location (<ir-variable>-location self.parameters)))))
(define-method native-allocate <ir-set-var> (gen)
  (native-allocate-operands gen self.operands 1)
  (set self.location (if (native-global? self) (native-slot gen self.type) (<ir-variable>-location self.parameters))))
(define-method native-allocate <ir-lit> (gen) (native-producer gen self ()))
(define-method native-allocate <ir-extern> (gen) (native-producer gen self ()))
(define-method native-allocate <ir-add> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-sub> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-mul> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-div> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-mod> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-bitand> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-bitor> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-bitxor> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-shl> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-shr> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-com> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-neg> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-not> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-cast> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-eq> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-ne> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-lt> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-le> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-gt> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-ge> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-indir> (gen) (native-producer gen self 1))
(define-method native-allocate <ir-member> (gen) (native-producer gen self 1))
;; x64's two-operand instructions write their first operand: a result may share a register with its first operand, not
;; with a later one alone (an operation whose first operand comes from a slot and second is held keeps its result in a
;; slot; so does a negation of a held integer, 0 minus it)
(define-function native-first-only? (insn)
  (let ((opds (<ir-insn>-operands insn))) (or (native-held? (car opds)) (not (native-held? (cadr opds))))))
(define-method native-holds-result? <ir-add> () (native-first-only? self))
(define-method native-holds-result? <ir-sub> () (native-first-only? self))
(define-method native-holds-result? <ir-mul> () (native-first-only? self))
(define-method native-holds-result? <ir-div> () (native-first-only? self))
(define-method native-holds-result? <ir-mod> () (native-first-only? self))
(define-method native-holds-result? <ir-bitand> () (native-first-only? self))
(define-method native-holds-result? <ir-bitor> () (native-first-only? self))
(define-method native-holds-result? <ir-bitxor> () (native-first-only? self))
(define-method native-holds-result? <ir-shl> () (native-first-only? self))
(define-method native-holds-result? <ir-shr> () (native-first-only? self))
(define-method native-holds-result? <ir-neg> () (not (native-held? (car self.operands))))
;; a write lowers its value, then its place's operands: allocated in that order
(define-method native-allocate <ir-set-indir> (gen)
  (let ((opds self.operands)) (native-allocate-operands gen (list (caddr opds) (car opds) (cadr opds)) 1))
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-set-member> (gen)
  (let ((opds self.operands)) (native-allocate-operands gen (list (cadr opds) (car opds)) 1))
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-goto> (gen) (native-allocate-operands gen self.operands 1))	; a computed target
(define-method native-allocate <ir-if> (gen)	; the test is read at once; the branches' values move to the if's slot
  (native-allocate-each gen (list (car self.operands)) 1)
  (native-allocate-operands gen (cdr self.operands) ())
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-while> (gen)
  (native-allocate-each gen (list (car self.operands)) 1)
  (native-allocate-operands gen (cdr self.operands) ())
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-logand> (gen)
  (native-allocate-each gen self.operands 1)
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-logor> (gen)
  (native-allocate-each gen self.operands 1)
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
;; a struct by value, as an argument or a result, is refused where general registers in 8- and 4-byte pieces, the one
;; convention written, aren't C's: over 16 bytes (C passes it by reference and returns it through a hidden pointer), with a
;; floating member anywhere in it (the AAPCS64's homogeneous aggregates and System V's SSE eightbytes go in vector
;; registers), or a size not a multiple of 4 (no piece carries the rest)
(define-function native-floating-member? (type)
  (let ((found ()))
    (list-do m (<ir-struct-type>-members type)
      (let ((t (<ir-struct-member>-type (cdr m))))
	(and (or (ir-floating-type? t) (and (ir-struct-type? t) (native-floating-member? t))) (set found 1))))
    found))
(define-function native-by-value (gen type role whom)
  (and (ir-struct-type? type)
       (let ((why (cond ((< 16 (<ir-type>-size type)) "over 16 bytes needs C's by-reference convention")
			((native-floating-member? type) "a floating member needs C's vector registers")
			((!= 0 (% (<ir-type>-size type) 4)) "a size not a multiple of 4 needs pieces under 4 bytes"))))
	 (and why
	      (error "native: struct " (<ir-type>-name type) " of " (<ir-type>-size type) " bytes " role " " whom " by value, in "
		     (<native-gen>-name gen) ": " why ", not yet written")))))
(define-function native-callee-name (callee)
  (if (inherits-from (type-of callee) <ir-get-var>) (<ir-variable>-name (<ir-insn>-parameters callee)) "a function pointer"))
;; a callee's parameter types, and how many of its arguments are named: those before ..., or all of them for a function
;; type with no prototype, () or (...) alone, which C calls as if it had one
(define-function native-prototype (callee) (<ir-function-type>-arg-types (<ir-pointer-type>-referent (<ir-insn>-type callee))))
(define-function native-named (proto nargs)
  (if (or (not proto) (= IR-VARARGS (car proto)))
      nargs
    (let ((n 0)) (while (and proto (not (= IR-VARARGS (car proto)))) (set n (+ n 1)) (set proto (cdr proto))) n)))
;; the type an argument is passed as: a named one's parameter type (zero, an int, passed to a pointer is the whole
;; pointer), and a float with none promoted to double, as C's default promotions do
(define-function native-passing-type (type param)
  (cond ((ir-struct-type? type) type)
	((and param (not (= IR-VARARGS param)) (not (= IR-VOID param))) param)
	((and (ir-floating-type? type) (= 4 (<ir-type>-size type))) IR-DOUBLE)
	(else type)))
;; and room at the frame's bottom for its stack arguments: at most 8 bytes for a scalar and its size rounded up to 8 for a
;; struct, in every convention native.l and native-x64.l follow; the lowering checks a call stays within it.  An argument
;; passed as another type has a slot of that type, kept in the generator's passing, (insn type . location) …
(define-method native-allocate <ir-call> (gen)
  (native-allocate-operands gen self.operands ())	; a call reads its callee and arguments from slots
  (let ((callee (native-callee-name (car self.operands))) (bytes 0) (proto (native-prototype (car self.operands))))
    (list-do a (cdr self.operands)
      (let* ((type (<ir-insn>-type a)) (passed (native-passing-type type (car proto))))
	(native-by-value gen type "passed to" callee)
	(or (and (= (<ir-type>-size type) (<ir-type>-size passed)) (= (native-kind type) (native-kind passed)))
	    (push (<native-gen>-passing gen) (cons a (cons passed (native-slot gen passed)))))
	(set bytes (+ bytes (align (<ir-type>-size passed) 8)))
	(set proto (cdr proto))))
    (native-by-value gen self.type "returned from" callee)
    (set (<native-gen>-outgoing gen) (max (<native-gen>-outgoing gen) bytes)))
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))
(define-method native-allocate <ir-let> (gen)
  (list-do bind self.parameters (set (<ir-variable>-location (cdr bind)) (native-slot gen (<ir-variable>-type (cdr bind)))))
  (native-name-labels gen self.parameters self.operands)
  (let ((last ()))
    (native-allocate-operands gen self.operands ())
    (list-do expr self.operands (set last expr))
    (set self.location (and last (<ir-insn>-location last)))))
(define-method native-allocate <ir-return> (gen) (native-allocate-operands gen self.operands ()))	; result reads a slot
(define-method native-allocate <ir-nop> (gen) ())
(define-method native-allocate <ir-function> (gen)	; a function's value is its address: its body has a frame of its own
  (or (= IR-VOID self.type) (set self.location (native-slot gen self.type))))

;;; intents
(define-selector native-lower (insn gen) (error "native: no lowering for " insn))
(define-function native-slot-of (insn)
  (let ((loc (<ir-insn>-location insn))) (if (ir-location? loc) (native-offset loc) (error "native: no slot for " insn))))
;; insn's value in a register: the held register it's in, or s after a load from its slot
(define-function native-into (gen insn s)
  (if (native-held? insn) (native-held-reg insn) (native-emit gen (list 'load (native-size insn) (native-slot-of insn) s)) s))
(define-function native-target (gen insn s) (if (native-held? insn) (native-held-reg insn) s))	; where its result is made
;; a result in register r into insn's place: its slot, or nothing when held (r is its register), but a held integer
;; narrower than a register sign-extended, as a load from its slot would have, unless its producer already did (a load,
;; a comparison, a literal)
(define-selector native-extended? (insn) ())
(define-method native-extended? <ir-lit> () 1)
(define-method native-extended? <ir-indir> () 1)
(define-method native-extended? <ir-member> () 1)
(define-method native-extended? <ir-get-var> () 1)
(define-method native-extended? <ir-not> () 1)
(define-method native-extended? <ir-eq> () 1)
(define-method native-extended? <ir-ne> () 1)
(define-method native-extended? <ir-lt> () 1)
(define-method native-extended? <ir-le> () 1)
(define-method native-extended? <ir-gt> () 1)
(define-method native-extended? <ir-ge> () 1)
(define-function native-out (gen insn r)
  (if (native-held? insn)
      (and (< (native-size insn) 8) (not (native-extended? insn)) (native-emit gen (list 'extend (native-size insn) r)))
    (native-emit gen (list 'store (native-size insn) (native-slot-of insn) r))))
(define-function native-place (insn) (list (native-size insn) (native-offset (<ir-insn>-location insn)) (native-kind (<ir-insn>-type insn))))
;; one instruction's value into another's slot: a struct by copying, a scalar through a register
(define-function native-move (gen from to)
  (if (ir-struct-type? (<ir-insn>-type from))
      (or (= (<ir-insn>-location from) (<ir-insn>-location to))
	  (native-emit gen (list 'copy (native-size from) (native-offset (<ir-insn>-location from)) (native-offset (<ir-insn>-location to)))))
    (native-out gen to (native-into gen from 's0))))

(define-method native-lower <ir-lit> (gen)	; a float literal is its double's bits, narrowed if its type is float
  (let ((v (car self.parameters)) (t (native-target gen self 's0)))
    (cond ((string? v) (native-emit gen (list 'string-address t v)))
	  ((native-float? self)
	   (native-emit gen (list 'constant t (native-double-bits v)))
	   (or (= 64 (native-width self)) (native-emit gen (list 'convert 'f64 'f32 t t))))
	  (else (native-emit gen (list 'constant t v))))
    (native-out gen self t)))
(define-method native-lower <ir-function> (gen)
  (native-emit gen (list 'function-address 's0 (car self.parameters)))
  (native-out gen self 's0))
(define-method native-lower <ir-extern> (gen)
  (let ((t (native-target gen self 's0)))
    (native-emit gen (list 'extern-address t (car self.parameters)))
    (native-out gen self t)))
(define-method native-lower <ir-define-label> (gen)	; ir2 declares only a function's or a let's top-level labels
  (or self.var (error "native: label " (car self.parameters) " in " (<native-gen>-name gen) " isn't at the top level of a function or let"))
  (native-emit gen (list 'label (native-user-label self.var))))
(define-method native-lower <ir-goto> (gen)
  (let ((target (car self.operands)))
    (if (native-label-var? target)
	(native-emit gen (list 'branch (native-user-label (<ir-insn>-parameters target))))
      (native-lower target gen)
      (native-emit gen (list 'branch-to (native-into gen target 's0))))))
(define-method native-lower <ir-get-var> (gen)
  (when (native-label-var? self)
    (native-emit gen (list 'label-address 's0 (native-user-label self.parameters)))
    (native-out gen self 's0))
  (when (and (native-global? self) (not (native-label-var? self)))
    (let ((t (native-target gen self 's0)))
      (native-emit gen (list 'global-address 's2 (<ir-variable>-name self.parameters)))
      (native-emit gen (list 'load-at (native-size self) 's2 t))
      (native-out gen self t))))
;; a write stores at the size of the place it writes, not the value's: zero, an int, written to a pointer is the whole pointer
(define-method native-lower <ir-set-var> (gen)
  (let ((value (car self.operands)) (size (native-type-size (<ir-variable>-type self.parameters))))
    (native-lower value gen)
    (cond ((native-global? self)
	   (let ((r (native-into gen value 's0)))
	     (native-emit gen (list 'global-address 's2 (<ir-variable>-name self.parameters)))
	     (native-emit gen (list 'store-at size 's2 r))
	     (native-out gen self r)))
	  ((ir-struct-type? (<ir-insn>-type value)) (native-move gen value self))
	  (else (native-emit gen (list 'store size (native-slot-of self) (native-into gen value 's0)))))))
;; an integer or pointer cast: loaded at the source's size (sign-extended), stored at the target's (truncated); a cast to
;; or from a float converts, an integer through 64 bits
(define-function native-type-numeric-kind (type) (if (ir-floating-type? type) (if (= 4 (<ir-type>-size type)) 'f32 'f64) 's64))
(define-function native-numeric-kind (insn) (native-type-numeric-kind (<ir-insn>-type insn)))
;; an argument's place as it's passed: its own, or the slot of the type it's passed as, converted into
(define-function native-pass (gen arg)
  (let ((p (cdr (assq arg (<native-gen>-passing gen)))))
    (if (not p)
	(native-place arg)
      (let ((type (car p)) (slot (native-offset (cdr p))))
	(let ((r (native-into gen arg 's0)) (from (native-numeric-kind arg)) (to (native-type-numeric-kind type)))
	  (or (= from to) (let () (native-emit gen (list 'convert from to 's0 r)) (set r 's0)))
	  (native-emit gen (list 'store (native-type-size type) slot r)))
	(list (native-type-size type) slot (native-kind type))))))
;; the C library's floor, ceiling and square root, by their reserved names (as a C compiler's builtins), on a float:
;; a float operation, one instruction and exact, not a call
(define native-math-calls '((floorf . floor) (floor . floor) (ceilf . ceil) (ceil . ceil) (sqrtf . sqrt) (sqrt . sqrt)))
(define-function native-math-kind (call)	; the operation a call is, or ()
  (let ((callee (car (<ir-insn>-operands call))) (args (cdr (<ir-insn>-operands call))))
    (and (inherits-from (type-of callee) <ir-get-var>) (native-global? callee)
	 args (not (cdr args)) (native-float? (car args)) (native-float? call)
	 (= (native-width (car args)) (native-width call))
	 (cdr (assq (<ir-variable>-name (<ir-insn>-parameters callee)) native-math-calls)))))
(define-method native-calls? <ir-call> () (or (not (native-math-kind self)) (native-any-calls? self.operands)))	; floor and the like are instructions
(define-method native-lower <ir-call> (gen)
  (let ((kind (native-math-kind self)) (callee (car self.operands)) (args (cdr self.operands)))
    (if kind
	(let ((a (car args)))
	  (native-lower a gen)
	  (let ((r (native-into gen a 's0)))
	    (native-emit gen (list 'fop kind (native-width self) 's0 r r))
	    (native-out gen self 's0)))
      (native-lower callee gen)
      (list-do a args (native-lower a gen))
      (native-emit gen (list 'call (native-offset (<ir-insn>-location callee)) (native-named (native-prototype callee) (list-length args))
			     (map (lambda (a) (native-pass gen a)) args)
			     (and (not (= IR-VOID self.type)) (native-place self)))))))
(define-method native-lower <ir-let> (gen) (list-do expr self.operands (native-lower expr gen)))
(define-function native-binary (gen insn kind)
  (let ((a (car (<ir-insn>-operands insn))) (b (cadr (<ir-insn>-operands insn))))
    (native-lower a gen) (native-lower b gen)
    (let ((ra (native-into gen a 's0)) (rb (native-into gen b 's1)) (t (native-target gen insn 's0)))
      (native-emit gen (if (native-float? insn) (list 'fop kind (native-width insn) t ra rb) (list 'op kind t ra rb)))
      (native-out gen insn t))))
(define-method native-lower <ir-add> (gen) (native-binary gen self 'add))
(define-method native-lower <ir-sub> (gen) (native-binary gen self 'sub))
(define-method native-lower <ir-mul> (gen) (native-binary gen self 'mul))
(define-method native-lower <ir-div> (gen) (native-binary gen self 'div))
(define-method native-lower <ir-mod> (gen) (native-binary gen self 'mod))
(define-method native-lower <ir-bitand> (gen) (native-binary gen self 'and))
(define-method native-lower <ir-bitor> (gen) (native-binary gen self 'or))
(define-method native-lower <ir-bitxor> (gen) (native-binary gen self 'xor))
(define-method native-lower <ir-shl> (gen) (native-binary gen self 'shl))
(define-method native-lower <ir-shr> (gen) (native-binary gen self 'shr))
(define-method native-lower <ir-com> (gen)
  (let ((a (car self.operands)))
    (native-lower a gen)
    (let ((r (native-into gen a 's0)) (t (native-target gen self 's0)))
      (native-emit gen (list 'op 'com t r r))
      (native-out gen self t))))
(define-method native-lower <ir-cast> (gen)
  (let* ((a (car self.operands)) (from (native-numeric-kind a)) (to (native-numeric-kind self)))
    (native-lower a gen)
    (let* ((t (native-target gen self 's0)) (r (native-into gen a t)))	; held, or loaded, where the result goes
      (or (= from to) (let () (native-emit gen (list 'convert from to t r)) (set r t)))
      (native-out gen self r))))

;;; places: the address of what an instruction names into register s, for reading, writing or addressof
(define-function native-pointee-size (ptr) (<ir-type>-size (<ir-pointer-type>-referent (<ir-insn>-type ptr))))
(define-selector native-address (insn gen s) (error "native: no address for " insn))
(define-method native-address <ir-get-var> (gen s)
  (native-emit gen (if (native-global? self)
		       (list 'global-address s (<ir-variable>-name self.parameters))
		     (list 'address (native-offset (<ir-variable>-location self.parameters)) s))))
(define-method native-address <ir-insn> (gen s)	; a value in a slot of its own (a struct a call returned)
  (native-lower self gen)
  (native-emit gen (list 'address (native-offset self.location) s)))
(define-method native-address <ir-indir> (gen s)	; p + i * the element's size
  (let ((p (car self.operands)) (i (cadr self.operands)))
    (native-lower p gen) (native-lower i gen)
    (let ((rp (native-into gen p s)) (ri (native-into gen i 's3)))
      (native-emit gen (list 'constant 's4 (native-pointee-size p)))
      (native-emit gen (list 'op 'mul 's3 ri 's4))
      (native-emit gen (list 'op 'add s rp 's3)))))
(define-method native-address <ir-member> (gen s)	; a pointer's or a struct place's address, plus the field's offset
  (let* ((base (car self.operands))
	 (r (if (ir-pointer-type? (<ir-insn>-type base))
		(let () (native-lower base gen) (native-into gen base s))
	      (native-address base gen s) s)))
    (native-emit gen (list 'constant 's4 (<ir-struct-member>-offset (car self.parameters))))
    (native-emit gen (list 'op 'add s r 's4))))
(define-function native-read (gen insn)
  (native-address insn gen 's2)
  (let ((t (native-target gen insn 's0)))
    (native-emit gen (list 'load-at (native-size insn) 's2 t))
    (native-out gen insn t)))
;; an object instruction is what ir2 lowered it to, in eval.l's layout (doc/ir2-objects.md)
(define-method native-calls? <ir-object-insn> () (native-calls? self.lowered))	; what it lowers to may call (an allocation)
(define-method native-allocate <ir-object-insn> (gen)
  (native-allocate self.lowered gen)
  (set self.location (<ir-insn>-location self.lowered)))
(define-method native-lower <ir-object-insn> (gen) (native-lower self.lowered gen))
(define-method native-address <ir-object-insn> (gen s) (native-address self.lowered gen s))
(define-method native-lower <ir-indir> (gen) (native-read gen self))
(define-method native-lower <ir-member> (gen) (native-read gen self))
(define-method native-lower <ir-addressof> (gen)
  (native-address (car self.operands) gen 's2)
  (native-out gen self 's2))
;; a write: the value first, then the place's address, then the store; the value is the write's value
(define-function native-write (gen insn place value)
  (native-lower value gen)
  (native-address place gen 's2)
  (let ((r (native-into gen value 's0)))
    (native-emit gen (list 'store-at (native-size place) 's2 r))
    (native-out gen insn r)))
(define-function native-size-type (ptr) (<ir-pointer-type>-referent (<ir-insn>-type ptr)))
(define-method native-lower <ir-set-indir> (gen)
  (let ((p (car self.operands)) (i (cadr self.operands)) (value (caddr self.operands)))
    (native-write gen self (new <ir-indir> () (list p i) (native-size-type p) () ()) value)))
(define-method native-lower <ir-set-member> (gen)
  (let ((base (car self.operands)) (value (cadr self.operands)))
    (native-write gen self (new <ir-member> self.parameters (list base) (<ir-struct-member>-type (car self.parameters)) () ()) value)))
(define-method native-lower <ir-neg> (gen)
  (let ((a (car self.operands)))
    (native-lower a gen)
    (let ((t (native-target gen self 's0)))	; held only when a isn't (native-holds-result?)
      (if (native-float? self)
	  (let ((r (native-into gen a 's0))) (native-emit gen (list 'fop 'neg (native-width self) t r r)))
	(let ((r (native-into gen a 's1)))
	  (native-emit gen '(constant s0 0))
	  (native-emit gen (list 'op 'sub t 's0 r))))
      (native-out gen self t))))
(define-method native-lower <ir-nop> (gen) ())
;; comparisons: integers are signed, pointers unsigned
(define-function native-condition (kind insn)
  (if (ir-pointer-type? (<ir-insn>-type (car (<ir-insn>-operands insn))))
      (cdr (assq kind '((eq . eq) (ne . ne) (lt . lo) (le . ls) (gt . hi) (ge . hs))))
    kind))
(define-function native-relation (gen insn kind)
  (let ((a (car (<ir-insn>-operands insn))) (b (cadr (<ir-insn>-operands insn))))
    (native-lower a gen) (native-lower b gen)
    (let ((ra (native-into gen a 's0)) (rb (native-into gen b 's1)) (t (native-target gen insn 's0)))
      (native-emit gen (if (native-float? a)
			   (list 'fcompare kind (native-width a) t ra rb)
			 (list 'compare (native-condition kind insn) t ra rb)))
      (native-out gen insn t))))
(define-method native-lower <ir-eq> (gen) (native-relation gen self 'eq))
(define-method native-lower <ir-ne> (gen) (native-relation gen self 'ne))
(define-method native-lower <ir-lt> (gen) (native-relation gen self 'lt))
(define-method native-lower <ir-le> (gen) (native-relation gen self 'le))
(define-method native-lower <ir-gt> (gen) (native-relation gen self 'gt))
(define-method native-lower <ir-ge> (gen) (native-relation gen self 'ge))
(define-method native-lower <ir-not> (gen)
  (let ((a (car self.operands)))
    (native-lower a gen)
    (let ((r (native-into gen a 's0)) (t (native-target gen self 's0)))
      (native-emit gen '(constant s1 0))
      (native-emit gen (list 'compare 'eq t r 's1))
      (native-out gen self t))))
;; a value of 1 or 0 into an instruction's slot, when it has one
(define-function native-set (gen insn v)
  (unless (= IR-VOID (<ir-insn>-type insn))
    (native-emit gen (list 'constant 's0 v))
    (native-out gen insn 's0)))
;; a branch's value into the if's slot, unless the branch has none (it leaves the function, as exit does)
(define-function native-branch-value (gen insn branch valued)
  (and valued (not (= IR-VOID (<ir-insn>-type branch))) (native-move gen branch insn)))
(define-method native-lower <ir-if> (gen)
  (let ((test (car self.operands)) (then (cadr self.operands)) (else (caddr self.operands))
	(other (native-label gen)) (end (native-label gen)) (valued (not (= IR-VOID self.type))))
    (native-lower test gen)
    (native-emit gen (list 'branch-unless (native-into gen test 's0) other))
    (native-lower then gen)
    (native-branch-value gen self then valued)
    (native-emit gen (list 'branch end))
    (native-emit gen (list 'label other))
    (when else
      (native-lower else gen)
      (native-branch-value gen self else valued))
    (native-emit gen (list 'label end))))
(define-method native-lower <ir-while> (gen)
  (let ((test (car self.operands)) (body (cadr self.operands)) (top (native-label gen)) (end (native-label gen)))
    (native-emit gen (list 'label top))
    (native-lower test gen)
    (native-emit gen (list 'branch-unless (native-into gen test 's0) end))
    (native-lower body gen)
    (native-emit gen (list 'branch top))
    (native-emit gen (list 'label end))))
;; and: the first false operand decides it, 0; or: the first true one, 1
(define-function native-logical (gen insn decide decided)
  (let ((out (native-label gen)) (end (native-label gen)))
    (list-do opd (<ir-insn>-operands insn)	; an operand with no value (it leaves, as exit does) decides nothing
      (native-lower opd gen)
      (unless (= IR-VOID (<ir-insn>-type opd))
	(native-emit gen (list decide (native-into gen opd 's0) out))))
    (native-set gen insn (- 1 decided))
    (native-emit gen (list 'branch end))
    (native-emit gen (list 'label out))
    (native-set gen insn decided)
    (native-emit gen (list 'label end))))
(define-method native-lower <ir-logand> (gen) (native-logical gen self 'branch-unless 0))
(define-method native-lower <ir-logor> (gen) (native-logical gen self 'branch-if 1))
(define-method native-lower <ir-return> (gen)
  (let ((value (car self.operands)))
    (when value
      (native-lower value gen)
      (native-emit gen (cons 'result (native-place value))))
    (native-emit gen (list 'leave '*frame*))
    (native-emit gen '(return))))

;; a function's intents: its parameters' and instructions' slots above the outgoing arguments' area, then its code
(define-function native-function (self name args params body)
  (set (<native-gen>-name self) name)
  (set (<native-gen>-frame self) (ir-frame-new))
  (set (<native-gen>-intents self) ())
  (set (<native-gen>-outgoing self) 0)
  (set (<native-gen>-passing self) ())
  (set (<native-gen>-pending self) 0)
  (list-do bind params (set (<ir-variable>-location (cdr bind)) (native-slot self (<ir-variable>-type (cdr bind)))))
  (list-do arg args (native-by-value self (<ir-variable>-type (cdr (assq arg params))) "taken as" arg))
  (native-name-labels self params body)
  (list-do insn body (native-allocate insn self))
  (let* ((outgoing (align (<native-gen>-outgoing self) 16))
	 (size (align (ir-frame-finalise (<native-gen>-frame self) outgoing) 16))
	 (last ()))
    (native-emit self (list 'enter size outgoing))
    (native-emit self (list 'params (map (lambda (arg)	; in order: a scope's bindings are most recent first
					   (let* ((var (cdr (assq arg params))) (type (<ir-variable>-type var)))
					     (list (<ir-type>-size type) (native-offset (<ir-variable>-location var)) (native-kind type))))
					 args)))
    (list-do insn body (native-lower (set last insn) self))
    (unless (and last (ir-returns? last)) (native-emit self (list 'leave '*frame*)) (native-emit self '(return)))
    (set (<native-unit>-functions *native-unit*)
	 (cons (list name (map (lambda (x) (if (and (pair? x) (= '*frame* (cadr x))) (list (car x) size) x))
			       (list-reverse! (<native-gen>-intents self)))
		     size)
	       (<native-unit>-functions *native-unit*)))))

;;; the generator protocol
(define-method ir-gen-header <native-gen> () (set *native-unit* (new <native-unit> () ())))
(define-method ir-gen-declare-struct <native-gen> args ())
(define-method ir-gen-global-declaration <native-gen> (var)
  (let ((type (<ir-variable>-type var)))
    (set (<native-unit>-globals *native-unit*)
	 (cons (list (<ir-variable>-name var) (<ir-type>-size type) (<ir-type>-alignment type)) (<native-unit>-globals *native-unit*)))))
(define-method ir-gen-local-declaration <native-gen> args ())
(define-method ir-gen-preamble <native-gen> () (set self.inits ()))
(define-method ir-gen-initialisation <native-gen> (definition) (set self.inits (cons definition self.inits)))
(define-method ir-gen-output <native-gen> () ())
;; the globals' initialisations, as a function __init that native-install runs: main is a function, not a global
(define-method ir-gen-postamble <native-gen> ()
  (let ((setters ()))
    (list-do def (list-reverse self.inits)
      (let ((setter (car (<ir-define>-operands def))))	; a global with no initialiser stays zero
	(or (ir-nop? setter) (= 'main (<ir-variable>-name (<ir-set-var>-parameters setter))) (push setters setter))))
    (native-function self '__init () () (list-reverse! setters))))
(define-method ir-gen-function-implementation <native-gen> (value)
  (set self.name (car (<ir-function>-parameters value)))
  (native-by-value self (<ir-function-type>-ret-type (<ir-pointer-type>-referent (<ir-insn>-type value))) "returned from" self.name)
  (native-function self (car (<ir-function>-parameters value)) (cadr (<ir-function>-parameters value))
		   (<ir-scope>-bindings (<ir-function>-scope value)) (<ir-function>-operands value)))
