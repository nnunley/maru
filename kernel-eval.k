;;; The kernel's environments, expand, encode, eval and apply (doc/kernel.md), as eval3's (eval3.c:440-520, 1091-1330,
;;; 1494-1700).  Environments are alists, a namespace's head a binding whose tail is the namespace itself; a <fixed>
;;; takes its arguments unevaluated; an <expr> binds its formals onto the environment it closed over; a <subr> is called
;;; through its imp; any other type through its *applicators* entry.  eval3's *evaluators*, *expanders* and *encoders*
;;; hooks stay commented out, as in eval3: an unknown type cannot be evaluated.

(define (k_globalNamespace	oop)	0)
(define (k_globals		oop)	0)	; the bindings of *globals* … *output*, each (name . value)
(define (k_expanders		oop)	0)
(define (k_encoders		oop)	0)
(define (k_evaluators		oop)	0)
(define (k_applicators		oop)	0)
(define (k_backtrace		oop)	0)
(define (k_input		oop)	0)
(define (k_output		oop)	0)
(define (k_traceStack		oop)	0)	; the expressions being evaluated, for fatal's backtrace
(define (k_traceDepth		long)	0)
(define (k_globalCache		oop)	0)	; the global namespace's bindings by a name's address, eval3's _globalCache
(define (k_globalCacheSize	long)	2003)
(define (k_encodeIndent		long)	16)
(define (s_locals	oop)	0)
(define (s_set		oop)	0)
(define (s_define	oop)	0)
(define (s_let		oop)	0)
(define (s_lambda	oop)	0)
(define (s_t		oop)	0)
(define (s_etc		oop)	0)

(define-function k_getVar oop ((binding oop))	(return (k_cdr binding)))	; eval3's getVar: a binding's value

;;; fatal errors: the message and its objects, then the backtrace, then exit (eval3.c:1494).  Printed to stdout until
;;; Task 6 gives the printer a stream (eval3 writes the message to stderr)

(define-function k_fatalBegin void ((message char *))	(printf "\nerror: %s" message))

;; a source's path:line, its width answered (eval3's fprintSource)
(define-function k_printSource int ((src oop))
  (if (= src (cast 0 oop)) (return 0))
  (return (printf "%ls:%ld" (<string>-bits (k_car src)) (k_getLong (k_cdr src)))))

;; an expression's source, (path . line), when it has one (eval3's getSource)
(define-function k_getSource oop ((exp oop))
  (if (object-is <pair> exp)
      (let (((src oop) (<pair>-source exp)))
	(if (and (object-is <string> (k_car src)) (object-is <long> (k_cdr src))) (return src))))
  (return (cast 0 oop)))

(define-function k_fatalEnd void ()
  (printf "\n")
  (let (((tracer oop) (k_getVar k_backtrace)))
    (if (!= tracer (cast 0 oop))
	(let (((args oop) (k_newLong k_traceDepth)))
	  (gc-protect (args)
	    (set args (k_cons args (cast 0 oop)))
	    (set args (k_cons k_traceStack args))
	    (k_apply tracer args (cast 0 oop))))
      (if k_traceDepth
	  (let (((i long) k_traceDepth)
		((j int) 12)
		((l int) 0)
		((exp oop) (cast 0 oop)))
	    (while (> i 0)
	      (set i (- i 1))
	      (set exp (k_arrayAt k_traceStack i))
	      (printf "\033[32m\033[?7l")
	      (set l (k_printSource (k_getSource exp)))
	      (if (>= l j) (set j l))
	      (if (= l 0) (while (< l 3) (set l (+ l 1)) (printf ".")))
	      (while (< l j) (set l (+ l 1)) (printf " "))
	      (set l (+ l 1))
	      (printf "\033[0m ")
	      (k_dumpln exp)
	      (printf "\033[?7h")))
	(printf "no backtrace\n"))))
  (exit 1))

;;; environments (eval3.c:440-520)

;; the namespace env is in: the first binding whose tail is the rest of the alist from it
(define-function k_findEnvironment oop ((env oop))
  (while (object-is <pair> env)
    (let (((ass oop) (<pair>-head env)))
      (if (and (object-is <pair> ass) (= (<pair>-tail ass) env)) (return env)))
    (set env (<pair>-tail env)))
  (return (cast 0 oop)))

(define-function k_findVariable2 oop ((env oop) (name oop))
  (while (!= env (cast 0 oop))
    (let (((ass oop) (<pair>-head env)))
      (if (= name (k_car ass)) (return ass)))
    (set env (<pair>-tail env)))
  (return (cast 0 oop)))

;; a name's slot in the global cache: its address modulo the cache's size
(define-function k_globalHash long ((name oop))	(return (% (cast name long) k_globalCacheSize)))

;; name's binding in env, the global namespace's through the cache
(define-function k_findVariable oop ((env oop) (name oop))
  (while (!= env (cast 0 oop))
    (if (= env k_globalNamespace)
	(let* (((hash long) (k_globalHash name))
	       ((ent oop) (k_arrayAt k_globalCache hash)))
	  (if (and (!= ent (cast 0 oop)) (= name (<pair>-head ent))) (return ent))
	  (return (k_arrayAtPut k_globalCache hash (k_findVariable2 env name)))))
    (let (((ass oop) (<pair>-head env)))
      (if (= name (k_car ass)) (return ass)))
    (set env (<pair>-tail env)))
  (return (cast 0 oop)))

;; name's binding in env's own namespace, not those it nests in
(define-function k_findNamespaceVariable oop ((env oop) (name oop))
  (let (((beg oop) (k_findEnvironment env))
	((end oop) (k_findEnvironment (k_cdr env))))
    (while (!= beg end)
      (if (= beg k_globalNamespace)
	  (let* (((hash long) (k_globalHash name))
		 ((ent oop) (k_arrayAt k_globalCache hash)))
	    (if (and (!= ent (cast 0 oop)) (= name (<pair>-head ent))) (return ent))
	    (return (k_arrayAtPut k_globalCache hash (k_findVariable2 env name)))))
      (let (((ass oop) (k_car beg)))
	(if (= name (k_car ass)) (return ass)))
      (set beg (<pair>-tail beg))))
  (return (cast 0 oop)))

(define-function k_lookup oop ((env oop) (name oop))	(return (k_cdr (k_findVariable env name))))

;; a new binding of name to value at the front of env's namespace, after its head; answers the binding
(define-function k_define oop ((env oop) (name oop) (value oop))
  (let (((binding oop) (cast 0 oop)))
    (set env (k_findEnvironment env))
    (if (= env (cast 0 oop)) (let () (k_fatalBegin "failed to find an environment") (k_fatalEnd)))
    (gc-protect (env name value binding)
      (set binding (k_cons (cast 0 oop) (<pair>-tail env)))
      (set (<pair>-tail env) binding)
      (set (<pair>-head binding) (k_cons name value)))
    (return (<pair>-head binding))))	; the binding, (name . value), as eval3's setHead answers it

;;; expand (eval3.c:1091-1210)

;; head's elements before tail, copied with their sources (eval3's concat)
(define-function k_concat oop ((head oop) (tail oop))
  (if (not (object-is <pair> head)) (return tail))
  (gc-protect (head)
    (set tail (k_concat (<pair>-tail head) tail))
    (set tail (k_newPairFrom (<pair>-head head) tail head)))
  (return tail))

;; src as the source of obj and of every pair in it that has none (eval3's setSource; the reader has k_setSource)
(define-function k_setSourceOf void ((obj oop) (src oop))
  (if (object-is <pair> obj)	; no bare (return): native lowering refuses one in a void function
      (let ()
	(if (= (<pair>-source obj) (cast 0 oop)) (set (<pair>-source obj) src))
	(k_setSourceOf (<pair>-head obj) src)
	(k_setSourceOf (<pair>-tail obj) src))))

;; the function of the <form> var is bound to, or nil
(define-function k_findFormFunction oop ((env oop) (var oop))
  (if (not (object-is <symbol> var)) (return (cast 0 oop)))
  (set var (k_findVariable env var))
  (if (= var (cast 0 oop)) (return (cast 0 oop)))
  (set var (k_getVar var))
  (if (not (object-is <form> var)) (return (cast 0 oop)))
  (return (<form>-function var)))

;; the symbol function of the <form> var is bound to, or nil
(define-function k_findFormSymbol oop ((env oop) (var oop))
  (set var (k_findVariable env var))
  (if (= var (cast 0 oop)) (return (cast 0 oop)))
  (set var (k_getVar var))
  (if (not (object-is <form> var)) (return (cast 0 oop)))
  (return (<form>-symbol var)))

;; the symbol set-NAME, for (set (NAME ...) ...)
(define-function k_setterName oop ((name oop))
  (let (((p int32 *) (<symbol>-bits name)))
    (k_bufferReset)
    (k_bufferAppend 115) (k_bufferAppend 101) (k_bufferAppend 116) (k_bufferAppend 45)	; "set-"
    (while (!= 0 (indir p 0))
      (k_bufferAppend (cast (indir p 0) long))
      (set p (+ p (sizeof int32))))	; ir2 steps a pointer in bytes
    (return (k_intern (k_bufferContents)))))

(define-function k_expand oop ((expr oop) (env oop))
  (let (((head oop) (cast 0 oop))
	((tail oop) (cast 0 oop))
	((form oop) (cast 0 oop))
	((result oop) expr))
    (gc-protect (expr env head tail)
      (if (object-is <pair> expr)
	  (let ()
	    (set head (k_expand (<pair>-head expr) env))
	    (set form (k_findFormFunction env head))
	    (if (!= form (cast 0 oop))
		(let ()
		  (set head (k_apply form (<pair>-tail expr) env))
		  (set head (k_expand head env))
		  (k_setSourceOf head (<pair>-source expr))
		  (set result head))
	      (let ()
		(set tail (<pair>-tail expr))
		(if (!= s_quote head) (set tail (k_exlist tail env)))
		(if (and (= s_set head) (object-is <pair> (k_car tail)) (object-is <symbol> (k_caar tail)))
		    (let ()
		      (set head (k_setterName (<pair>-head (<pair>-head tail))))
		      (set tail (k_concat (<pair>-tail (<pair>-head tail)) (<pair>-tail tail)))))
		(set result (k_newPairFrom head tail expr)))))
	(if (object-is <symbol> expr)
	    (let ()
	      (set form (k_findFormSymbol env expr))
	      (if (!= form (cast 0 oop))
		  (let ()
		    (set tail (k_cons expr (cast 0 oop)))
		    (set tail (k_apply form tail (cast 0 oop)))
		    (set tail (k_expand tail env))
		    (k_setSourceOf tail expr)
		    (set result tail)))))))
    (return result)))

(define-function k_exlist oop ((list oop) (env oop))
  (if (not (object-is <pair> list)) (return (k_expand list env)))
  (let (((head oop) (cast 0 oop))
	((tail oop) (cast 0 oop)))
    (gc-protect (list env head tail)
      (set head (k_expand (<pair>-head list) env))
      (set tail (k_exlist (<pair>-tail list) env))
      (set head (k_newPairFrom head tail list)))
    (return head)))

;;; encode (eval3.c:1212-1320): warnings about names not bound and calls whose arguments don't match their function's
;;; formals.  Printed to stdout until Task 6 gives the printer a stream (eval3 writes them to stderr)

;; from's source, padded to the widest so far
(define-function k_encodeWhere void ((from oop))
  (let (((src oop) (k_getSource from)))
    (if (!= src (cast 0 oop))
	(let (((i long) (cast (k_printSource src) long)))
	  (if (> i k_encodeIndent) (set k_encodeIndent i))
	  (while (<= i k_encodeIndent) (set i (+ i 1)) (printf " "))))))

;; a binding of id, with no value yet, onto env
(define-function k_encodeBind oop ((id oop) (env oop))
  (gc-protect (id env)
    (set env (k_cons (cast 0 oop) env))
    (set (<pair>-head env) (k_cons id (cast 0 oop))))
  (return env))

;; a parameter's name: the innermost head of a parameter written as a list
(define-function k_encodeName oop ((id oop))
  (while (object-is <pair> id) (set id (k_car id)))
  (return id))

(define-function k_encodeFrom oop ((from oop) (obj oop) (env oop))
  (gc-protect (from obj env)
    (if (object-is <symbol> obj)
	(if (= (k_findVariable env obj) (cast 0 oop))
	    (let (((flags int) (<symbol>-flags obj)))
	      (if (= 0 (& 1 flags))
		  (let ()
		    (set (<symbol>-flags obj) (| 1 flags))
		    (k_encodeWhere from)
		    (printf "warning: possibly undefined: ")
		    (k_dumpln obj)))))
      (if (object-is <pair> obj)
	  (let (((head oop) (<pair>-head obj))
		((bindings oop) (cast 0 oop)))
	    (if (= head s_quote)
		(let ())
	      (if (= head s_define)
		  (let ()
		    (set env (k_encodeBind (k_cadr obj) env))
		    (k_enlist (k_cddr obj) env))
		(if (= head s_lambda)
		    (let ()
		      (set bindings (k_cadr obj))
		      (while (object-is <pair> bindings)
			(set env (k_encodeBind (k_encodeName bindings) env))
			(set bindings (<pair>-tail bindings)))
		      (if (object-is <symbol> bindings) (set env (k_encodeBind bindings env)))
		      (k_enlist (k_cddr obj) env))
		  (if (= head s_let)
		      (let ()
			(set bindings (k_cadr obj))
			(while (object-is <pair> bindings)
			  (k_enlist (k_cdar bindings) env)
			  (set bindings (<pair>-tail bindings)))
			(set bindings (k_cadr obj))
			(while (object-is <pair> bindings)
			  (set env (k_encodeBind (k_encodeName bindings) env))
			  (set bindings (<pair>-tail bindings)))
			(k_enlist (k_cddr obj) env))
		    (let ()
		      (k_enlist obj env)
		      (if (object-is <symbol> head) (k_encodeArity from obj head)))))))))))
  (return obj))

;; a warning when obj's arguments don't match the formals of the global <expr> head names
(define-function k_encodeArity void ((from oop) (obj oop) (head oop))
  (let (((val oop) (k_lookup (k_getVar k_globals) head))
	((formal oop) (cast 0 oop))
	((actual oop) (cast 0 oop)))
    (if (object-is <expr> val)
	(let ()
	  (set formal (k_car (<expr>-definition val)))
	  (set actual (k_cdr obj))
	  (while (and (object-is <pair> formal) (object-is <pair> actual))
	    (if (= s_etc (k_car formal))
		(let () (set formal (cast 0 oop)) (set actual (cast 0 oop)))
	      (let () (set formal (k_cdr formal)) (set actual (k_cdr actual)))))
	  (if (object-is <symbol> formal) (let () (set formal (cast 0 oop)) (set actual (cast 0 oop))))
	  (if (or (!= formal (cast 0 oop)) (!= actual (cast 0 oop)))
	      (let ()
		(if (!= (k_getSource obj) (cast 0 oop)) (k_encodeWhere from))
		(printf "warning: argument mismatch: ")
		(k_dump obj)
		(printf " -> ")
		(k_dumpln (k_car (<expr>-definition val)))))))))

(define-function k_encode oop ((obj oop) (env oop))	(return (k_encodeFrom (cast 0 oop) obj env)))

(define-function k_enlist oop ((obj oop) (env oop))
  (while (object-is <pair> obj)
    (k_encodeFrom obj (<pair>-head obj) env)
    (set obj (<pair>-tail obj)))
  (return obj))

;;; eval and apply (eval3.c:1545-1700)

(define-function k_eval oop ((obj oop) (env oop))
  (let (((result oop) obj)
	((head oop) (cast 0 oop))
	((args oop) (cast 0 oop))
	((type long) (object-type obj)))
    (type-case type
      (0) (2) (3) (4) (10) (12) (11)		; undefined, long, double, string, form, subr, fixed: themselves
      (6 (k_arrayAtPut k_traceStack k_traceDepth obj)
	 (set k_traceDepth (+ k_traceDepth 1))
	 (gc-protect (obj env head args)
	   (set head (k_eval (<pair>-head obj) env))
	   (if (object-is <fixed> head)
	       (set head (k_apply (<fixed>-function head) (<pair>-tail obj) env))
	     (let ()
	       (set args (k_evlist (<pair>-tail obj) env))
	       (set head (k_apply head args env)))))
	 (set k_traceDepth (- k_traceDepth 1))
	 (set result head))
      (5 (let (((ass oop) (k_findVariable env obj)))
	   (if (= ass (cast 0 oop)) (let () (k_fatalBegin "eval: undefined variable: ") (k_dump obj) (k_fatalEnd)))
	   (set result (<pair>-tail ass))))
      (else (printf "\nerror: cannot eval (%d): " (cast type int)) (k_dump obj) (k_fatalEnd)))
    (return result)))

(define-function k_evlist oop ((obj oop) (env oop))
  (if (not (object-is <pair> obj)) (return obj))
  (let (((head oop) (cast 0 oop))
	((tail oop) (cast 0 oop)))
    (gc-protect (obj env head tail)
      (set head (k_eval (<pair>-head obj) env))
      (set tail (k_evlist (<pair>-tail obj) env))
      (set head (k_cons head tail)))
    (return head)))

;; fun applied to arguments, already evaluated unless fun is a <fixed>'s function
(define-function k_apply oop ((fun oop) (arguments oop) (env oop))
  (let (((result oop) (cast 0 oop))
	((type long) (object-type fun)))
    (type-case type
      (9 (set result (k_applyExpr fun arguments env)))
      (11 (set result (k_apply (<fixed>-function fun) arguments env)))
      (12 (if (!= (<subr>-sig fun) (cast 0 void *))	; a foreign function, called through libffi: Task 5
	      (let () (k_fatalBegin "apply: a foreign subr, which the kernel can't call yet: ") (k_dump fun) (k_fatalEnd)))
	  (set result ((<subr>-imp fun) arguments env)))
      (else (let (((ap oop) (k_arrayAt (k_getVar k_applicators) type)))
	      (if (= ap (cast 0 oop)) (let () (k_fatalBegin "error: cannot apply: ") (k_dump fun) (k_fatalEnd)))
	      (gc-protect (arguments)
		(set arguments (k_cons fun arguments))
		(set result (k_apply ap arguments env))))))
    (return result)))

;; an <expr>'s body evaluated with its formals bound to arguments, onto the environment it closed over
(define-function k_applyExpr oop ((fun oop) (arguments oop) (env oop))
  (let (((defn oop) (<expr>-definition fun))
	((formals oop) (cast 0 oop))
	((actuals oop) arguments)
	((caller oop) env)
	((callee oop) (<expr>-environment fun))
	((tmp oop) (cast 0 oop))
	((ans oop) (cast 0 oop))
	((body oop) (cast 0 oop)))
    (gc-protect (fun arguments defn caller callee tmp)
      (set formals (k_car defn))
      (while (object-is <pair> formals)
	(if (not (object-is <pair> actuals))
	    (let () (k_fatalBegin "too few arguments applying ") (k_dump fun) (printf " to ") (k_dump arguments) (k_fatalEnd)))
	(set tmp (k_cons (<pair>-head formals) (<pair>-head actuals)))
	(set callee (k_cons tmp callee))
	(set formals (<pair>-tail formals))
	(set actuals (<pair>-tail actuals)))
      (if (object-is <symbol> formals)
	  (let ()
	    (set tmp (k_cons formals actuals))
	    (set callee (k_cons tmp callee))
	    (set actuals (cast 0 oop))))
      (if (!= actuals (cast 0 oop))
	  (let () (k_fatalBegin "too many arguments applying ") (k_dump fun) (printf " to ") (k_dump arguments) (k_fatalEnd)))
      (set body (k_cdr defn))
      (while (object-is <pair> body)
	(set ans (k_eval (<pair>-head body) callee))
	(set body (<pair>-tail body))))
    (return ans)))

;;; the globals, as eval3's main makes them (eval3.c:3500-3560)

(define-function k_rootedSymbol oop ((place oop *) (name char *))
  (gc_push_root (cast place void *))
  (set (indir place 0) (k_internC name))
  (return (indir place 0)))

(define-function k_initEval void ()
  (gc_push_root (cast (addressof k_globalCache) void *))
  (set k_globalCache (k_newArray k_globalCacheSize))
  (k_rootedSymbol (addressof s_locals) "*locals*")
  (k_rootedSymbol (addressof s_set) "set")
  (k_rootedSymbol (addressof s_define) "define")
  (k_rootedSymbol (addressof s_let) "let")
  (k_rootedSymbol (addressof s_lambda) "lambda")
  (k_rootedSymbol (addressof s_t) "t")
  (k_rootedSymbol (addressof s_etc) "...")
  (gc_push_root (cast (addressof k_globalNamespace) void *))
  (set k_globalNamespace (k_cons (k_internC "*global-namespace*") (cast 0 oop)))
  (set (<pair>-tail k_globalNamespace) (k_cons k_globalNamespace (cast 0 oop)))
  (gc_push_root (cast (addressof k_globals) void *))	(set k_globals	(k_define k_globalNamespace (k_internC "*globals*") k_globalNamespace))
  (gc_push_root (cast (addressof k_expanders) void *))	(set k_expanders	(k_define k_globalNamespace (k_internC "*expanders*") (cast 0 oop)))
  (gc_push_root (cast (addressof k_encoders) void *))	(set k_encoders	(k_define k_globalNamespace (k_internC "*encoders*") (cast 0 oop)))
  (gc_push_root (cast (addressof k_evaluators) void *))	(set k_evaluators	(k_define k_globalNamespace (k_internC "*evaluators*") (cast 0 oop)))
  (gc_push_root (cast (addressof k_applicators) void *))	(set k_applicators	(k_define k_globalNamespace (k_internC "*applicators*") (cast 0 oop)))
  (gc_push_root (cast (addressof k_traceStack) void *))	(set k_traceStack	(k_newArray 32))
  (gc_push_root (cast (addressof k_backtrace) void *))	(set k_backtrace	(k_define k_globalNamespace (k_internC "*backtrace*") (cast 0 oop)))
  (gc_push_root (cast (addressof k_input) void *))	(set k_input	(k_define k_globalNamespace (k_internC "*input*") (cast 0 oop)))
  (gc_push_root (cast (addressof k_output) void *))	(set k_output	(k_define k_globalNamespace (k_internC "*output*") (cast 0 oop))))
