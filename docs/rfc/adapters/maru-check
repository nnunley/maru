#!/usr/bin/env bash
# maru-check — evidence adapter: the block lists check/check.l case names,
# one per line. Conforms when `./eval check/check.l NAME...`, run from the
# repo root, exits 0 and prints "PASS NAME" for every name.
set -u
f="${1:?usage: maru-check <file>}"
root="$(cd "$(dirname "$0")/../../.." && pwd)"
names=$(grep -v '^[[:space:]]*$' "$f")
out=$(cd "$root" && ./eval check/check.l $names 2>&1) || { printf '%s\n' "$out" | tail -5; exit 1; }
for n in $names; do
    printf '%s\n' "$out" | grep -qx "PASS $n" || { echo "maru-check: no PASS for $n"; exit 1; }
done
