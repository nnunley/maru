#!/usr/bin/env bash
# maru-check — evidence adapter: the block lists check/check.l case names,
# one per line. Conforms when `make check CHECKS="NAME..."`, run from the
# repo root, exits 0 and prints "PASS NAME" for every name. Through make,
# so the libraries a case opens (build/sat.dylib ...) are built first.
set -u
f="${1:?usage: maru-check <file>}"
root="$(cd "$(dirname "$0")/../../.." && pwd)"
names=$(grep -v '^[[:space:]]*$' "$f")
out=$(cd "$root" && nice make -s check CHECKS="$(echo $names)" 2>&1) || { printf '%s\n' "$out" | tail -5; exit 1; }
for n in $names; do
    printf '%s\n' "$out" | grep -qx "PASS $n" || { echo "maru-check: no PASS for $n"; exit 1; }
done
