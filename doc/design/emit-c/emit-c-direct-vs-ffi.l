;;; emit-c-direct-vs-ffi.l - Direct C linking vs FFI comparison
;;;
;;; When generating C, we have two options:
;;; 1. Direct linking (compile-time) - MUCH better!
;;; 2. FFI (runtime) - only needed for dynamic loading

(println "=== DIRECT C LINKING VS FFI ===")
(println)

;;; ================================================================
;;; DIRECT C LINKING (PREFERRED FOR C GENERATION)
;;; ================================================================

(println "=== 1. DIRECT C LINKING - THE BETTER WAY ===")
(println)
(println "When generating C, we can link directly at compile time!")
(println)

;;; Direct extern declaration
(println "=== 1.1 DIRECT EXTERN SYNTAX ===")
(println)
(println "Maru declaration:")
(println "  (extern sqrt double (double))     ; Direct C function")
(println "  (extern printf int (string ...))  ; Variadic function")
(println "  (extern malloc pointer (long))    ; Returns pointer")
(println)
(println "Generates simple C:")
(println "  /* Direct C declarations */")
(println "  extern double sqrt(double);")
(println "  extern int printf(const char*, ...);")
(println "  extern void* malloc(size_t);")
(println)
(println "That's it! No wrappers, no overhead!")
(println)

;;; Direct function calls
(println "=== 1.2 DIRECT FUNCTION CALLS ===")
(println)
(println "Maru code:")
(println "  (define (calculate-distance x y)")
(println "    (sqrt (+ (* x x) (* y y))))")
(println)
(println "Generates optimal C:")
(println "  static oop calculate_distance(oop x, oop y) {")
(println "      double dx = getDouble(x);")
(println "      double dy = getDouble(y);")
(println "      double result = sqrt(dx * dx + dy * dy);")
(println "      return newDouble(result);")
(println "  }")
(println)
(println "NO FFI overhead! Direct C function call!")
(println)

;;; Type conversion strategy
(println "=== 1.3 TYPE CONVERSION STRATEGY ===")
(println)
(println "(define-method compile-extern-call <symbol>")
(println "  '(self args backend)")
(println "  '((let ((port (<c-backend>-output-port backend))")
(println "          (sig (get-extern-signature self)))")
(println "      ;; Check return type for conversion")
(println "      (case (extern-return-type sig)")
(println "        ((double)")
(println "         (port-write port \"newDouble(\"))")
(println "        ((long int)")
(println "         (port-write port \"newLong(\"))")
(println "        ((string)")
(println "         (port-write port \"newString(\"))")
(println "        ((void)")
(println "         (port-write port \"(\"))))")
(println "      ")
(println "      ;; Direct C function call")
(println "      (port-write port (symbol->string self) \"(\")")
(println "      ")
(println "      ;; Convert arguments")
(println "      (let ((first #t))")
(println "        (list-do arg args")
(println "          (if first")
(println "              (set first #f)")
(println "              (port-write port \", \"))")
(println "          (compile-c-argument arg (nth sig.arg-types i) backend)))")
(println "      ")
(println "      (port-write port \")\")")
(println "      ")
(println "      ;; Close conversion wrapper if needed")
(println "      (if (!= (extern-return-type sig) 'void)")
(println "          (port-write port \")\")))))")
(println)

;;; Structure access
(println "=== 1.4 C STRUCTURE ACCESS ===")
(println)
(println "For C structures, generate direct access:")
(println)
(println "Maru declaration:")
(println "  (extern-struct FILE")
(println "    (fd int)")
(println "    (buffer pointer)")
(println "    (size long))")
(println)
(println "Generates:")
(println "  /* Direct structure access macros */")
(println "  #define FILE_fd(f) (((FILE*)getPointer(f))->fd)")
(println "  #define FILE_buffer(f) (((FILE*)getPointer(f))->buffer)")
(println "  #define FILE_size(f) (((FILE*)getPointer(f))->size)")
(println)

;;; ================================================================
;;; WHEN FFI IS STILL NEEDED
;;; ================================================================

(println "=== 2. WHEN DO WE NEED FFI? ===")
(println)
(println "FFI is only needed for:")
(println "1. Runtime dynamic loading (dlopen)")
(println "2. Plugin systems")
(println "3. Optional libraries")
(println "4. User-provided function pointers")
(println)

(println "Example - Runtime plugin loading:")
(println "  (define plugin (dlopen \"./myplugin.so\"))")
(println "  (define func (dlsym plugin \"process\"))")
(println "  (ffi-call func \"int(string)\" \"data\")")
(println)
(println "This REQUIRES FFI because we don't know the function at compile time!")
(println)

;;; ================================================================
;;; PROFILING WITHOUT FFI
;;; ================================================================

(println "=== 3. PROFILING WITH DIRECT C ===")
(println)
(println "Profiling also benefits from direct C generation:")
(println)

(println "=== 3.1 INLINE PROFILING MACROS ===")
(println)
(println "Instead of FFI overhead, generate inline macros:")
(println)
(println "  #ifdef ENABLE_PROFILING")
(println "    static uint64_t prof_fibonacci_calls = 0;")
(println "    static uint64_t prof_fibonacci_time = 0;")
(println "    #define PROF_FIBONACCI_ENTER() \\")
(println "      uint64_t _start = get_nanotime(); \\")
(println "      prof_fibonacci_calls++;")
(println "    #define PROF_FIBONACCI_EXIT() \\")
(println "      prof_fibonacci_time += get_nanotime() - _start;")
(println "  #else")
(println "    #define PROF_FIBONACCI_ENTER()")
(println "    #define PROF_FIBONACCI_EXIT()")
(println "  #endif")
(println)

(println "=== 3.2 COMPILE-TIME PROFILING INSTRUMENTATION ===")
(println)
(println "(define-method compile-profiled-function-direct <list>")
(println "  '(self backend)")
(println "  '((let ((name (second self))")
(println "          (params (third self))")
(println "          (body (fourth self))")
(println "          (port (<c-backend>-output-port backend)))")
(println "      ;; Generate static profiling variables")
(println "      (port-write port \"#ifdef ENABLE_PROFILING\\n\")")
(println "      (port-write port \"static uint64_t prof_\" name \"_calls = 0;\\n\")")
(println "      (port-write port \"static uint64_t prof_\" name \"_time = 0;\\n\")")
(println "      (port-write port \"#endif\\n\\n\")")
(println "      ")
(println "      ;; Generate function with inline profiling")
(println "      (port-write port \"static oop \" name \"(\")")
(println "      (compile-parameters params backend)")
(println "      (port-write port \") {\\n\")")
(println "      (port-write port \"    PROF_\" (upcase name) \"_ENTER();\\n\")")
(println "      (port-write port \"    oop result = \")")
(println "      (compile-to-c body backend)")
(println "      (port-write port \";\\n\")")
(println "      (port-write port \"    PROF_\" (upcase name) \"_EXIT();\\n\")")
(println "      (port-write port \"    return result;\\n\")")
(println "      (port-write port \"}\\n\"))))")
(println)

