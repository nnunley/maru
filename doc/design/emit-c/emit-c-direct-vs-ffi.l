;;; ================================================================
;;; SIMPLIFIED EXTERN IMPLEMENTATION
;;; ================================================================

(println "=== 6. SIMPLE EXTERN FOR EMIT-C.L ===")
(println)
(println "(define-structure <extern-function>")
(println "  (name          ; C function name")
(println "   return-type   ; Return type")
(println "   arg-types))   ; Argument types")
(println)
(println "(define-method compile-to-c <extern-call>")
(println "  '(self backend)")
(println "  '((let ((func (car self))")
(println "          (args (cdr self))")
(println "          (port (<c-backend>-output-port backend))")
(println "          (sig (lookup-extern func)))")
(println "      ;; Return type conversion")
(println "      (compile-return-wrapper sig.return-type port)")
(println "      ;; Direct C call")
(println "      (port-write port func \"(\")")
(println "      ;; Arguments with conversion")
(println "      (compile-arguments-with-types args sig.arg-types backend)")
(println "      (port-write port \")\")")
(println "      ;; Close wrapper")
(println "      (close-return-wrapper sig.return-type port))))")
(println)

(println "=== CONCLUSION ===")
(println)
(println "When generating C code:")
(println "• Use DIRECT C linking - it's faster and simpler!")
(println "• FFI only for runtime dynamic loading")
(println "• Profiling through compile-time instrumentation")
(println "• Let the C compiler do its job!")
(println)
(println "This gives us:")
(println "• Native C performance")
(println "• Simple generated code")
(println "• No runtime overhead")
(println "• Better debugging experience")
(println "• Smaller executables")
(println)
