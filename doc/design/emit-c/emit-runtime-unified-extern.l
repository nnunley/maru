;;; ================================================================
;;; EXECUTION CONTEXT DETERMINES STRATEGY
;;; ================================================================

(println "=== 2. CONTEXT-BASED STRATEGY ===")
(println)
(println "┌────────────────────┬─────────────────────┬──────────────────────┐")
(println "│ Execution Context  │ Strategy            │ Implementation       │")
(println "├────────────────────┼─────────────────────┼──────────────────────┤")
(println "│ emit-c compilation │ Direct C calls      │ Zero overhead        │")
(println "│ emit-asm           │ Direct asm calls    │ Native performance   │")
(println "│ Runtime eval       │ Environment lookup  │ Fast if found        │")
(println "│ Runtime eval       │ FFI bridge          │ If not in env        │")
(println "└────────────────────┴─────────────────────┴──────────────────────┘")
(println)

;;; Extern structure (unified)
(println "=== 2.1 UNIFIED EXTERN STRUCTURE ===")
(println)
(println "(define-structure <extern-function>")
(println "  (name           ; Function name (symbol)")
(println "   return-type    ; Return type")
(println "   arg-types))    ; Argument types")
(println)
(println ";; Single declaration creates this structure")
(println ";; Execution context determines how it's used")
(println)

;;; ================================================================
;;; EMIT-C STRATEGY: DIRECT C CALLS
;;; ================================================================

(println "=== 3. EMIT-C: DIRECT C GENERATION ===")
(println)
(println "(define-method compile-to-c <extern-function>")
(println "  '(self backend)")
(println "  '((let ((port (<c-backend>-output-port backend))")
(println "          (name (<extern-function>-name self))")
(println "          (ret-type (<extern-function>-return-type self)))")
(println "      ;; Generate direct C call")
(println "      (compile-return-wrapper ret-type port)")
(println "      (port-write port (symbol->string name) \"(\")")
(println "      ;; Arguments are compiled separately")
(println "      (port-write port \")\")")
(println "      (close-return-wrapper ret-type port))))")
(println)

(println "=== 3.1 EMIT-C CALL COMPILATION ===")
(println)
(println "(define-method compile-to-c <list>")
(println "  '(self backend)")
(println "  '((if (and (symbol? (car self))")
(println "             (extern-function? (lookup-extern (car self))))")
(println "        ;; This is an extern call - compile directly")
(println "        (let ((extern (lookup-extern (car self)))")
(println "              (args (cdr self))")
(println "              (port (<c-backend>-output-port backend)))")
(println "          ;; Return type wrapper")
(println "          (compile-return-wrapper (<extern-function>-return-type extern) port)")
(println "          ;; Direct function name")
(println "          (port-write port (symbol->string (car self)) \"(\")")
(println "          ;; Compile arguments with type conversion")
(println "          (compile-extern-arguments args (<extern-function>-arg-types extern) backend)")
(println "          (port-write port \")\")")
(println "          ;; Close wrapper")
(println "          (close-return-wrapper (<extern-function>-return-type extern) port))")
(println "        ;; Not an extern - normal compilation")
(println "        (compile-function-call self backend))))")
(println)

