;;; emit-runtime-unified-extern.l - Context-based extern handling
;;;
;;; UNIFIED APPROACH: Same syntax, different execution strategy
;;; • emit-c: Direct C calls (zero overhead)
;;; • runtime: FFI bridge if not in environment
;;;
;;; This is much cleaner than multiple declaration syntaxes!

(println "=== CONTEXT-BASED EXTERN HANDLING ===")
(println)

;;; ================================================================
;;; UNIFIED EXTERN DECLARATION
;;; ================================================================

(println "=== 1. SINGLE UNIFIED SYNTAX ===")
(println)
(println "One syntax to rule them all:")
(println)
(println "  ;; Standard library functions")
