;;; emit-c-unified-extern-ffi.l - Unified design for both direct linking and FFI
;;;
;;; We need BOTH approaches:
;;; 1. Direct C linking for known functions at compile time
;;; 2. FFI for dynamic/runtime loading
;;;
;;; This gives us the best of both worlds!

(println "=== UNIFIED EXTERN + FFI DESIGN ===")
(println)

;;; ================================================================
;;; USE CASE ANALYSIS - WHEN TO USE WHAT
;;; ================================================================

(println "=== 1. USE CASE MATRIX ===")
(println)
(println "┌─────────────────────────────────────┬─────────────┬─────────────┐")
(println "│ Use Case                            │ Direct C    │ FFI         │")
(println "├─────────────────────────────────────┼─────────────┼─────────────┤")
(println "│ Standard library (libc, libm)      │ ✅ Perfect   │ ❌ Overhead │")
(println "│ System calls                        │ ✅ Perfect   │ ❌ Overhead │")
(println "│ Static linking                      │ ✅ Perfect   │ ❌ Overhead │")
(println "│ Known libraries at compile time     │ ✅ Perfect   │ ❌ Overhead │")
(println "├─────────────────────────────────────┼─────────────┼─────────────┤")
(println "│ Plugin systems                      │ ❌ Unknown   │ ✅ Required │")
(println "│ dlopen/dlsym                        │ ❌ Runtime   │ ✅ Required │")
(println "│ Optional libraries                  │ ❌ May fail  │ ✅ Graceful │")
(println "│ User function pointers              │ ❌ Unknown   │ ✅ Required │")
(println "│ REPL with dynamic loading           │ ❌ No recomp │ ✅ Required │")
(println "│ JIT compilation                     │ ❌ No recomp │ ✅ Required │")
(println "└─────────────────────────────────────┴─────────────┴─────────────┘")
(println)

;;; ================================================================
;;; UNIFIED DECLARATION SYNTAX
;;; ================================================================

(println "=== 2. UNIFIED SYNTAX ===")
(println)
(println "We need syntax that can handle both:")
(println)

(println "=== 2.1 DIRECT LINKING DECLARATIONS ===")
(println)
(println "For compile-time known functions:")
(println "  ;; Standard library - always available")
(println "  (extern sqrt double (double) :direct)")
(println "  (extern printf int (string ...) :direct)")
(println "  (extern malloc pointer (long) :direct)")
(println "  ")
(println "  ;; System-specific but known at compile time")
(println "  (extern open int (string int int) :direct :header \"<fcntl.h>\")")
(println "  (extern pthread_create int (pointer pointer pointer pointer)")
(println "          :direct :header \"<pthread.h>\" :link \"-lpthread\")")
(println)

(println "=== 2.2 FFI DECLARATIONS ===")
(println)
(println "For runtime dynamic functions:")
(println "  ;; Plugin interface")
(println "  (extern-ffi process int (string) :optional)")
(println "  (extern-ffi render void (pointer int int) :optional)")
(println "  ")
(println "  ;; Optional library")
(println "  (extern-ffi opus_encode int (pointer pointer int int pointer int)")
(println "              :library \"libopus\" :optional)")
(println)

(println "=== 2.3 HYBRID DECLARATIONS ===")
(println)
(println "Best of both - try direct, fallback to FFI:")
(println "  ;; Try static first, fallback to dynamic")
(println "  (extern-hybrid opengl_function void (int int)")
(println "                 :direct :header \"<GL/gl.h>\" :link \"-lGL\"")
(println "                 :ffi :library \"libGL\" :fallback)")
(println)

;;; ================================================================
;;; IMPLEMENTATION ARCHITECTURE
;;; ================================================================

(println "=== 3. IMPLEMENTATION ARCHITECTURE ===")
(println)

;;; Unified extern type
(println "=== 3.1 UNIFIED EXTERN TYPE ===")
(println)
(println "(define-structure <extern-function>")
(println "  (name           ; Function name")
(println "   return-type    ; Return type")
(println "   arg-types      ; Argument types")
(println "   binding-type   ; 'direct, 'ffi, or 'hybrid")
(println "   header         ; Header file for direct")
(println "   library        ; Library for FFI")
(println "   optional       ; Can fail gracefully?")
(println "   resolved))     ; Runtime resolution status")
(println)

;;; Multi-method dispatch
(println "=== 3.2 MULTI-METHOD DISPATCH ===")
(println)
(println "(define-selector compile-extern-call)")
(println)
(println ";; Direct C linking")
(println "(add-method compile-extern-call <extern-function>")
(println "  '(self args backend)")
(println "  '((if (= (<extern-function>-binding-type self) 'direct)")
(println "        (compile-direct-call self args backend)")
(println "        (compile-ffi-call self args backend))))")
(println)

;;; Direct compilation
(println "=== 3.3 DIRECT C COMPILATION ===")
(println)
(println "(define-function compile-direct-call (extern args backend)")
(println "  \"Generate direct C function call\"")
(println "  (let ((port (<c-backend>-output-port backend))")
(println "        (name (<extern-function>-name extern))")
(println "        (ret-type (<extern-function>-return-type extern)))")
(println "    ;; Return type wrapper")
(println "    (compile-return-wrapper ret-type port)")
(println "    ;; Direct function call")
(println "    (port-write port name \"(\")")
(println "    (compile-typed-arguments args (<extern-function>-arg-types extern) backend)")
(println "    (port-write port \")\")")
(println "    ;; Close wrapper")
(println "    (close-return-wrapper ret-type port)))")
(println)

;;; FFI compilation
(println "=== 3.4 FFI COMPILATION ===")
(println)
(println "(define-function compile-ffi-call (extern args backend)")
(println "  \"Generate FFI function call\"")
(println "  (let ((port (<c-backend>-output-port backend))")
(println "        (name (<extern-function>-name extern)))")
(println "    ;; Check if function is resolved")
(println "    (port-write port \"({\\n\")")
(println "    (port-write port \"    if (!\" name \"_ffi_resolved) {\\n\")")
(println "    (port-write port \"        \" name \"_resolve_ffi();\\n\")")
(println "    (port-write port \"    }\\n\")")
(println "    (port-write port \"    if (!\" name \"_ffi_function) {\\n\")")
(println "    (if (<extern-function>-optional extern)")
(println "        (port-write port \"        return newLong(0); /* Optional function not available */\\n\")")
(println "        (port-write port \"        fatal(\\\"Required function \" name \" not available\\\");\\n\"))")
(println "    (port-write port \"    }\\n\")")
(println "    ;; FFI call")
(println "    (port-write port \"    ffi_call_wrapper(&\" name \"_ffi_proto, \")")
(println "    (compile-ffi-arguments args backend)")
(println "    (port-write port \");\\n\")")
(println "    (port-write port \"})\")))") 
(println)

;;; ================================================================
;;; GENERATED CODE EXAMPLES
;;; ================================================================

(println "=== 4. GENERATED CODE EXAMPLES ===")
(println)

(println "=== 4.1 DIRECT C GENERATION ===")
(println)
(println "Maru:")
(println "  (extern sqrt double (double) :direct)")
(println "  (sqrt 4.0)")
(println)
(println "Generates:")
(println "  /* Headers */")
(println "  #include <math.h>")
(println "  ")
(println "  /* Direct call */")
(println "  newDouble(sqrt(getDouble(arg0)))")
(println)
(println "Perfect! Zero overhead, full optimization.")
(println)

(println "=== 4.2 FFI GENERATION ===")
(println)
(println "Maru:")
(println "  (extern-ffi process int (string) :library \"myplugin\")")
(println "  (process \"data\")")
(println)
(println "Generates:")
(println "  /* FFI infrastructure */")
(println "  static void *process_ffi_function = NULL;")
(println "  static ffi_cif process_ffi_cif;")
(println "  static int process_ffi_resolved = 0;")
(println "  ")
(println "  static void process_resolve_ffi(void) {")
(println "      if (!myplugin_handle) {")
(println "          myplugin_handle = dlopen(\\\"libmyplugin.so\\\", RTLD_LAZY);")
(println "      }")
(println "      if (myplugin_handle) {")
(println "          process_ffi_function = dlsym(myplugin_handle, \\\"process\\\");")
(println "      }")
(println "      process_ffi_resolved = 1;")
(println "  }")
(println "  ")
(println "  /* FFI call */")
(println "  ({")
(println "      if (!process_ffi_resolved) {")
(println "          process_resolve_ffi();")
(println "      }")
(println "      if (!process_ffi_function) {")
(println "          return newLong(0); /* Optional function */")
(println "      }")
(println "      ffi_call_wrapper(&process_ffi_proto, args);")
(println "  })")
(println)

(println "=== 4.3 HYBRID GENERATION ===")
(println)
(println "Maru:")
(println "  (extern-hybrid glVertex3f void (float float float)")
(println "                 :direct :header \"<GL/gl.h>\" :link \"-lGL\"")
(println "                 :ffi :library \"libGL\" :fallback)")
(println)
(println "Generates:")
(println "  #ifdef HAVE_OPENGL_STATIC")
(println "  /* Direct linking available */")
(println "  #include <GL/gl.h>")
(println "  #define glVertex3f_call(x, y, z) glVertex3f(x, y, z)")
(println "  #else")
(println "  /* Fall back to FFI */")
(println "  static void (*glVertex3f_ffi)(float, float, float) = NULL;")
(println "  #define glVertex3f_call(x, y, z) \\")
(println "      (glVertex3f_ffi ? glVertex3f_ffi(x, y, z) : (void)0)")
(println "  #endif")
(println)

;;; ================================================================
;;; COMPILATION STRATEGY
;;; ================================================================

(println "=== 5. COMPILATION STRATEGY ===")
(println)

(println "=== 5.1 HEADER GENERATION ===")
(println)
(println "(define-function generate-extern-headers (backend)")
(println "  \"Generate all required headers\"")
(println "  (let ((port (<c-backend>-output-port backend))")
(println "        (direct-externs (filter-direct-externs (<c-backend>-externs backend))))")
(println "    ;; Standard headers")
(println "    (port-write port \"#include <stdio.h>\\n\")")
(println "    (port-write port \"#include <stdlib.h>\\n\")")
(println "    (port-write port \"#include <dlfcn.h>\\n\")")
(println "    (port-write port \"#include <ffi.h>\\n\")")
(println "    ;; Extern-specific headers")
(println "    (list-do extern direct-externs")
(println "      (if (<extern-function>-header extern)")
(println "          (port-write port \"#include \" (<extern-function>-header extern) \"\\n\")))))")
(println)

(println "=== 5.2 FFI INFRASTRUCTURE GENERATION ===")
(println)
(println "(define-function generate-ffi-infrastructure (backend)")
(println "  \"Generate FFI support code\"")
(println "  (let ((port (<c-backend>-output-port backend))")
(println "        (ffi-externs (filter-ffi-externs (<c-backend>-externs backend))))")
(println "    ;; Generate FFI globals")
(println "    (list-do extern ffi-externs")
(println "      (generate-ffi-globals extern port))")
(println "    ;; Generate resolvers")
(println "    (list-do extern ffi-externs")
(println "      (generate-ffi-resolver extern port))))")
(println)

