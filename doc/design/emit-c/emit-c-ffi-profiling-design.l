(println "=== 4.2 PROFILING EXAMPLE ===")
(println)
(println "Maru code with profiling:")
(println "  (define (fibonacci n)")
(println "    (if (< n 2)")
(println "        n")
(println "        (+ (fibonacci (- n 1))")
(println "           (fibonacci (- n 2)))))")
(println "  ")
(println "  (enable-profiling)")
(println "  (fibonacci 30)")
(println "  (print-profile-report)")
(println)
(println "Generated C with profiling:")
(println "  static oop fibonacci(oop n) {")
(println "    PROF_ENTER(\"fibonacci\");")
(println "    oop result;")
(println "    if (getLong(n) < 2) {")
(println "        result = n;")
(println "    } else {")
(println "        oop n1 = newLong(getLong(n) - 1);")
(println "        oop n2 = newLong(getLong(n) - 2);")
(println "        result = newLong(getLong(fibonacci(n1)) + getLong(fibonacci(n2)));")
(println "    }")
(println "    PROF_EXIT(\"fibonacci\");")
(println "    return result;")
(println "  }")
(println)
