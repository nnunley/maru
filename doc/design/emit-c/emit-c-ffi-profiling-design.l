;;; Compilation Control
(println "=== 3.3 COMPILATION FLAGS ===")
(println)
(println "(define-function compile-with-features (expr features)")
(println "  \"Compile with specific features enabled\"")
(println "  (let ((backend (new-c-backend-extended (string-port))))")
(println "    ;; Configure features")
(println "    (if (member? 'ffi features)")
(println "        (enable-ffi-compilation backend))")
(println "    (if (member? 'profiling features)")
(println "        (enable-profiling backend))")
(println "    (if (member? 'utf8 features)")
(println "        (enable-utf8-strings backend))")
(println "    ")
(println "    ;; Compile with features")
(println "    (compile-begin)")
(println "    (compile-to-c expr backend)")
(println "    (compile-end)")
(println "    ")
(println "    ;; Generate support code")
(println "    (generate-ffi-wrappers backend)")
(println "    (generate-profiling-infrastructure backend)")
(println "    ")
(println "    (port-contents (<c-backend-extended>-output-port backend))))")
(println)

