;;; Profiling Data Structures
(println "=== 2.1 PROFILING DATA STRUCTURES ===")
(println)
(println "/* Per-function profiling data */")
(println "typedef struct prof_entry {")
(println "    const char   *name;          /* Function name */")
(println "    uint64_t      call_count;    /* Number of calls */")
(println "    uint64_t      total_time;    /* Total time in nanoseconds */")
(println "    uint64_t      self_time;     /* Time excluding subcalls */")
(println "    uint64_t      min_time;      /* Minimum call time */")
(println "    uint64_t      max_time;      /* Maximum call time */")
(println "    size_t        alloc_count;   /* Allocations in function */")
(println "    size_t        alloc_bytes;   /* Bytes allocated */")
(println "    struct prof_entry *caller;   /* Call chain */")
(println "} prof_entry_t;")
(println)
(println "/* Global profiling state */")
(println "typedef struct {")
(println "    int           enabled;       /* Profiling on/off */")
(println "    prof_entry_t *entries;       /* Hash table of entries */")
(println "    prof_entry_t *current;       /* Current function */")
(println "    uint64_t      start_time;    /* Profiling start */")
(println "    FILE         *output;        /* Output file */")
(println "} prof_state_t;")
(println)

;;; Profiling Instrumentation
(println "=== 2.2 FUNCTION INSTRUMENTATION ===")
(println)
(println "(define-function compile-profiled-function (name params body backend)")
(println "  \"Compile function with profiling instrumentation\"")
(println "  (let ((port (<c-backend>-output-port backend))")
(println "        (mangled (mangle-symbol name)))")
(println "    ;; Function signature")
(println "    (port-write port \"static oop \" mangled \"(\")")
(println "    (compile-parameters params backend)")
(println "    (port-write port \") {\\n\")")
(println "    ")
(println "    ;; Profiling entry")
(println "    (port-write port \"    PROF_ENTER(\\\"\" name \"\\\");\\n\")")
(println "    ")
(println "    ;; Function body")
(println "    (port-write port \"    oop result = \")")
(println "    (with-indent backend")
(println "      (compile-to-c body backend))")
(println "    (port-write port \";\\n\")")
(println "    ")
(println "    ;; Profiling exit")
(println "    (port-write port \"    PROF_EXIT(\\\"\" name \"\\\");\\n\")")
(println "    (port-write port \"    return result;\\n\")")
(println "    (port-write port \"}\\n\")))")
(println)

;;; Profiling Macros
(println "=== 2.3 PROFILING MACROS ===")
(println)
(println "/* Profiling macros with minimal overhead */")
(println "#ifdef ENABLE_PROFILING")
(println "  #define PROF_ENTER(name) \\")
(println "    prof_entry_t *_prof_saved = prof_state.current; \\")
(println "    prof_entry_t *_prof_entry = prof_get_entry(name); \\")
(println "    _prof_entry->call_count++; \\")
(println "    _prof_entry->caller = _prof_saved; \\")
(println "    prof_state.current = _prof_entry; \\")
(println "    uint64_t _prof_start = get_nanotime();")
(println)
(println "  #define PROF_EXIT(name) \\")
(println "    uint64_t _prof_elapsed = get_nanotime() - _prof_start; \\")
(println "    _prof_entry->total_time += _prof_elapsed; \\")
(println "    if (_prof_elapsed < _prof_entry->min_time) \\")
(println "        _prof_entry->min_time = _prof_elapsed; \\")
(println "    if (_prof_elapsed > _prof_entry->max_time) \\")
(println "        _prof_entry->max_time = _prof_elapsed; \\")
(println "    prof_state.current = _prof_saved;")
(println)
(println "  #define PROF_ALLOC(bytes) \\")
(println "    if (prof_state.current) { \\")
(println "        prof_state.current->alloc_count++; \\")
(println "        prof_state.current->alloc_bytes += (bytes); \\")
(println "    }")
(println "#else")
(println "  #define PROF_ENTER(name)")
(println "  #define PROF_EXIT(name)")
(println "  #define PROF_ALLOC(bytes)")
(println "#endif")
(println)

;;; Memory Profiling Integration
(println "=== 2.4 MEMORY PROFILING ===")
(println)
(println "(define-function compile-profiled-allocation (size backend)")
(println "  \"Compile memory allocation with profiling\"")
(println "  (let ((port (<c-backend>-output-port backend)))")
(println "    (port-write port \"({\\n\")")
(println "    (port-write port \"    size_t _size = \")")
(println "    (compile-to-c size backend)")
(println "    (port-write port \";\\n\")")
(println "    (port-write port \"    PROF_ALLOC(_size);\\n\")")
(println "    (port-write port \"    GC_malloc(_size);\\n\")")
(println "    (port-write port \"})\")))")
(println)

;;; Profile Report Generation
(println "=== 2.5 PROFILE REPORT GENERATION ===")
(println)
(println "/* Generate profile report */")
(println "static void prof_generate_report(FILE *out) {")
(println "    fprintf(out, \"\\n=== PROFILING REPORT ===\\n\\n\");")
(println "    ")
(println "    /* Sort by total time */")
(println "    prof_entry_t **sorted = prof_get_sorted_entries();")
(println "    ")
(println "    /* Summary table */")
(println "    fprintf(out, \"%-30s %10s %12s %12s %12s %10s\\n\",")
(println "            \"Function\", \"Calls\", \"Total ms\", \"Self ms\", \"Avg μs\", \"Allocs\");")
(println "    fprintf(out, \"%-30s %10s %12s %12s %12s %10s\\n\",")
(println "            \"--------\", \"-----\", \"--------\", \"-------\", \"------\", \"------\");")
(println "    ")
(println "    for (int i = 0; i < prof_entry_count; i++) {")
(println "        prof_entry_t *e = sorted[i];")
(println "        double total_ms = e->total_time / 1000000.0;")
(println "        double self_ms = e->self_time / 1000000.0;")
(println "        double avg_us = e->total_time / (double)e->call_count / 1000.0;")
(println "        ")
(println "        fprintf(out, \"%-30s %10llu %12.3f %12.3f %12.3f %10zu\\n\",")
(println "                e->name, e->call_count, total_ms, self_ms, avg_us, e->alloc_count);")
(println "    }")
(println "    ")
(println "    /* Call graph */")
(println "    fprintf(out, \"\\n=== CALL GRAPH ===\\n\");")
(println "    prof_print_call_graph(out, sorted[0], 0);")
(println "}")
(println)

