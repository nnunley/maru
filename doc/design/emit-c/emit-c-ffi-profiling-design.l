;;; FFI Type System
(println "=== 1.1 FFI TYPE MAPPING ===")
(println)
(println "Maru Type → FFI Type → C Type:")
(println "  <long>     → ffi_type_sint64  → int64_t")
(println "  <string>   → ffi_type_pointer → char*")
(println "  <double>   → ffi_type_double  → double")
(println "  <pointer>  → ffi_type_pointer → void*")
(println "  <void>     → ffi_type_void    → void")
(println "  <int>      → ffi_type_sint32  → int32_t")
(println "  <uint>     → ffi_type_uint32  → uint32_t")
(println "  <float>    → ffi_type_float   → float")
(println)

;;; FFI Structure Definition
(println "=== 1.2 FFI RUNTIME STRUCTURES ===")
(println)
(println "/* FFI function prototype */")
(println "typedef struct {")
(println "    ffi_cif      cif;           /* libffi call interface */")
(println "    ffi_type    *return_type;   /* Return type */")
(println "    int          arg_count;     /* Number of arguments */")
(println "    int          arg_rest;      /* Variadic args flag */")
(println "    ffi_type    *arg_types[32]; /* Argument types */")
(println "    cast_t       arg_casts[32]; /* Type conversion functions */")
(println "    cast_t       ret_cast;      /* Return value conversion */")
(println "    void        *function;      /* Function pointer */")
(println "} ffi_proto_t;")
(println)

;;; FFI Multimethod Integration
(println "=== 1.3 MULTIMETHOD FFI COMPILATION ===")
(println)
(println "(define-selector compile-ffi-call)")
(println)
(println "(add-method compile-ffi-call <ffi-function>")
(println "  '(self args backend)")
(println "  '((let ((port (<c-backend>-output-port backend))")
(println "          (proto (<ffi-function>-prototype self)))")
(println "      ;; Generate FFI call wrapper")
(println "      (port-write port \"ffi_call_wrapper(\")")
(println "      (port-write port \"&\" (mangle-symbol (<ffi-function>-name self)) \"_proto, \")")
(println "      ;; Compile arguments with type conversion")
(println "      (compile-ffi-arguments args proto backend)")
(println "      (port-write port \")\"))))")
(println)

;;; FFI Declaration Syntax
(println "=== 1.4 FFI DECLARATION SYNTAX ===")
(println)
(println "Maru FFI declaration:")
(println "  (extern cos \"double(double)\" <libc>)")
(println "  (extern malloc \"void*(long)\" <libc>)")
(println "  (extern printf \"int(char*, ...)\" <libc>)")
(println)
(println "Generates:")
(println "  static ffi_proto_t cos_proto = {")
(println "    .return_type = &ffi_type_double,")
(println "    .arg_count = 1,")
(println "    .arg_types = {&ffi_type_double},")
(println "    .ret_cast = (cast_t)newDouble")
(println "  };")
(println)

;;; FFI Call Generation
(println "=== 1.5 FFI CALL CODE GENERATION ===")
(println)
(println "(define-function compile-ffi-wrapper (name signature backend)")
(println "  \"Generate FFI call wrapper with safety checks\"")
(println "  (let ((port (<c-backend>-output-port backend)))")
(println "    ;; Generate wrapper function")
(println "    (port-write port \"static oop \" name \"_wrapper(oop *args, int nargs) {\\n\")")
(println "    (port-write port \"    void *arg_values[\" max-args \"];\\n\")")
(println "    (port-write port \"    ffi_arg result;\\n\")")
(println "    ")
(println "    ;; Argument conversion")
(println "    (port-write port \"    /* Convert arguments */\\n\")")
(println "    (port-write port \"    for (int i = 0; i < nargs; i++) {\\n\")")
(println "    (port-write port \"        arg_values[i] = convert_arg(args[i], \" name \"_proto.arg_casts[i]);\\n\")")
(println "    (port-write port \"    }\\n\")")
(println "    ")
(println "    ;; FFI call")
(println "    (port-write port \"    /* Call foreign function */\\n\")")
(println "    (port-write port \"    ffi_call(&\" name \"_proto.cif, \" name \"_proto.function, &result, arg_values);\\n\")")
(println "    ")
(println "    ;; Result conversion")
(println "    (port-write port \"    /* Convert result */\\n\")")
(println "    (port-write port \"    return \" name \"_proto.ret_cast(result);\\n\")")
(println "    (port-write port \"}\\n\")))")
(println)

;;; UTF-8 String Handling in FFI
(println "=== 1.6 FFI WITH UTF-8 STRINGS ===")
(println)
(println "(define-function compile-ffi-utf8-conversion (backend)")
(println "  \"Generate UTF-8 ↔ C string conversion for FFI\"")
(println "  (let ((port (<c-backend>-output-port backend)))")
(println "    (port-write port \"/* UTF-8 string conversion for FFI */\\n\")")
(println "    (port-write port \"static char* utf8_to_cstring(oop str) {\\n\")")
(println "    (port-write port \"    if (isString(str)) {\\n\")")
(println "    (port-write port \"        return get_string_bytes(str);\\n\")")
(println "    (port-write port \"    } else if (isUtf8String(str)) {\\n\")")
(println "    (port-write port \"        return get_utf8_bytes(str);\\n\")")
(println "    (port-write port \"    }\\n\")")
(println "    (port-write port \"    return NULL;\\n\")")
(println "    (port-write port \"}\\n\")))")
(println)

