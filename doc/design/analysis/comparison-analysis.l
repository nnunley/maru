;;; comparison-analysis.l - Detailed comparison of our emit-c.l vs existing C generation

(require "core/compiler/emit-c.l")

(println "=== COMPREHENSIVE COMPARISON: emit-c.l vs eval.c/eval2.c ===")
(println)

(println "=== 1. ARITHMETIC OPERATIONS ===")
(println)

(println "Pattern: Environment level calculation")
(println "eval.c line: newLong((nil == parent) ? 0 : getLong(get(parent, Env,level)) + level)")
(println)
(print "Our equivalent for (+ parent-level level): ")
(compile-maru-expression '(+ parent-level level) (console-port))
(println)
(println "ANALYSIS:")
(println "- eval.c: Complex nested getLong() calls with conditional logic")
(println "- Our backend: Clean LONG(parent-level + level)")
(println "- Improvement: Eliminated nested function calls, direct arithmetic")
(println)

(println "=== 2. COMPARISON OPERATIONS ===")
(println)

(println "Pattern: Size comparison for memory allocation")
(print "Our generation for (> (+ bytes_used size) quantum): ")
(compile-maru-expression '(> (+ bytes_used size) quantum) (console-port))
(println)
(println "Traditional verbose pattern would be:")
(println "  ((getLong(LONG(getLong(bytes_used) + getLong(size))) > getLong(quantum)) ? LONG(1) : nil)")
(println)
(println "ANALYSIS:")
(println "- Traditional: Multiple getLong/LONG conversions")
(println "- Our backend: Direct comparison (bytes_used + size > quantum ? s_true : nil)")
(println "- Improvement: Eliminated conversion overhead, readable logic")
(println)

(println "=== 3. CONDITIONAL EXPRESSIONS ===")
(println)

(println "Pattern: max function implementation")
(print "Our generation for max function body: ")
(compile-maru-expression '(if (> a b) a b) (console-port))
(println)
(println "ANALYSIS:")
(println "- Clean ternary operator with numeric context in comparison")
(println "- Appropriate object context for return values")
(println "- Much more readable than nested getLong patterns")
(println)

(println "=== 4. FUNCTION CALLS ===")
(println)

(println "Pattern: Memory allocation with size calculation")
(print "Our generation for (malloc (* count element-size)): ")
(compile-maru-expression '(malloc (* count element-size)) (console-port))
(println)
(println "ANALYSIS:")
(println "- Direct function call with computed argument")
(println "- Arithmetic performed in numeric context") 
(println "- Clean, readable C code generation")
(println)

(println "=== 5. COMPLEX NESTED EXPRESSIONS ===")
(println)

(println "Pattern: Garbage collection trigger logic")
(define complex-port (string-port))
(compile-maru-expression '(if (> (+ gc_bytes_used allocation_size) gc_quantum)
                             (begin (gc_collect) (+ gc_bytes_used allocation_size))
                             (+ gc_bytes_used allocation_size)) complex-port)
(define complex-result (port-contents complex-port))
(println "Complex GC logic:")
(println complex-result)
(println)
(println "ANALYSIS:")
(println "- Properly handles nested arithmetic in conditions")
(println "- Context-aware LONG() wrapping only where needed")
(println "- Much cleaner than traditional verbose backends")
(println)

