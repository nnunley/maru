;;; The kernel's lists, arrays and printer: eval3's car, cdr and their compositions (eval3.c:165), its arrays
;;; (eval3.c:281-336), and doprint with print, dump and dumpln (eval3.c:886-1087), for its thirteen types.

(define (isatty	(int int)			*)	(extern isatty))
(define (fflush	(int void *)			*)	(extern fflush))
(define (memmove	(void * void * void * long)	*)	(extern memmove))

(define-function k_car oop ((obj oop))	(if (object-is <pair> obj) (return (<pair>-head obj))) (return (cast 0 oop)))
(define-function k_cdr oop ((obj oop))	(if (object-is <pair> obj) (return (<pair>-tail obj))) (return (cast 0 oop)))
(define-function k_caar oop ((obj oop))	(return (k_car (k_car obj))))
(define-function k_cadr oop ((obj oop))	(return (k_car (k_cdr obj))))
(define-function k_cdar oop ((obj oop))	(return (k_cdr (k_car obj))))
(define-function k_cddr oop ((obj oop))	(return (k_cdr (k_cdr obj))))
(define-function k_caddr oop ((obj oop))	(return (k_car (k_cdr (k_cdr obj)))))

;;; arrays: an <array>'s elements are the words of its <_array>, the first size of them in use

(define-function k_arrayLength long ((obj oop))
  (if (object-is <array> obj) (return (k_getLong (<array>-size obj))))
  (return 0))

(define-function k_arrayAt oop ((array oop) (index long))
  (if (and (object-is <array> array) (>= index 0) (< index (k_arrayLength array)))
      (return (indir (cast (<array>-_array array) oop *) index)))
  (return (cast 0 oop)))

;; written past its end, an array grows: its elements' capacity doubles until the index fits, and the size becomes the
;; index + 1.  New capacity is filled with nil, which eval3 has from zeroed memory
(define-function k_arrayAtPut oop ((array oop) (index long) (val oop))
  (if (not (object-is <array> array)) (return (cast 0 oop)))
  (let (((size long) (k_arrayLength array))
	((elts oop) (<array>-_array array)))
    (if (>= index size)
	(gc-protect (array val)
	  (let (((cap long) (/ (gc_size elts) (sizeof oop))))
	    (if (>= index cap)
		(let (((oops oop) (cast 0 oop)))
		  (while (<= cap index) (set cap (* cap 2)))
		  (set oops (new <_array> (* (sizeof oop) cap)))
		  (memcpy oops elts (* (sizeof oop) size))
		  (k_nilFill oops size cap)
		  (set (<array>-_array array) oops)
		  (set elts oops))))
	  (set (<array>-size array) (k_newLong (+ index 1)))))
    (set (indir (cast elts oop *) index) val)
    (return val)))

(define-function k_arrayAppend oop ((array oop) (val oop))
  (return (k_arrayAtPut array (k_arrayLength array) val)))

(define-function k_arrayInsert oop ((obj oop) (index long) (value oop))
  (let (((len long) (k_arrayLength obj)))
    (k_arrayAppend obj value)
    (if (< index len)
	(let (((oops oop *) (+ (cast (<array>-_array obj) oop *) (* index (sizeof oop)))))	; ir2 adds bytes (ir2.k:872)
	  (memmove (cast (+ oops (sizeof oop)) void *) (cast oops void *) (* (sizeof oop) (- len index)))))
    (k_arrayAtPut obj index value)
    (return value)))

;;; the printer: storing (dump) writes strings as the reader reads them back

;; (type-case t (id body...) ... (else body...)): the body of the clause whose id is t, as nested ifs (eval3's switch)
(define-form type-case (t . clauses)
  (let ((chain ()))
    (list-do clause (list-reverse! (map (lambda (c) c) clauses))
      (set chain (if (= 'else (car clause))
		     `(let () ,@(cdr clause))
		   `(if (= ,t ,(car clause)) (let () ,@(cdr clause)) ,@(and chain (list chain))))))
    chain))

(define-function k_doprint void ((obj oop) (storing long))
  (if (= obj (cast 0 oop))
      (printf "()")
    (type-case (object-type obj)
      (0 (printf "UNDEFINED"))
      ;; Data's length is the collector's size until kernel-gc.k keeps the length asked for (doc/kernel.md)
      (1 (printf "<data[%d]>" (cast (gc_size obj) int)))
      (2 (printf "%ld" (k_getLong obj)))
      (3 (printf "%lf" (k_getDouble obj)))
      (4 (k_printString (<string>-bits obj) storing))
      (5 (printf "%ls" (<symbol>-bits obj)))
      (6 (k_printList obj storing))
      (8 (k_printArray obj storing))
      (9 (printf "Expr")
	 (if (!= (<expr>-name obj) (cast 0 oop)) (let () (printf ".") (k_doprint (<expr>-name obj) storing)))
	 (printf "=")
	 (k_doprint (k_car (<expr>-definition obj)) storing))
      (10 (printf "Form(")
	  (k_doprint (<form>-function obj) storing)
	  (printf ", ")
	  (k_doprint (<form>-symbol obj) storing)
	  (printf ")"))
      (11 (if (isatty 1) (printf "\033[1m") (printf "Fixed<"))
	  (k_doprint (<fixed>-function obj) storing)
	  (if (isatty 1) (printf "\033[m") (printf ">")))
      (12 (if (<subr>-name obj) (printf "%ls" (<subr>-name obj)) (printf "Subr<%p>" (<subr>-imp obj))))
      ;; a type boot declared: eval3 names it from %type-names, which comes with the globals (Task 4)
      (else (printf "<type=%d>" (cast (object-type obj) int))))))

;; a string's characters; stored, in quotes with " and \ escaped and a control character in octal (eval3.c:917)
(define-function k_printString void ((p int32 *) (storing long))
  (if (not storing)
      (printf "%ls" p)
    (let ()
      (printf "\"")
      (while (indir p)
	(let (((c int32) (indir p)))
	  (if (>= c 32)
	      (if (= c 34) (printf "\\\"")
		(if (= c 92) (printf "\\\\")
		  (printf "%lc" c)))
	    (printf "\\%03o" c)))
	(set p (+ p (sizeof int32))))
      (printf "\""))))

;; a list; an element that is a binding whose tail is the list itself, as a global's association, prints as <name>
(define-function k_printList void ((head oop) (storing long))
  (printf "(")
  (let (((more long) 1))
    (while more
      (let (((h oop) (<pair>-head head)))
	(if (and (object-is <pair> h) (object-is <symbol> (<pair>-head h)) (= head (<pair>-tail h)))
	    (printf "<%ls>" (<symbol>-bits (<pair>-head h)))
	  (k_doprint h storing)))
      (set head (k_cdr head))
      (if (object-is <pair> head) (printf " ") (set more 0))))
  (if (!= head (cast 0 oop)) (let () (printf " . ") (k_doprint head storing)))
  (printf ")"))

(define-function k_printArray void ((obj oop) (storing long))
  (let (((i long) 0) ((len long) (k_arrayLength obj)))
    (printf "Array<%d>(" (cast len int))
    (while (< i len)
      (if i (printf " "))
      (k_doprint (k_arrayAt obj i) storing)
      (set i (+ i 1)))
    (printf ")")))

(define-function k_print void ((obj oop))	(k_doprint obj 0) (fflush (cast 0 void *)))
(define-function k_dump void ((obj oop))	(k_doprint obj 1) (fflush (cast 0 void *)))
(define-function k_dumpln void ((obj oop))	(k_dump obj) (printf "\n") (fflush (cast 0 void *)))
