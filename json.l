;;; json.l: (json-read text) reads JSON through json.g, () if it isn't JSON; (json-write value) writes the values json.g
;;; reads; (json-get object key) is a field's value, or ().
(require "source-parser.l")
(define compile-tpeg-definitions-only 1)
(require "compile-tpeg.l")
(define-function json-byte (c) (let ((s (string 1))) (set-string-at s 0 c) s))
(define-function json-utf8 (u)			; a code point's bytes
  (cond ((< u 128)	(json-byte u))
	((< u 2048)	(concat-strings (json-byte (+ 192 (>> u 6))) (json-byte (+ 128 (& u 63)))))
	(else		(concat-strings (json-byte (+ 224 (>> u 12))) (json-byte (+ 128 (& (>> u 6) 63)))
					(json-byte (+ 128 (& u 63)))))))
(define-function json-text (cs)			; a string's bytes, each \u escape as UTF-8
  (apply concat-strings (map (lambda (c) (if (pair? c) (json-utf8 (cdr c)) (json-byte c))) cs)))
(tpeg-load "json.g")
(define-function json-read (text)
  (let ((parser (text-parser-for-on <json> text)))
    (and ($document parser) (list (<text-parser>-result parser)))))
(define-function assoc-text (key alist)		; the pair whose car is the string key, or ()
  (let ((found ())) (list-do p alist (and (not found) (equal (car p) key) (set found p))) found))
(define-function json-get (object key) (cdr (assoc-text key (cdr object))))

(define json-escapes '((34 . "\\\"") (92 . "\\\\") (10 . "\\n") (13 . "\\r") (9 . "\\t")))
(define-selector json-write (v) (error "json-write: no JSON for " v))
(define-method json-write <long> () (long->string self))
(define-method json-write <symbol> () (symbol->string self))	; true, false, null
(define-method json-write <string> ()
  (let ((parts (list "\"")))
    (for (i 0 (string-length self))
      (let ((c (string-at self i)))
	(push parts (or (cdr (assq c json-escapes)) (json-byte c)))))
    (push parts "\"")
    (apply concat-strings (list-reverse! parts))))
(define-function json-join (open items close)
  (let ((parts (list open)) (first 1))
    (list-do i items (or first (push parts ",")) (set first ()) (push parts i))
    (push parts close)
    (apply concat-strings (list-reverse! parts))))
(define-method json-write <pair> ()
  (if (= 'object (car self))
      (json-join "{" (map (lambda (p) (concat-strings (json-write (car p)) ":" (json-write (cdr p)))) (cdr self)) "}")
    (json-join "[" (map json-write self) "]")))
(define-method json-write <undefined> () "[]")
