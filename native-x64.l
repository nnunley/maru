;;; native-x64.l -- for native-x64.g's actions: intents (native-gen.k) to x86-64 forms, by System V's convention.
;;; Slots are offsets from RSP; s0 … s4 are abi.spec's scratch registers; RAX is this lowering's own temporary (and AL a
;;; variadic call's count of vector registers), RDX is free within an operation, and floats visit fscratch.

;; a general register's name at a size in bytes, by its number: RAX, EAX, AX, AL; R10, R10D, R10W, R10B
(define-function native-x64-sized (r size)
  (let ((n (cadddr (x86-reg r))) (found ()))
    (list-do reg x86-registers
      (and (= 'r (cadr reg)) (= size (caddr reg)) (= n (cadddr reg)) (not (= 'high (car (cddddr reg)))) (set found (car reg))))
    (or found (error "native: no " size "-byte name for " r))))
(define-function native-x64-mem (size base at) (list (cdr (assq size '((1 . m8) (2 . m16) (4 . m32) (8 . m64)))) at base () 1))
(define-function native-x64-load (size r base at)	; sign-extending: ir2's integers are signed
  (let ((m (native-x64-mem size base at)))
    (cond ((= size 8) `((MOV ,r ,m)))
	  ((= size 4) `((MOVSXD ,r ,m)))
	  ((or (= size 2) (= size 1)) `((MOVSX ,r ,m)))
	  (else (error "native: no load of " size " bytes")))))
(define-function native-x64-store (size r base at) `((MOV ,(native-x64-mem size base at) ,(native-x64-sized r size))))
(define-function native-x64-piece-load (n r base at)	; a plain load of 8 or 4 bytes (a 4-byte one zero-extends)
  `((MOV ,(native-x64-sized r n) ,(native-x64-mem n base at))))
(define-function native-x64-copy (size from to)
  (native-flatten (map (lambda (p) (concat-list (native-x64-piece-load (cdr p) 'RAX 'RSP (+ from (car p)))
						(native-x64-store (cdr p) 'RAX 'RSP (+ to (car p)))))
		       (native-pieces size))))
(define-function native-x64-enter (n outgoing)
  (set native-outgoing outgoing)
  `((PUSH RBP) (MOV RBP RSP) ,@(if (= 0 n) () `((SUB RSP ,n)))))

(define native-x64-ops '((add . ADD) (sub . SUB) (and . AND) (or . OR) (xor . XOR)))
(define-function native-x64-op (kind d a b)
  (and (!= d a) (= d b) (error "native: x64 op " kind " writing its second operand"))
  (let ((first (if (= d a) () `((MOV ,d ,a)))))
    (cond ((assq kind native-x64-ops) `(,@first (,(cdr (assq kind native-x64-ops)) ,d ,b)))
	  ((= kind 'mul) `(,@first (IMUL ,d ,b)))
	  ((= kind 'div) `((MOV RAX ,a) (CQO) (IDIV ,b) (MOV ,d RAX)))
	  ((= kind 'mod) `((MOV RAX ,a) (CQO) (IDIV ,b) (MOV ,d RDX)))
	  ((= kind 'shl) `(,@first (MOV RCX ,b) (SHL ,d CL)))
	  ((= kind 'shr) `(,@first (MOV RCX ,b) (SAR ,d CL)))
	  ((= kind 'com) `(,@first (NOT ,d)))
	  (else (error "native: no x64 operation " kind)))))
(define-function native-x64-cond (c)
  (cdr (assq c '((eq . E) (ne . NE) (lt . L) (le . LE) (gt . G) (ge . GE) (lo . B) (ls . BE) (hi . A) (hs . AE)))))
(define-function native-x64-set (c d)	; d is 1 if condition c holds, else 0
  `((,(string->symbol (concat-string "SET" (symbol->string c))) ,(native-x64-sized d 1)) (MOVZX ,(native-x64-sized d 4) ,(native-x64-sized d 1))))
(define-function native-x64-compare (c d a b) `((CMP ,a ,b) ,@(native-x64-set (native-x64-cond c) d)))
(define-function native-x64-branch (jump r l) `((TEST ,r ,r) (,jump (label ,l))))

;; floats: bits in general registers, moved to and from fscratch (MOVQ at 64 bits, MOVD at 32) to be operated on
(define-function native-x64-f (k) (native-nth (abi 'x64 'fscratch) k))
(define-function native-x64-to-x (x r width) (if (= 64 width) `(MOVQ ,x ,r) `(MOVD ,x ,(native-x64-sized r 4))))
(define-function native-x64-from-x (r x width) (if (= 64 width) `(MOVQ ,r ,x) `(MOVD ,(native-x64-sized r 4) ,x)))
(define-function native-x64-fop (kind width d a b)
  (if (= kind 'neg)	; the sign bit flipped where the bits are
      `(,@(if (= d a) () `((MOV ,d ,a)))
	,@(if (= 64 width) `((MOV RAX ,(<< 1 63)) (XOR ,d RAX)) `((XOR ,(native-x64-sized d 4) -2147483648))))
    (let ((f0 (native-x64-f 0)) (f1 (native-x64-f 1)))
      `(,(native-x64-to-x f0 a width) ,(native-x64-to-x f1 b width)
	(,(string->symbol (concat-string (symbol->string (or (cdr (assq kind '((add . ADD) (sub . SUB) (mul . MUL) (div . DIV))))
							     (error "native: no float operation " kind)))
					 (if (= 64 width) "SD" "SS")))
	 ,f0 ,f1)
	,(native-x64-from-x d f0 width)))))
(define native-x64-skips 0)
(define-function native-x64-skip ()
  (string->symbol (concat-string "xskip" (long->string (set native-x64-skips (+ native-x64-skips 1))))))
;; UCOMIS compares as unsigned integers do, unordered setting ZF, PF and CF: less is greater with the operands swapped,
;; and equality also needs PF clear (no NaN), so ne holds when unordered
(define-function native-x64-fcompare (c width d a b)
  (let* ((f0 (native-x64-f 0)) (f1 (native-x64-f 1)) (swap (memq c '(lt le)))
	 (ucomis (list (if (= 64 width) 'UCOMISD 'UCOMISS) (if swap f1 f0) (if swap f0 f1)))
	 (skip (native-x64-skip)))
    `(,(native-x64-to-x f0 a width) ,(native-x64-to-x f1 b width) ,ucomis
      ,@(native-x64-set (cdr (assq c '((eq . E) (ne . NE) (lt . A) (le . AE) (gt . A) (ge . AE)))) d)
      ,@(cond ((= c 'eq) `((JNP (label ,skip)) (MOV ,(native-x64-sized d 4) 0) (at ,skip)))
	      ((= c 'ne) `((JNP (label ,skip)) (MOV ,(native-x64-sized d 4) 1) (at ,skip)))
	      (else ())))))
(define-function native-x64-convert (from to d s)
  (let ((f0 (native-x64-f 0)) (w (lambda (k) (if (= k 'f32) 32 64))) (sfx (lambda (k) (if (= k 'f32) "SS" "SD"))))
    (cond ((= from 's64) `((,(string->symbol (concat-string "CVTSI2" (sfx to))) ,f0 ,s) ,(native-x64-from-x d f0 (w to))))
	  ((= to 's64) `(,(native-x64-to-x f0 s (w from)) (,(string->symbol (concat-string "CVTT" (concat-string (sfx from) "2SI"))) ,d ,f0)))
	  (else `(,(native-x64-to-x f0 s (w from))
		  (,(string->symbol (concat-string "CVT" (concat-string (sfx from) (concat-string "2" (sfx to))))) ,f0 ,f0)
		  ,(native-x64-from-x d f0 (w to)))))))

;; System V: six integer argument registers, eight vector ones; a struct of up to 16 bytes in general registers if they
;; all fit, else on the stack (C's rule only for integers and pointers: native-gen.k refuses a struct with a floating
;; member by value); every stack argument in an 8-byte slot, the first at [RBP + 16] on entry
(define-function native-x64-arg (n) (native-nth (abi 'x64 'args) n))
(define-function native-x64-farg (n) (native-nth (abi 'x64 'fargs) n))
(define-function native-x64-params (ps)
  (let ((gp 0) (fp 0) (stack 0) (out ()))
    (list-do p ps
      (let ((size (car p)) (slot (cadr p)) (kind (caddr p)))
	(cond
	  ((= kind 'struct)
	   (let ((pieces (native-pieces size)))
	     (if (and (<= size 16) (<= (+ gp (list-length pieces)) 6))
		 (list-do pc pieces (set out (native-onto out (native-x64-store (cdr pc) (native-x64-arg gp) 'RSP (+ slot (car pc))))) (set gp (+ gp 1)))
	       (list-do pc pieces
		 (set out (native-onto out (native-x64-piece-load (cdr pc) 'RAX 'RBP (+ 16 (+ stack (car pc))))))
		 (set out (native-onto out (native-x64-store (cdr pc) 'RAX 'RSP (+ slot (car pc))))))
	       (set stack (+ stack (align size 8))))))
	  ((and (= kind 'float) (< fp 8))
	   (push out (native-x64-from-x 'RAX (native-x64-farg fp) (* 8 size)))
	   (set out (native-onto out (native-x64-store size 'RAX 'RSP slot)))
	   (set fp (+ fp 1)))
	  ((and (not (= kind 'float)) (< gp 6))
	   (set out (native-onto out (native-x64-store size (native-x64-arg gp) 'RSP slot)))
	   (set gp (+ gp 1)))
	  (else
	   (set out (native-onto out (native-x64-load size 'RAX 'RBP (+ 16 stack))))
	   (set out (native-onto out (native-x64-store size 'RAX 'RSP slot)))
	   (set stack (+ stack 8))))))
    (list-reverse! out)))
(define-function native-x64-call (callee nfixed args ret)
  (let ((gp 0) (fp 0) (out 0) (forms ()))
    (list-do a args
      (let ((size (car a)) (slot (cadr a)) (kind (caddr a)))
	(cond
	  ((= kind 'struct)
	   (let ((pieces (native-pieces size)))
	     (if (and (<= size 16) (<= (+ gp (list-length pieces)) 6))
		 (list-do pc pieces (set forms (native-onto forms (native-x64-piece-load (cdr pc) (native-x64-arg gp) 'RSP (+ slot (car pc))))) (set gp (+ gp 1)))
	       (list-do pc pieces
		 (set forms (native-onto forms (native-x64-piece-load (cdr pc) 'RAX 'RSP (+ slot (car pc)))))
		 (set forms (native-onto forms (native-x64-store (cdr pc) 'RAX 'RSP (+ out (car pc))))))
	       (set out (+ out (align size 8))))))
	  ((and (= kind 'float) (< fp 8))
	   (set forms (native-onto forms (native-x64-load size 'RAX 'RSP slot)))
	   (push forms (native-x64-to-x (native-x64-farg fp) 'RAX (* 8 size)))
	   (set fp (+ fp 1)))
	  ((and (not (= kind 'float)) (< gp 6))
	   (set forms (native-onto forms (native-x64-load size (native-x64-arg gp) 'RSP slot)))
	   (set gp (+ gp 1)))
	  (else
	   (set forms (native-onto forms (native-x64-load size 'RAX 'RSP slot)))
	   (set forms (native-onto forms (native-x64-store 8 'RAX 'RSP out)))
	   (set out (+ out 8))))))
    (native-within-outgoing out)
    (set forms (native-onto forms (native-x64-load 8 'R11 'RSP callee)))
    (push forms (list 'MOV 'EAX fp))	; a variadic callee reads AL: the vector registers used
    (push forms '(CALL R11))
    (when ret
      (let ((size (car ret)) (slot (cadr ret)) (kind (caddr ret)))
	(cond ((= kind 'struct)
	       (let ((r '(RAX RDX))) (list-do pc (native-result-pieces size) (set forms (native-onto forms (native-x64-store (cdr pc) (car r) 'RSP (+ slot (car pc))))) (set r (cdr r)))))
	      ((= kind 'float)
	       (push forms (native-x64-from-x 'RAX (car (abi 'x64 'fresult)) (* 8 size)))
	       (set forms (native-onto forms (native-x64-store size 'RAX 'RSP slot))))
	      (else (set forms (native-onto forms (native-x64-store size 'RAX 'RSP slot)))))))
    (list-reverse! forms)))
(define-function native-x64-result (size slot kind)
  (cond ((= kind 'struct)
	 (let ((r '(RAX RDX)) (forms ()))
	   (list-do pc (native-result-pieces size) (set forms (native-onto forms (native-x64-piece-load (cdr pc) (car r) 'RSP (+ slot (car pc))))) (set r (cdr r)))
	   (list-reverse! forms)))
	((= kind 'float) `(,@(native-x64-load size 'RAX 'RSP slot) ,(native-x64-to-x (car (abi 'x64 'fresult)) 'RAX (* 8 size))))
	(else (native-x64-load size 'RAX 'RSP slot))))
