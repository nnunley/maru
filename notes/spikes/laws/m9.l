;;; SPIKE: the engine's own law, with terms generated by rules:
;;; if unify(A, B) = s then walk*(A, s) = walk*(B, s)
(load "notes/spikes/laws/logic.l")
(rule t-atom (term $x)		(member $x (x y z)))
(rule t-var  (term (lvar $n))	(member $n (1 2 3)))
(rule t-pair (term (pair $a $b))	(term $a) (term $b))
(define-function realise (t vars)	; (lvar n) -> one <lv> per n, (pair a b) -> cons
  (cond
    ((and (pair? t) (= 'lvar (car t)))	(let ((b (assq (cadr t) (car vars))))
					  (if b (cdr b) (let ((v (new <lv> (+ 1000 (cadr t))))) (set-car vars (cons (cons (cadr t) v) (car vars))) v))))
    ((and (pair? t) (= 'pair (car t)))	(cons (realise (cadr t) vars) (realise (caddr t) vars)))
    (else				t)))
(define-function show (t) (cond ((lv? t) (concat-string "_" (long->string (<lv>-id t)))) ((pair? t) (concat-strings "(" (show (car t)) " . " (show (cdr t)) ")")) (else (symbol->string t))))
(let ((n 300) (unified 0) (bad ()))
  (for (i 0 n)
    (let* ((vars (list ()))
	   (a (realise (generate '(term $t) 3) vars))
	   (b (realise (generate '(term $t) 3) vars))
	   (s (unify a b *empty*)))
      (when s
	(set unified (+ unified 1))
	(println "  checking " (show a) " = " (show b))
	(or (equal (walk* a s) (walk* b s)) (push bad (cons a b))))))
  (println "unify law: " unified " of " n " pairs unified, " (list-length bad) " violate it"))
