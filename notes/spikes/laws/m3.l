;;; SPIKE: how much of what Nile's grammar alone generates survives Nile's
;;; own resolution and type checking?  Each candidate is checked in a fork.
(load "notes/spikes/laws/gen.l")
(load "notes/spikes/laws/nile-load.l")
(define fork	(subr "fork" ">i"))
(define waitpid	(subr "waitpid" "ipi>i"))
(define _exit	(subr "_exit" "i"))
(define status-word ((subr "malloc" "l>p") 8))
(define-form nile-fatal-error message '(_exit 3))
(define nile-op-lookup-error (lambda args (_exit 3)))
(define-function nile-load (f) (load (concat-string "nile/compilers/maru/" f)))
(load "nile/compilers/maru/nile-resolve.l")
(load "nile/compilers/maru/nile-type-check.l")
(set *parser-init* (lambda (p) (set (oop-at p 6) 0)))
(set *rules* (grammar-rules '("nile/compilers/maru/nile-grammar.g")))
(compute-heights) (compute-reach)
(define prelude (parse-string <nile-parser> $start (contents-of-file-named "nile/compilers/prelude.nl")))
(define-function survives? (def)
  (let ((pid (fork)))
    (when (= 0 pid)
      (let ((ast (map-with resolve (concat-list prelude (list def)) (nile-resolve-env '()))))
	(map-with type-check ast '())
	(_exit 0)))
    (waitpid pid status-word 0)
    (= 0 (+ (byte-at status-word 0) (<< (byte-at status-word 1) 8)))))
(println "prelude alone survives: " (survives? (car prelude)))
(list-do rule '(typedef opdef processdef)
  (let ((parsed 0) (ok 0) (n 100))
    (for (i 0 n)
      (let* ((s (generate rule 10)) (r (and s (parses <nile-parser> rule s))))
	(when r (set parsed (+ parsed 1)) (and (survives? (car r)) (set ok (+ ok 1))))))
    (println rule ": " parsed " of " n " parse, " ok " resolve and type-check")))
