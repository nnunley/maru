(load "notes/spikes/laws/meta.l")
(set *fired* ())
(let ((b (law-sound 60)))       (println "sound: " (- 60 (list-length b)) " of 60 generated are accepted by Nile") (list-do x b (println "   refuted: " (car x) " : " (cdr x))))
(let ((b (law-gen-checks 60)))  (println "generate-checks: " (- 60 (list-length b)) " of 60"))
(let ((unused ()))
  (list-do r *rules* (and (member? (car (cadr r)) '(expr infix prefix)) (not (member? (car r) *fired*)) (push unused (car r))))
  (println "coverage: rules never used " unused))
(let ((r (law-agree 80)))
  (println "agree: both accept " (car r) ", both reject " (cadr r) ", disagree " (list-length (caddr r)))
  (list-do x (caddr r) (println "   " (car x) " : " (cadr x) "  " (caddr x))))
