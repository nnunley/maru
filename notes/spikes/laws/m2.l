(load "notes/spikes/laws/gen.l")
(load "notes/spikes/laws/nile-load.l")
(set *rules* (grammar-rules '("nile/compilers/maru/nile-grammar.g")))
(compute-heights) (compute-reach)
(set *parser-init* (lambda (p) (set (oop-at p 6) 0)))
(list-do rule '(expr stmt typedef opdef processdef definition)
  (let ((ok 0) (n 200) (made 0))
    (for (i 0 n) (let ((s (generate rule 12)))
		   (when s (set made (+ made 1)) (and (parses <nile-parser> rule s) (set ok (+ ok 1))))))
    (println rule ": " ok " of " n " parse")))
(for (i 0 4) (let ((s (car (sentence <nile-parser> 'opdef 12)))) (print "  opdef: ") (dumpln s)))
