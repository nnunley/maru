;;; SPIKE: Nile's own resolver and type checker as the reference, one fork
;;; per question (it exits on its first error)
(load "notes/spikes/laws/nile-load.l")
(define fork	(subr "fork" ">i"))
(define waitpid	(subr "waitpid" "ipi>i"))
(define _exit	(subr "_exit" "i"))
(define status-word ((subr "malloc" "l>p") 8))
(define-form nile-fatal-error message '(_exit 3))
(define nile-op-lookup-error (lambda args (_exit 3)))
(define-function nile-load (f) (load (concat-string "nile/compilers/maru/" f)))
(load "nile/compilers/maru/nile-resolve.l")
(load "nile/compilers/maru/nile-type-check.l")
(define nile-prelude (parse-string <nile-parser> $start (contents-of-file-named "nile/compilers/prelude.nl")))
(define-function nile-accepts? (text type)
  (let ((pid (fork)))
    (when (= 0 pid)
      (let* ((src (concat-strings "\\f(a:Number, b:Number, p:Boolean, q:Boolean) : " (symbol->string type) "\n    " text "\n"))
	     (p (text-parser-for-on <nile-parser> src)))
	(set (oop-at p 6) 0)
	(or (text-parser-invoke-rule 'start $start p) (_exit 4))
	(let ((ast (map-with resolve (concat-list nile-prelude (<text-parser>-result p)) (nile-resolve-env '()))))
	  (map-with type-check ast '())
	  (_exit 0))))
    (waitpid pid status-word 0)
    (let ((st (+ (byte-at status-word 0) (<< (byte-at status-word 1) 8))))
      (cond ((= 0 st)		1)
	    ((= (<< 3 8) st)	())		; Nile rejected it
	    ((= (<< 4 8) st)	())		; did not parse
	    (else		(error "the reference crashed (status "st") on: "text))))))
