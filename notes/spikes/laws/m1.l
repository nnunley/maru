(load "notes/spikes/laws/gen.l")
(require "cexpr.g.l")
(set text-parser-invoke-rule text-parser-invoke-rule-with-recursion)
(set *rules* (grammar-rules '("cexpr.g")))
(compute-heights) (compute-reach)
(list-do rule '(primary expression)
  (let ((ok 0) (n 200))
    (for (i 0 n) (let ((s (generate rule 12))) (and s (parses <cexpr> rule s) (set ok (+ ok 1)))))
    (println rule ": " ok " of " n " generated sentences parse")))
(for (i 0 6) (let ((s (car (sentence <cexpr> 'expression 12)))) (print "  ") (dump s) (print "  =>  ") (dumpln (car (parses <cexpr> 'expression s)))))
