#!/bin/sh
# Text matching stays within 15% of main's, with its grammar already compiled, one right after the other, each by its median run, so one run the machine slowed doesn't decide it. Assumes the two checkouts are built.
root=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)
mkdir -p /tmp/maru-plan; report=$(mktemp /tmp/maru-plan/speed.XXXXXX)
hyperfine --shell=default --runs 5 --export-json "$report" "cd $root && ./eval $PWD/notes/plan/speed-text.l" './eval notes/plan/speed-text.l' || exit 1
python3 -c "import json,sys;r=json.load(open(sys.argv[1]))['results'];f=lambda x:sorted(a['time_wall_clock']['value'] for a in x['measurements'])[len(x['measurements'])//2];m,n=f(r[0]),f(r[1]);print('main %.0f ms, here %.0f ms'%(m*1e3,n*1e3));raise SystemExit(0 if n<=m*1.15 else 1)" "$report"
