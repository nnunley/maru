#!/bin/sh
# notes/plan/fetch-dbjr DIR: the dbjr documents the KSWorld checks read, from tinlizzie.org/dbjr into DIR, laid out as there,
# and the font they name, in DIR/fonts.
# Third-party, so DIR is a temporary directory (make check makes one with mktemp -d), never this tree.  A file already
# there isn't fetched again.
set -e
dir=${1:?usage: notes/plan/fetch-dbjr DIR}
for doc in "KSWorld.ks/index.pp" "Front page Onward Full v8.ks/index.pp"; do
	mkdir -p "$dir/$(dirname "$doc")"
	[ -s "$dir/$doc" ] || curl -sfL --max-time 120 -o "$dir/$doc" "https://tinlizzie.org/dbjr/$(printf '%s' "$doc" | sed 's/ /%20/g')"
	head -c 9 "$dir/$doc" | grep -q '^(objects' || { echo "not a KSWorld document: $dir/$doc" >&2; exit 1; }
done
# the font most of the documents name, DejaVu Sans (free, Bitstream Vera's licence), from its release, checked by its hash
font="$dir/fonts/DejaVuSans.ttf"
if [ ! -s "$font" ]; then
	mkdir -p "$dir/fonts"
	curl -sfL --max-time 300 https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.tar.bz2 |
		tar xjf - -C "$dir/fonts" --strip-components 2 dejavu-fonts-ttf-2.37/ttf/DejaVuSans.ttf
fi
[ "$( (sha256sum "$font" 2>/dev/null || shasum -a 256 "$font") | cut -c1-64)" = 7da195a74c55bef988d0d48f9508bd5d849425c1770dba5d7bfc6ce9ed848954 ] ||
	{ echo "DejaVuSans.ttf isn't the release's: $font" >&2; exit 1; }
