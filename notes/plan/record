#!/bin/sh
# notes/plan/record [full]: asks the plan's checks about this code, appends the answers to its ledger, and shows the plan.
# MARU_PLAN names the plan (notes/plan/NAME.john, its ledger NAME.answers), tree-matching if unset
./eval notes/plan/observe.l "$@" || exit 1
exec ./eval notes/plan/next.l
