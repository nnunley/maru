;;; test-comparison-analysis.l - Compare our emit-c.l output with existing C generation

(require "core/compiler/emit-c.l")

(println "=== Comparison: Our multimethod backend vs existing patterns ===")
(println)

(println "=== Test 1: Simple arithmetic ===")
(println "Expression: (+ 5 3)")
(println)
(print "Our output: ")
(compile-maru-expression '(+ 5 3) (console-port))
(println)
(println "Verbose pattern would be: LONG(getLong(LONG(5)) + getLong(LONG(3)))")
(println "Hand-optimized would be: LONG(5 + 3)")
(println "Our approach: LONG(5 + 3)  <- Clean and idiomatic!")
(println)

(println "=== Test 2: Nested arithmetic ===")
(println "Expression: (+ (* 2 3) (- 8 4))")
(println)
(print "Our output: ")
(compile-maru-expression '(+ (* 2 3) (- 8 4)) (console-port))
(println)
(println "Verbose pattern would be:")
(println "  LONG(getLong(LONG(getLong(LONG(2)) * getLong(LONG(3)))) +")
(println "       getLong(LONG(getLong(LONG(8)) - getLong(LONG(4)))))")
(println "Our approach generates clean nested arithmetic!")
(println)

(println "=== Test 3: Comparisons ===")
(println "Expression: (< x y)")
(println)
(print "Our output: ")
(compile-maru-expression '(< x y) (console-port))
(println)
(println "Verbose pattern would be: ((getLong(x) < getLong(y)) ? LONG(1) : nil)")
(println "Our approach: (v_x < v_y ? s_true : nil)  <- Much cleaner!")
(println)

(println "=== Test 4: Conditional expressions ===")
(println "Expression: (if (< size 100) size (* size 2))")
(println)
(print "Our output: ")
(compile-maru-expression '(if (< size 100) size (* size 2)) (console-port))
(println)
(println "This demonstrates context-aware generation:")
(println "- Comparison generates numeric context: size < 100")
(println "- Results wrapped appropriately for object context")
(println)

(println "=== Test 5: Function calls ===")
(println "Expression: (malloc (* count 8))")
(println)
(print "Our output: ")
(compile-maru-expression '(malloc (* count 8)) (console-port))
(println)
(println "Clean function call with arithmetic argument!")
(println)

(println "=== Architecture Analysis ===")
(println)
(println "Key advantages of our multimethod approach:")
(println)
(println "1. TYPE-DRIVEN DISPATCH:")
(println "   - Each type (long, string, symbol, pair) handles its own compilation")
(println "   - Uses Maru's built-in type-of and multimethod system")
(println "   - Clean separation of concerns")
(println)
(println "2. CONTEXT-AWARE GENERATION:")
(println "   - Numeric context: raw numbers and operators")
(println "   - Object context: appropriate LONG() wrapping")
(println "   - Minimizes unnecessary conversions")
(println)
(println "3. CLEAN C OUTPUT:")
(println "   - Arithmetic: LONG(a + b) not LONG(getLong(LONG(a)) + getLong(LONG(b)))")
(println "   - Comparisons: (a < b ? s_true : nil) not nested getLong calls")
(println "   - Function calls: func(args) not func(getLong(LONG(args)))")
(println)
(println "4. EXTENSIBLE ARCHITECTURE:")
(println "   - Add new types: just add methods to compile-to-c")
(println "   - Add new operators: extend the pair method")
(println "   - Add new contexts: extend context management")
(println)
(println "5. LEVERAGES MARU'S STRENGTHS:")
(println "   - Uses reflection instead of fighting it")
(println "   - Multimethod dispatch is natural and efficient")
(println "   - Type-based compilation matches language design")
(println)

;; Demonstrate the string capture for detailed analysis
(println "=== Detailed Output Analysis ===")
(define analysis-port (string-port))
(compile-maru-expression '(if (< (+ position offset) buffer-size)
                             (set position (+ position increment))
                             (realloc buffer (* buffer-size 2))) analysis-port)
(define detailed-output (port-contents analysis-port))
(println)
(println "Complex expression with multiple operations:")
(println detailed-output)
(println)
(println "Notice:")
(println "- Clean arithmetic in comparisons: (position + offset) < buffer_size")
(println "- Appropriate LONG() wrapping for object context")  
(println "- Function calls with clean arguments")
(println "- No unnecessary LONG/getLong nesting")
(println)

(println "=== Comparison complete! ===")
(println)
(println "Our multimethod C backend generates significantly cleaner")
(println "and more readable C code than traditional approaches,")
(println "while leveraging Maru's reflective capabilities naturally.")